/* WOMENACE Strategy UI: the design system's tokens and classes for UI Toolkit.
   Source of truth: https://claude.ai/artifact/N3WZXVVsiN1ZGM5CZW61U4 (tokens.json, components/bundle.css).
   USS has no ::before/::after, so brackets, dashes and rules are real child elements. */
:root {
    --panel-raised: rgba(12, 17, 24, 0.89);
    --panel-icon: rgb(34, 39, 46);
    --line: rgb(50, 60, 74);
    --line-strong: rgb(67, 83, 106);
    --ink: rgb(255, 255, 255);
    --ink-body: rgb(225, 225, 225);
    --ink-label: rgb(169, 157, 134);
    --ink-meta: rgb(120, 143, 176);
    --gold: rgb(215, 192, 116);
    --gold-amount: rgb(205, 175, 65);
    --danger: rgb(255, 123, 108);
    --holo: rgb(79, 220, 234);
}

/* MENACE's face, Jura Bold, shipped with the mod (UI/fonts) so no font of the game's is held.
   Doubled so it outranks a vanilla element's own rule for its font. */
.wm-game-font.wm-game-font { -unity-font-definition: url("../fonts/Jura-Bold-SDF.asset"); }

/* Corner brackets on a holographic panel */
.wui-holo__corner { position: absolute; width: 12px; height: 12px; border-color: var(--holo); }
.wui-holo__corner--tl { left: -5px; top: -5px; border-left-width: 2.4px; border-top-width: 2.4px; }
.wui-holo__corner--br { right: -5px; bottom: -5px; border-right-width: 2.4px; border-bottom-width: 2.4px; }
