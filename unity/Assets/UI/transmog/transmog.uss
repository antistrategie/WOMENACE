.wm-outfit-modal {
    position: absolute;
    right: 0;
    top: 0;
    width: 636px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.94);
}

.wm-outfit-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.wm-outfit-title {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(229, 200, 192);
    -unity-text-align: middle-left;
}

.wm-outfit-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.wm-outfit-card {
    width: 298px;
    height: 106px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 0;
    align-items: flex-start;
    justify-content: flex-start;
}

.wm-outfit-card-locked {
    opacity: 0.4;
}

.wm-outfit-card-name {
    color: rgb(228, 225, 180);
    font-size: 10px;
    -unity-text-align: upper-left;
    margin-left: 9px;
    margin-top: 7px;
    padding: 0;
}

.wm-outfit-card-shortname {
    color: rgb(184, 151, 134);
    font-size: 9px;
    -unity-text-align: upper-left;
    margin-left: 9px;
    margin-top: 2px;
    padding: 0;
}

.wm-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.wm-weapon-skin-tile {
    -unity-background-scale-mode: scale-to-fit;
}

.wm-weapon-skin-art {
    position: absolute;
    left: 9px;
    right: 9px;
    top: 25px;
    bottom: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Who wears the outfit: a glyph and label each, in the card's empty bottom-left corner. */
.wm-outfit-badges {
    position: absolute;
    left: 9px;
    bottom: 8px;
    flex-direction: row;
}

.wm-outfit-badge {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.wm-outfit-badge-icon {
    width: 11px;
    height: 11px;
    margin-right: 4px;
    -unity-background-image-tint-color: rgb(228, 225, 180);
    -unity-background-scale-mode: scale-to-fit;
}

.wm-outfit-badge-label {
    color: rgb(228, 225, 180);
    font-size: 9px;
    letter-spacing: 0.6px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.wm-outfit-close {
    flex-shrink: 0;
    margin-left: 8px;
}

/* The outfit list shown in place (the Squads screen's Appearance tab): one card to a row */
.wm-outfit-list--rows { flex-direction: column; flex-wrap: nowrap; }
/* The modal's card is 298 by 106 and its art is drawn for that shape, so a row keeps the shape at
   the column's width. A row is in the Squads panel's style: dark fill, hairline edge. */
.wm-outfit-list--rows .wm-outfit-card { width: 100%; height: 109px; margin-right: 0; margin-bottom: 6.4px; background-image: none; background-color: rgb(12, 17, 24); border-width: 0.64px; border-color: rgb(67, 83, 106); border-radius: 0; }
.wm-outfit-tag { position: absolute; left: 9px; bottom: 8px; padding: 1px 5px; font-size: 7.2px; letter-spacing: 0.7px; color: rgb(120, 143, 176); background-color: rgba(0, 0, 0, 0.8); border-width: 0.64px; border-color: rgb(120, 143, 176); }

/* A hosted row: gold edge on the outfit being dressed, white name with who wears it as chips
   beside it */
.wm-outfit-list--rows .wm-outfit-card:hover { border-color: rgb(215, 192, 116); }
.wm-outfit-list--rows .wm-outfit-card--on { border-width: 1.9px; border-color: rgb(215, 192, 116); }
.wm-outfit-list--rows .wm-outfit-card #Border { visibility: hidden; }
.wm-outfit-list--rows .wm-outfit-card #Selected { visibility: hidden; }
.wm-outfit-card-heading { flex-direction: row; align-items: center; margin-left: 9px; margin-top: 7px; }
.wm-outfit-list--rows .wm-outfit-card-name { color: rgb(255, 255, 255); font-size: 11.2px; letter-spacing: 0.45px; margin: 0 6px 0 0; }
.wm-outfit-list--rows .wm-outfit-card-shortname { color: rgb(120, 143, 176); font-size: 8px; }
.wm-outfit-chip { font-size: 7.2px; letter-spacing: 0.6px; color: rgb(0, 0, 0); padding: 0 3px; margin: 0 3px 0 0; }
.wm-outfit-chip--leader { background-color: rgb(215, 192, 116); }
.wm-outfit-chip--links { background-color: rgb(121, 233, 245); }
