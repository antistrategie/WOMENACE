.wm-outfit-modal {
    position: absolute;
    right: 0;
    top: 0;
    width: 636px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.94);
}

.wm-outfit-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.wm-outfit-title {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(229, 200, 192);
    -unity-text-align: middle-left;
}

.wm-outfit-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.wm-outfit-card {
    width: 298px;
    height: 106px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 0;
    align-items: flex-start;
    justify-content: flex-start;
}

.wm-outfit-card-locked {
    opacity: 0.4;
}

.wm-outfit-card-name {
    color: rgb(228, 225, 180);
    font-size: 10px;
    -unity-text-align: upper-left;
    margin-left: 9px;
    margin-top: 7px;
    padding: 0;
}

.wm-outfit-card-shortname {
    color: rgb(184, 151, 134);
    font-size: 9px;
    -unity-text-align: upper-left;
    margin-left: 9px;
    margin-top: 2px;
    padding: 0;
}

.wm-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.wm-weapon-skin-tile {
    -unity-background-scale-mode: scale-to-fit;
}

.wm-weapon-skin-art {
    position: absolute;
    left: 9px;
    right: 9px;
    top: 25px;
    bottom: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Who wears the outfit: a glyph and label each, in the card's empty bottom-left corner. */
.wm-outfit-badges {
    position: absolute;
    left: 9px;
    bottom: 8px;
    flex-direction: row;
}

.wm-outfit-badge {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.wm-outfit-badge-icon {
    width: 11px;
    height: 11px;
    margin-right: 4px;
    -unity-background-image-tint-color: rgb(228, 225, 180);
    -unity-background-scale-mode: scale-to-fit;
}

.wm-outfit-badge-label {
    color: rgb(228, 225, 180);
    font-size: 9px;
    letter-spacing: 0.6px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.wm-outfit-close {
    flex-shrink: 0;
    margin-left: 8px;
}
