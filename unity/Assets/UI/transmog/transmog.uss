.wm-outfit-modal {
    position: absolute;
    right: 0;
    top: 0;
    width: 636px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.94);
}

.wm-outfit-title {
    font-size: 12px;
    color: rgb(229, 200, 192);
    -unity-text-align: middle-left;
    margin-bottom: 8px;
}

.wm-outfit-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.wm-outfit-card {
    width: 298px;
    height: 106px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 0;
    align-items: flex-start;
    justify-content: flex-start;
}

.wm-outfit-card-locked {
    opacity: 0.4;
}

.wm-outfit-card-name {
    color: rgb(228, 225, 180);
    font-size: 10px;
    -unity-text-align: upper-left;
    margin-left: 9px;
    margin-top: 7px;
    padding: 0;
}

.wm-outfit-card-shortname {
    color: rgb(184, 151, 134);
    font-size: 9px;
    -unity-text-align: upper-left;
    margin-left: 9px;
    margin-top: 2px;
    padding: 0;
}

.wm-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
