<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../wui/wui.uss" />
    <Style src="navigation.uss" />
    <ui:VisualElement name="wm-nav-screen" class="wm-nav-screen">
        <ui:VisualElement name="wm-nav-backdrop" class="wm-nav-backdrop" picking-mode="Ignore" />
        <ui:VisualElement class="wm-nav-dim" picking-mode="Ignore" />
        <ui:VisualElement class="wui-holo wm-nav-panel">
            <ui:VisualElement class="wui-holo__corner wui-holo__corner--tl" picking-mode="Ignore" />
            <ui:VisualElement class="wui-holo__corner wui-holo__corner--br" picking-mode="Ignore" />
            <ui:VisualElement class="wm-nav-head">
                <ui:Label name="@WOMENACE::ui/nav/title" text="NAVIGATION · MCV ELMO" class="wui-holo__title" picking-mode="Ignore" />
                <ui:Button name="wm-nav-close" text="×" class="wui-close" />
            </ui:VisualElement>
            <ui:VisualElement class="wm-nav-serials" picking-mode="Ignore">
                <ui:Label text="//.TCRN-0406 // DECK PLAN" class="wui-serial" />
                <ui:Label text="//.10.7232.97" class="wui-serial" />
            </ui:VisualElement>
            <ui:VisualElement name="wm-nav-map" class="wm-nav-map">
                <ui:VisualElement name="wm-nav-room-oci" class="wui-room" style="left: 0; top: 18%; width: 16%; height: 64%;">
                    <ui:Label name="@WOMENACE::ui/nav/hangar" text="Hangar" class="wui-room__name" picking-mode="Ignore" />
                    <ui:Label name="@WOMENACE::ui/nav/hangar_sub" text="O.C.I. UPGRADES" class="wui-room__sub" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="wm-nav-room-armory" class="wui-room" style="left: 18%; top: 4%; width: 22%; height: 44%;">
                    <ui:Label name="@WOMENACE::ui/nav/armoury" text="Armoury" class="wui-room__name" picking-mode="Ignore" />
                    <ui:Label name="@WOMENACE::ui/nav/armoury_sub" text="SQUADS · LOADOUTS" class="wui-room__sub" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="wm-nav-room-hiring" class="wui-room" style="left: 18%; top: 52%; width: 22%; height: 44%;">
                    <ui:Label name="@WOMENACE::ui/nav/recruitment" text="Recruitment" class="wui-room__name" picking-mode="Ignore" />
                    <ui:Label name="@WOMENACE::ui/nav/recruitment_sub" text="HIRING" class="wui-room__sub" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="wm-nav-room-bridge" class="wui-room wui-room--here" style="left: 42%; top: 0; width: 24%; height: 100%;">
                    <ui:Label name="@WOMENACE::ui/nav/bridge" text="Bridge" class="wui-room__name" picking-mode="Ignore" />
                    <ui:Label name="@WOMENACE::ui/nav/bridge_sub" text="OPERATIONS" class="wui-room__sub" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="wm-nav-room-workshop" class="wui-room" style="left: 68%; top: 4%; width: 21%; height: 44%;">
                    <ui:Label name="@WOMENACE::ui/nav/workshop" text="Workshop" class="wui-room__name" picking-mode="Ignore" />
                    <ui:Label name="@WOMENACE::ui/nav/workshop_sub" text="CRAFTING" class="wui-room__sub" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="wm-nav-room-shop" class="wui-room" style="left: 68%; top: 52%; width: 21%; height: 44%;">
                    <ui:Label name="@WOMENACE::ui/nav/kalina" text="Kalina's Shop" class="wui-room__name" picking-mode="Ignore" />
                    <ui:Label name="@WOMENACE::ui/nav/kalina_sub" text="SUPPLIES" class="wui-room__sub" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="wm-nav-room-market" class="wui-room" style="left: 90.5%; top: 22%; width: 9.5%; height: 56%; padding: 8px 4px; align-items: center;">
                    <ui:Label name="@WOMENACE::ui/nav/market" text="Market" class="wui-room__name" picking-mode="Ignore" style="font-size: 14px; white-space: nowrap;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="wm-nav-buttons">
                <ui:Button name="wm-nav-btn-armory" text="Squads" class="wui-holo-btn" />
                <ui:Button name="wm-nav-btn-hiring" text="Hiring" class="wui-holo-btn" />
                <ui:Button name="wm-nav-btn-oci" text="O.C.I." class="wui-holo-btn" />
                <ui:Button name="wm-nav-btn-market" text="Black Market" class="wui-holo-btn" />
                <ui:Button name="wm-nav-btn-bridge" text="Operations" class="wui-holo-btn wui-holo-btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
