.wm-nav-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgb(0, 0, 0); }
.wm-nav-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.wm-nav-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--dim); }
.wm-nav-panel { width: 82%; max-width: 1500px; height: 74%; }
.wm-nav-head { height: 44px; justify-content: center; }
.wm-nav-serials { flex-direction: row; justify-content: space-between; margin: 2px 4px 0 4px; }
.wm-nav-map { flex-grow: 1; margin: 18px 6px; }
.wm-nav-buttons { flex-direction: row; margin: 0 -5px; }
