.wm-affinity-badge {
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
}

.wm-affinity-badge__frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    background-image: url("Img_DormLoveUpDialog_IconFrame.png");
    -unity-background-scale-mode: scale-to-fit;
}

.wm-affinity-badge__star {
    position: absolute;
    left: 9px;
    right: 9px;
    top: 9px;
    bottom: 9px;
    background-image: url("Img_DormLoveUpDialog_Center.png");
    -unity-background-scale-mode: scale-to-fit;
}

.wm-affinity-badge .wm-affinity-badge__level {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.wm-gift-flyout {
    width: 636px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.94);
}

.wm-gift-titlerow {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.wm-gift-title {
    font-size: 12px;
    color: rgb(229, 200, 192);
    margin-right: 10px;
}

.wm-gift-level {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--wm-rel);
    margin-left: 6px;
    margin-right: 6px;
}

.wm-gift-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    flex-gap: 4px;
}

.wm-gift-preview-track {
    flex-grow: 1;
    height: 10px;
    background-color: var(--wm-bar-track);
    border-width: 1px;
    border-color: var(--wm-bar-border);
}

.wm-gift-preview-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--wm-rel);
}

.wm-gift-preview-temp {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgb(120, 100, 36);
}

.wm-gift-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.wm-gift-btn {
    margin-left: 8px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 12px;
    color: rgb(188, 176, 150);
}

.wm-gift-box {
    margin: 4px;
    align-items: flex-start;
}

.wm-gift-box__badge {
    display: none;
    position: absolute;
    top: -5px;
    right: -5px;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(20, 20, 20);
    background-color: var(--wm-rel);
    padding-left: 2px;
    padding-right: 2px;
}
