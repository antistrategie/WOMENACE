.wm-affinity-badge {
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
}

.wm-affinity-badge__frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    background-image: url("Img_DormLoveUpDialog_IconFrame.png");
    -unity-background-scale-mode: scale-to-fit;
}

.wm-affinity-badge__star {
    position: absolute;
    left: 9px;
    right: 9px;
    top: 9px;
    bottom: 9px;
    background-image: url("Img_DormLoveUpDialog_Center.png");
    -unity-background-scale-mode: scale-to-fit;
}

.wm-affinity-badge .wm-affinity-badge__level {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.wm-gift-flyout {
    width: 636px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.94);
}

.wm-gift-titlerow {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.wm-gift-title {
    font-size: 12px;
    color: rgb(222, 218, 206);
    margin-right: 10px;
    -unity-text-align: middle-left;
}

.wm-gift-level {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--wm-rel);
    margin-left: 6px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.wm-gift-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    flex-gap: 4px;
}

.wm-gift-preview-track {
    flex-grow: 1;
    height: 14px;
    background-color: var(--wm-bar-track);
    border-width: 1px;
    border-color: var(--wm-bar-border);
    justify-content: center;
    align-items: center;
}

.wm-gift-preview-count {
    -unity-text-align: middle-center;
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85);
}

.wm-gift-preview-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--wm-rel);
}

.wm-gift-preview-temp {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgb(120, 100, 36);
}

.wm-gift-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.wm-gift-btn {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 12px;
    color: rgb(188, 176, 150);
}

.wm-gift-box {
    margin: 4px;
    align-items: flex-start;
}

.wm-gift-box__badge {
    display: none;
    position: absolute;
    top: -5px;
    right: -5px;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(20, 20, 20);
    background-color: var(--wm-rel);
    padding-left: 2px;
    padding-right: 2px;
}

/* A feature locked behind affinity: greyed and muted. Paired with SetEnabled(false) in code, which
   blocks the click and adds :disabled. */
.wm-locked {
    opacity: 0.45;
}

.wm-locked .text-button-label {
    color: rgb(150, 140, 120);
}

/* ---- affinity popover (badge hover) ----
   A filled rank rail on the left (gold up to the reached level, dim below) with each level's rewards
   to its right and the level number in its own column. Near-opaque: it floats over live UI with no
   dimming blocker behind it, so it must not read see-through. */
.wm-aff-pop {
    width: 330px;
    background-color: rgba(0, 0, 0, 0.97);
    border-width: 1px;
    border-color: rgba(215, 197, 87, 0.24);
    padding: 7px 9px 8px 7px;
}

.wm-aff-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 5px;
    margin-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.5);
}

.wm-aff-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--wm-rel);
}

.wm-aff-level {
    font-size: 9px;
    letter-spacing: 2px;
    color: rgb(140, 133, 116);
}

.wm-aff-track {
    flex-direction: column;
}

/* One level. Rows touch (no margin) so the rail lines join into a continuous bar; the gap between
   groups is the body's padding-bottom, which the rail passes through. */
.wm-aff-lvl-row {
    flex-direction: row;
    align-items: stretch;
}

.wm-aff-rail {
    width: 20px;
    flex-shrink: 0;
}

.wm-aff-rail-line {
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgb(52, 49, 42);
}

/* Gold fill over the dim line: full height on a reached level, only down to the node on the current
   one (so the reached point sits exactly at the current node). */
.wm-aff-rail-fill {
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--wm-rel);
}

.wm-aff-rail-fill--current {
    bottom: auto;
    height: 7px;
}

/* The last level ends the rail: its line (and fill, if reached) stops at the node, no stub below. */
.wm-aff-lvl-row--last .wm-aff-rail-line,
.wm-aff-lvl-row--last .wm-aff-rail-fill {
    bottom: auto;
    height: 7px;
}

.wm-aff-node {
    position: absolute;
    left: 11px;
    top: 3px;
    translate: -50% 0;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(18, 18, 13);
    border-width: 2px;
    border-color: rgb(52, 49, 42);
}

/* Number and reward text share font-size and zeroed margins so their baselines line up and lines
   stack tightly (the game's default label carries a margin that otherwise spaces them out). */
.wm-aff-num {
    width: 22px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(140, 133, 116);
}

.wm-aff-body {
    flex-grow: 1;
    padding-top: 0;
    padding-bottom: 4px;
    padding-left: 2px;
}

.wm-aff-unlock {
    font-size: 10px;
    margin: 0;
    padding: 0;
    color: rgb(140, 133, 116);
    white-space: normal;
}

/* reached */
.wm-aff-lvl-row--done .wm-aff-node { background-color: var(--wm-rel); border-color: var(--wm-rel); }
.wm-aff-lvl-row--done .wm-aff-num { color: var(--wm-rel); }
.wm-aff-lvl-row--done .wm-aff-unlock { color: rgb(207, 201, 184); }
.wm-aff-lvl-row--done .wm-aff-unlock--acc { color: var(--wm-rel); }

/* current */
.wm-aff-lvl-row--current .wm-aff-node {
    top: 5px;
    width: 11px;
    height: 11px;
    border-radius: 6px;
    background-color: rgb(239, 224, 160);
    border-color: rgb(239, 224, 160);
}
.wm-aff-lvl-row--current .wm-aff-num { color: rgb(239, 224, 160); }
.wm-aff-lvl-row--current .wm-aff-unlock { color: rgb(222, 218, 206); }
.wm-aff-lvl-row--current .wm-aff-unlock--acc { color: rgb(239, 224, 160); }

/* locked levels keep the dim defaults above */
