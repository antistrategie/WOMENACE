/* The shop is in the shell's look: its tokens (wui.uss), the game's own face, hairline borders. */
#wm-shop-root .wm-shop-panel {
    position: absolute;
    left: 32px;
    width: 500px;
    top: 80px;
    bottom: 80px;
    background-color: rgba(0, 0, 0, 0.92);
    border-width: 0.64px;
    border-color: var(--line);
}
#wm-shop-root .wm-shop-currency { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; }
#wm-shop-root .wm-shop-currency-icon { width: 24px; height: 24px; flex-shrink: 0; margin-right: 6px; -unity-background-scale-mode: scale-to-fit; }
#wm-shop-root .wm-shop-currency-value { margin: 0; padding: 0; font-size: 14px; color: var(--gold-amount); white-space: nowrap; -unity-text-align: middle-center; }
#wm-shop-root .wm-shop-symbol-button { margin: 0; padding: 0; align-items: center; justify-content: center; flex-shrink: 0; border-width: 1px; border-radius: 0; border-color: var(--line); background-color: rgb(0, 0, 0); }
#wm-shop-root .wm-shop-symbol-button:hover { background-color: rgba(215, 192, 116, 0.14); border-color: var(--gold); }
#wm-shop-root .wm-shop-symbol-button:focus { border-color: var(--gold); }
#wm-shop-root .wm-shop-wallet-add { width: 23px; height: 23px; margin-left: -8px; }
#wm-shop-root .wm-shop-symbol { width: 12px; height: 12px; flex-shrink: 0; }
#wm-shop-root .wm-shop-symbol-close { rotate: 45deg; }
#wm-shop-root .wm-shop-symbol-horizontal { position: absolute; left: 0; right: 0; top: 5px; height: 2px; background-color: var(--ink-body); }
#wm-shop-root .wm-shop-symbol-vertical { position: absolute; top: 0; bottom: 0; left: 5px; width: 2px; background-color: var(--ink-body); }
#wm-shop-root .wm-shop-tabs { position: absolute; left: 16px; top: 12px; flex-direction: row; }
#wm-shop-root .wm-shop-tab { width: 90px; height: 27px; margin-right: 5px; border-color: var(--line); }
#wm-shop-root .wm-shop-tab:hover { border-color: var(--gold); }
#wm-shop-root .wm-shop-tab:hover .text-button-label { color: var(--gold); }
#wm-shop-root .wm-shop-tab-active { border-color: var(--gold); }
#wm-shop-root .wm-shop-tab.wm-shop-tab-active .text-button-label { color: var(--gold); }
#wm-shop-root .wm-shop-scroll { position: absolute; left: 12px; right: 12px; top: 46px; bottom: 66px; }
#wm-shop-root .wm-shop-scroll .unity-scroll-view__content-container { padding: 12px 12px 14px 4px; }
#wm-shop-root .wm-shop-grid { width: 100%; min-width: 0; flex-direction: row; flex-wrap: wrap; }
#wm-shop-root .wm-shop-section, #wm-shop-root .wm-proc-heading .wm-proc-title { width: auto; margin: 0 0 12px; padding: 0; font-size: 10px; letter-spacing: 1px; color: var(--ink); -unity-font-style: bold; -unity-text-align: middle-left; }
#wm-shop-root .wm-shop-section { width: 100%; }
#wm-shop-root .wm-shop-group { width: 50%; margin-bottom: 30px; }
#wm-shop-root .wm-shop-sell-group { width: 100%; }
#wm-shop-root .wm-shop-category { margin: 0 0 8px 0; padding: 0; font-size: 8px; letter-spacing: 0.8px; color: var(--ink-label); -unity-text-align: middle-left; }
#wm-shop-root .wm-shop-slots { flex-direction: row; flex-wrap: wrap; }
/* Four to a group's row with room to spare: a row that only just holds four drops the fourth
   to a line of its own once anything narrows the group by a pixel. */
#wm-shop-root .wm-shop-item { width: 48px; height: 48px; margin-right: 4px; margin-bottom: 7px; flex-shrink: 0; }
#wm-shop-root .wm-shop-item > MissionResultLootSlot { width: 48px; height: 48px; margin: 0; }
#wm-shop-root .wm-shop-item #Pickable { margin: 0; left: 0; right: auto; width: 48px; height: 48px; }
#wm-shop-root .wm-shop-price { position: absolute; right: 1px; bottom: 0; margin: 0; padding: 0 2px; background-color: rgba(0, 0, 0, 0.6); }
#wm-shop-root .wm-shop-price .wm-shop-currency-icon { width: 10px; height: 10px; margin-right: 2px; }
#wm-shop-root .wm-shop-price .wm-shop-currency-value { font-size: 9px; }
#wm-shop-root .wm-shop-owned { position: absolute; left: 1px; top: 0; margin: 0; padding: 0 2px; font-size: 9px; color: var(--gold); background-color: rgba(0, 0, 0, 0.6); }
#wm-shop-root .wm-shop-checkout, #wm-shop-root .wm-proc-footer { position: absolute; left: 16px; right: 16px; bottom: 14px; height: 42px; margin: 0; padding: 0; flex-direction: row; align-items: center; justify-content: flex-end; }
#wm-shop-root .wm-shop-total-label { height: 42px; margin: 0 14px 0 0; padding: 0; font-size: 9px; color: var(--ink-label); -unity-text-align: middle-right; }
#wm-shop-root .wm-shop-total { min-width: 76px; height: 42px; align-items: flex-end; justify-content: center; margin-right: 20px; }
/* The variant also outranks the Procurement button rules in the later stylesheet. */
#wm-shop-root .wm-shop-primary, #wm-shop-root .wm-proc-button.wm-shop-primary { background-color: var(--gold); border-color: var(--gold); color: rgb(0, 0, 0); }
#wm-shop-root .wm-shop-primary:hover, #wm-shop-root .wm-proc-button.wm-shop-primary:hover { background-color: rgb(232, 212, 144); }
#wm-shop-root .wm-shop-primary .wm-proc-text, #wm-shop-root .wm-shop-primary .wm-shop-currency-value, #wm-shop-root .wm-shop-primary .text-button-label { color: rgb(0, 0, 0); }
#wm-shop-root #wm-shop-checkout-button { width: 190px; height: 42px; margin: 0; padding: 0 12px; align-items: center; justify-content: center; border-width: 1px; border-radius: 0; }
#wm-shop-root #wm-shop-checkout-button:disabled { opacity: 1; }
/* A primary button that cannot be pressed is an outline: its gold is only painted while it can. */
#wm-shop-root .wm-shop-primary:disabled, #wm-shop-root .wm-proc-button.wm-shop-primary:disabled { opacity: 0.35; background-color: rgb(0, 0, 0); border-color: var(--line-strong); }
#wm-shop-root .wm-shop-primary:disabled .wm-proc-text, #wm-shop-root .wm-shop-primary:disabled .wm-shop-currency-value, #wm-shop-root .wm-shop-primary:disabled .text-button-label, #wm-shop-root .wm-shop-primary:disabled .wm-proc-button-caption { color: var(--ink-meta); }
#wm-shop-root #wm-shop-checkout-button .text-button-label { margin: 0; padding: 0; font-size: 10px; -unity-font-style: bold; -unity-text-align: middle-center; }
#wm-shop-root .wm-shop-feedback { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 16px 0 0; padding: 0; font-size: 10px; color: var(--gold); white-space: normal; }
#wm-shop-root .wm-kalina-portrait { position: absolute; right: 40px; bottom: 80px; width: 300px; height: 432px; overflow: hidden; }
#wm-shop-root .wm-kalina-art { -unity-background-scale-mode: stretch-to-fill; }
#wm-shop-root .wm-kalina-dialogue {
    position: absolute;
    right: 50px;
    bottom: 112px;
    width: 280px;
    margin: 0;
    padding: 12px;
    font-size: 10px;
    color: var(--ink-body);
    white-space: normal;
    -unity-text-align: upper-left;
    background-color: rgba(0, 0, 0, 0.92);
    border-width: 0.64px;
    border-color: var(--line);
}
#wm-shop-root .wm-kalina-outfits { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
#wm-shop-root .wm-kalina-outfits-blocker { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.72); }
#wm-shop-root .wm-kalina-outfit-panel { width: 636px; padding: 10px 12px 12px 12px; background-color: rgb(0, 0, 0); border-width: 1px; border-color: var(--line); }
#wm-shop-root .wm-kalina-outfit-header { height: 30px; flex-direction: row; justify-content: space-between; }
#wm-shop-root .wm-kalina-outfit-title { margin: 0; padding: 0; font-size: 12px; color: var(--ink); }
#wm-shop-root .wm-kalina-outfits-close { width: 24px; height: 24px; margin: 0; padding: 0; font-size: 10px; border-width: 1px; border-color: var(--line); background-color: rgb(0, 0, 0); color: var(--gold); }
#wm-shop-root .wm-kalina-outfits-close:hover { border-color: var(--gold); }
#wm-shop-root .wm-kalina-outfit-scroll { height: 436px; }
#wm-shop-root .wm-kalina-outfit-grid { width: 100%; min-width: 0; flex-direction: row; flex-wrap: wrap; }
#wm-shop-root .wm-kalina-outfit { width: 49%; height: 106px; margin: 0 1% 4px 0; padding: 8px; flex-shrink: 0; align-items: flex-start; justify-content: flex-start; overflow: hidden; border-width: 1px; border-radius: 0; border-color: var(--line); background-color: var(--panel-raised); }
#wm-shop-root .wm-kalina-outfit-selected { border-color: var(--gold); }
#wm-shop-root .wm-kalina-outfit:hover { border-color: var(--gold); }
#wm-shop-root .wm-kalina-outfit-name { position: absolute; left: 8px; top: 6px; margin: 0; padding: 0; font-size: 10px; -unity-text-align: upper-left; color: var(--ink); }
#wm-shop-root .wm-kalina-outfit-status { position: absolute; left: 8px; top: 21px; margin: 0; padding: 0; font-size: 9px; -unity-text-align: upper-left; color: var(--ink-label); }
#wm-shop-root .wm-shop-tab .text-button-label { color: var(--ink-meta); margin: 0; padding: 0; font-size: 10px; letter-spacing: 0.8px; -unity-text-align: middle-center; }
#wm-shop-root .wm-shop-tab { background-image: none; background-color: rgb(0, 0, 0); border-width: 1px; padding: 0; align-items: center; justify-content: center; }
#wm-shop-root .wm-shop-total-label { letter-spacing: 1px; }
#wm-shop-root .wm-shop-currency-value { letter-spacing: 0.2px; }
#wm-shop-root #wm-shop-checkout-button .text-button-label { letter-spacing: 1.2px; }

/* Kalina's card: what the player has to spend, how she feels about them, and her wardrobe. */
#wm-shop-root .wm-kalina-card { position: absolute; right: 40px; top: 80px; width: 300px; padding: 10px 12px; background-color: rgba(0, 0, 0, 0.92); border-width: 0.64px; border-color: var(--line); }
#wm-shop-root .wm-shop-wallet { height: 24px; margin-bottom: 8px; flex-direction: row; align-items: center; }
#wm-shop-root .wm-shop-wallet > .wm-shop-currency { margin-right: 18px; }
#wm-shop-root .wm-kalina-level { flex-direction: row; align-items: flex-end; flex-shrink: 0; margin: 0 0 6px 0; }
#wm-shop-root .wm-kalina-level-number { color: var(--ink); font-size: 22px; padding: 0; margin: 0 8px 0 0; }
#wm-shop-root .wm-kalina-level-next { color: var(--ink-label); font-size: 8px; letter-spacing: 0.6px; padding: 0; margin: 0 0 4px 0; }
#wm-shop-root .wm-kalina-level-gap { flex-grow: 1; }
#wm-shop-root .wm-kalina-outfits-open { height: 24px; margin: 0; padding: 0 10px; align-items: center; justify-content: center; background-image: none; background-color: rgb(0, 0, 0); border-width: 0.64px; border-radius: 0; border-color: var(--gold); }
#wm-shop-root .wm-kalina-outfits-open:hover { background-color: rgba(215, 192, 116, 0.14); }
#wm-shop-root .wm-kalina-outfits-open-label { margin: 0; padding: 0; font-size: 8px; letter-spacing: 0.8px; color: var(--gold); -unity-font-style: bold; }
#wm-shop-root .wm-kalina-level-bar { height: 5px; flex-shrink: 0; background-color: var(--panel-icon); }
#wm-shop-root .wm-kalina-level-fill { height: 100%; width: 0; background-color: var(--gold); }

/* The game's text button brings a frame of its own and an overlay for the pointer. The shop draws both itself. */
#wm-shop-root .text-button { background-image: none; }
#wm-shop-root .text-button-hover { display: none; }
#wm-shop-root .wm-shop-primary:enabled:hover { border-color: rgb(255, 255, 255); }
/* How many of an item are in the basket, on its tile's corner. */
#wm-shop-root .wm-shop-chosen { position: absolute; top: -4px; right: -4px; margin: 0; padding: 0 3px; font-size: 8px; -unity-font-style: bold; color: rgb(0, 0, 0); background-color: var(--gold); }
#wm-shop-root .wm-shop-section-row { width: 100%; flex-direction: row; align-items: flex-start; justify-content: space-between; }
#wm-shop-root .wm-shop-section-row .wm-shop-section { width: auto; }
#wm-shop-root .wm-shop-text-button { margin: 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); font-size: 8px; letter-spacing: 0.8px; color: var(--ink-meta); }
#wm-shop-root .wm-shop-text-button:enabled:hover { color: var(--gold); }
#wm-shop-root .wm-shop-text-button:disabled { opacity: 0.35; }
/* Nothing to sell: said once, small, in the middle of the list's space. */
#wm-shop-root .wm-shop-empty { position: absolute; left: 0; right: 0; top: 0; bottom: 0; margin: 0; padding: 0; font-size: 9px; letter-spacing: 0.8px; color: var(--ink-label); -unity-text-align: middle-center; }
