#wm-shop-root .wm-proc-roman, #wm-shop-root .wm-proc-reveal-roman { -unity-font-definition: url("fonts/LiberationSerif-Regular.ttf"); -unity-font: url("fonts/LiberationSerif-Regular.ttf"); }

#wm-shop-root .wm-proc-quantity { margin: 0; padding: 0; }
#wm-shop-root .wm-proc-quantity #unity-text-input { margin: 0; padding: 4px 8px; border-radius: 0; }
#wm-shop-root .wm-proc-quantity #unity-text-input:focus { border-color: var(--gold); }
#wm-shop-root .wm-proc-quantity .unity-text-element { color: var(--ink-body); -unity-text-align: middle-center; }

#wm-shop-root .wm-proc-orbit { position: absolute; left: 70%; margin-left: -226px; top: -60px; width: 452px; height: 452px; }
#wm-shop-root .wm-proc-quantity { --unity-selection-color: rgba(180, 159, 98, 0.4); --unity-cursor-color: rgb(234, 214, 164); }
#wm-shop-root .wm-proc-buy-pieces .wm-proc-button-caption { color: rgb(0, 0, 0); -unity-font-style: bold; }
/* A special equipment card: its picture across the whole card, its name and its claims over the top left. */
#wm-shop-root .wm-proc-special-card .wm-proc-item-icon { position: absolute; left: 8px; right: 8px; top: 20px; bottom: 5px; width: auto; height: auto; margin: 0; }
#wm-shop-root .wm-proc-special-card .wm-proc-item-copy { position: absolute; left: 7px; right: 7px; top: 5px; }
#wm-shop-root .wm-proc-special-card .wm-proc-item-name { font-size: 7px; letter-spacing: 0.3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: upper-left; color: var(--ink); }
#wm-shop-root .wm-proc-special-card .wm-proc-muted { font-size: 5.5px; letter-spacing: 0.4px; margin-top: 2px; -unity-text-align: upper-left; }
#wm-shop-root .wm-proc-subheading { margin: 10px 0 6px 0; padding: 0; flex-shrink: 0; font-size: 8px; letter-spacing: 0.8px; color: var(--ink-label); -unity-text-align: middle-left; }
