#wm-shop-root .wm-proc-pool-item.wm-proc-claimed .wm-proc-item-name { color: rgb(148, 160, 128); }
#wm-shop-root .wm-proc-filter.wm-proc-selected { background-color: rgba(134, 133, 105, 0.1); border-color: rgba(166, 160, 127, 0.53); }
#wm-shop-root .wm-proc-results-heading .wm-proc-title { font-size: 28px; }
#wm-shop-root .wm-proc-transfer-progress { position: absolute; left: 40%; right: 40%; top: 565px; height: 2px; background-color: rgba(159, 164, 114, 0.15); }
#wm-shop-root .wm-proc-transfer-progress-fill { height: 100%; background-color: rgb(184, 186, 132); }
#wm-shop-root .wm-shop-primary .wm-proc-button-caption { color: rgb(34, 35, 23); }

#wm-shop-root .wm-proc-title, #wm-shop-root .wm-proc-generation, #wm-shop-root .wm-proc-section-title { -unity-font-definition: url("fonts/NotoSans-CondensedMedium.ttf"); -unity-font: url("fonts/NotoSans-CondensedMedium.ttf"); }
#wm-shop-root .wm-proc-roman, #wm-shop-root .wm-proc-reveal-roman { -unity-font-definition: url("fonts/LiberationSerif-Regular.ttf"); -unity-font: url("fonts/LiberationSerif-Regular.ttf"); }

#wm-shop-root .wm-proc-quantity { margin: 0; padding: 0; }
#wm-shop-root .wm-proc-quantity #unity-text-input { margin: 0; padding: 4px 8px; border-radius: 0; }
#wm-shop-root .wm-proc-quantity #unity-text-input:focus { border-color: rgb(189, 166, 100); }
#wm-shop-root .wm-proc-quantity .unity-text-element { color: rgb(225, 217, 186); -unity-text-align: middle-center; }

#wm-shop-root .wm-proc-orbit { position: absolute; left: 70%; margin-left: -226px; top: -60px; width: 452px; height: 452px; }
#wm-shop-root .wm-proc-quantity { --unity-selection-color: rgba(180, 159, 98, 0.4); --unity-cursor-color: rgb(234, 214, 164); }
