.wm-bay-modal {
    position: absolute;
    right: 0;
    top: 0;
    width: 400px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.94);
}

.wm-bay-title {
    font-size: 12px;
    color: rgb(229, 200, 192);
    -unity-text-align: middle-left;
    margin-bottom: 8px;
}

.wm-bay-scroll {
    max-height: 340px;
    width: 100%;
}

.wm-bay-list {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
}

.wm-bay-row {
    height: 32px;
    width: 100%;
    flex-shrink: 0;
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 2px;
}

.wm-bay-row-chip {
    width: 56px;
    height: 24px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-bay-row-name {
    flex-grow: 1;
    font-size: 10px;
    color: rgb(228, 225, 180);
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}

.wm-bay-row-state {
    font-size: 9px;
    color: rgb(184, 151, 134);
    -unity-text-align: middle-right;
    padding: 0;
    margin: 0;
}

.wm-bay-row-blocked {
    opacity: 0.4;
}

.wm-bay-tile {
    position: absolute;
    padding: 0;
    align-items: flex-start;
    justify-content: flex-start;
}

.wm-bay-tile-art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-bay-tile-name {
    font-size: 9px;
    color: rgb(228, 225, 180);
    -unity-text-align: upper-left;
    margin-left: 6px;
    margin-top: 5px;
    padding: 0;
}

.wm-bay-tile-short {
    font-size: 8px;
    color: rgb(184, 151, 134);
    -unity-text-align: upper-left;
    margin-left: 6px;
    margin-top: 1px;
    padding: 0;
}

.wm-bay-tile-num {
    position: absolute;
    top: 3px;
    right: 5px;
    font-size: 9px;
    color: rgb(140, 133, 116);
    padding: 0;
    margin: 0;
}

.wm-bay-tile-plus {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 20px;
    color: rgb(140, 133, 116);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.wm-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
