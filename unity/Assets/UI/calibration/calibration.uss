/* Window and equipment borders use the native game styles. */
.wm-cal-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.wm-cal-fill,
.wm-cal-blocker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.wm-cal-blocker { background-color: rgba(0, 0, 0, 0.65); }

.wm-cal-panel {
    width: 920px;
    height: 600px;
    max-width: 94%;
    max-height: 90%;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.94);
}

.wm-cal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 0 0 10px;
}

.wm-cal-title {
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: rgb(229, 200, 192);
    -unity-text-align: middle-left;
}

.wm-cal-close {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    color: rgb(188, 176, 150);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(72, 70, 63);
}

.wm-cal-close:hover { color: rgb(238, 227, 190); border-color: rgb(188, 176, 150); }
.wm-cal-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.wm-cal-listpane { width: 330px; flex-shrink: 0; padding-right: 12px; }
.wm-cal-list { flex-grow: 1; min-height: 0; background-color: rgba(0, 0, 0, 0); }

.wm-cal-list #unity-content-container,
.wm-cal-list .unity-scroll-view__content-container {
    width: 100%;
    align-items: stretch;
    padding-right: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.wm-cal-list .unity-scroll-view__horizontal-scroller { display: none; }
.wm-cal-detail { flex-grow: 1; flex-shrink: 1; min-width: 0; padding: 0 10px 4px 16px; }
.wm-cal-empty { font-size: 9px; color: rgb(184, 151, 134); }

.wm-cal-sectionlabel {
    margin: 0 0 10px;
    padding: 0;
    font-size: 10px;
    color: rgb(229, 200, 192);
}

.wm-cal-row {
    width: 100%;
    height: 106px;
    flex-shrink: 0;
    margin: 0 0 4px;
    padding: 0;
    align-items: flex-start;
    justify-content: flex-start;
}

.wm-cal-name {
    margin: 7px 42px 0 9px;
    padding: 0;
    font-size: 10px;
    color: rgb(228, 225, 180);
    -unity-text-align: upper-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 82%;
}

.wm-cal-rank {
    position: absolute;
    right: 7px;
    top: 6px;
    margin: 0;
    padding: 1px 3px;
    font-size: 9px;
    color: var(--wm-rel);
    background-color: rgba(0, 0, 0, 0.65);
}

.wm-cal-rank--base { color: rgb(184, 151, 134); }

.wm-cal-who {
    position: absolute;
    bottom: 7px;
    left: 9px;
    margin: 0;
    padding: 0;
    font-size: 9px;
    color: rgb(184, 151, 134);
}

.wm-cal-detailhead { flex-shrink: 0; margin-bottom: 18px; }
.wm-cal-detailtitle { min-width: 0; }
.wm-cal-detailname { margin: 0; padding: 0; font-size: 16px; color: rgb(228, 225, 180); white-space: normal; }
.wm-cal-detailwho { margin: 3px 0 0; padding: 0; font-size: 9px; color: rgb(184, 151, 134); }
.wm-cal-track { flex-direction: row; flex-shrink: 0; margin-bottom: 22px; }

.wm-cal-node {
    flex-grow: 1;
    flex-basis: 0;
    height: 26px;
    margin: 0 4px 0 0;
    padding: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgb(58, 56, 49);
    font-size: 9px;
    -unity-text-align: middle-center;
    color: rgb(108, 102, 89);
}

.wm-cal-node--last { margin-right: 0; }
.wm-cal-node--done { color: rgb(188, 176, 150); border-bottom-color: rgb(136, 124, 83); }
.wm-cal-node--current { color: var(--wm-rel); border-bottom-color: var(--wm-rel); background-color: rgba(233, 203, 79, 0.08); }
.wm-cal-stats { flex-shrink: 0; }

.wm-cal-statrow {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 27px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(188, 176, 150, 0.12);
}

.wm-cal-statname { margin: 0; padding: 0; font-size: 9px; color: rgb(184, 151, 134); }
.wm-cal-statvals { flex-direction: row; align-items: center; }
.wm-cal-statnow { min-width: 40px; font-size: 10px; color: rgb(228, 225, 180); -unity-text-align: middle-right; }
.wm-cal-statarrow { font-size: 9px; color: rgb(108, 102, 89); margin-left: 12px; margin-right: 12px; }
.wm-cal-statnext { min-width: 40px; font-size: 10px; color: var(--wm-rel); -unity-text-align: middle-right; }

.wm-cal-foot { margin-top: auto; padding-top: 18px; flex-shrink: 0; }
.wm-cal-costs { flex-direction: row; flex-wrap: wrap; margin-bottom: 16px; }
.wm-cal-cost { width: 50%; flex-direction: row; align-items: center; padding-right: 10px; }
.wm-cal-material-icon { width: 48px; height: 48px; flex-shrink: 0; }
.wm-cal-material-text { flex-shrink: 1; margin-left: 10px; min-width: 0; }
.wm-cal-material-name { margin: 0; padding: 0; font-size: 9px; color: rgb(228, 225, 180); white-space: normal; }
.wm-cal-material-count { margin: 4px 0 0; padding: 0; font-size: 9px; color: rgb(184, 151, 134); }
.wm-cal-material-missing { color: rgb(205, 104, 89); }
.wm-cal-actions { flex-direction: row; }
.wm-cal-actions .text-button { flex-grow: 1; flex-basis: 0; height: 28px; margin-right: 8px; }
.wm-cal-actions .text-button:last-child { margin-right: 0; }
.wm-cal-btn-disabled { opacity: 0.35; }
.wm-cal-tally { margin: 10px 0 0; padding: 0; font-size: 8px; color: rgb(184, 151, 134); }
