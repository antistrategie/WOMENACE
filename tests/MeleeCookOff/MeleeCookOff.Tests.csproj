  <PropertyGroup Condition="'$(JiangyuDev)' == 'true'">
    <DefineConstants>$(DefineConstants);JIANGYU_DEV</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../code/Systems/MeleeCookOffSystem.cs" Link="MeleeCookOffSystem.cs" />
    <Compile Include="../../code/Systems/Skills/MeleeSkills.cs" Link="MeleeSkills.cs" />
  </ItemGroup>
</Project>
