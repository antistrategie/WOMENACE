clone "SkillTemplate" from="effect.bleeding" id="effect.wmgfl_corrosion" {
    set "Icon" asset="elements/corrosion"
    set "Title" {
        set "m_DefaultTranslation" "Corroded"
    }
    set "Description" {
        set "m_DefaultTranslation" "Corrosive agents dissolve plating. Loses 20% of current <link=\"armor\">Armour</link> per turn for 3 turns."
    }
    clear "EventHandlers"
    append "EventHandlers" type="LifetimeLimit" {
        set "Event" enum="LifetimeType" "OnTurnEnd"
        set "Lifetime" 3
        set "ResetLifetimeOnRefresh" #false
    }
    append "EventHandlers" type="DamageOverTime" {
        set "ElementsHitPercentage" 1.0
        set "DamagesArmorFirst" #true
        set "DamageArmorPctOfCurrent" 0.2
        set "ArmorPenetration" 1000.0
        set "FatalityType" enum="FatalityType" "Burning"
        set "DamageVisualizationType" enum="DamageVisualizationType" "Burn"
    }
    append "EventHandlers" type="DisplayText" {
        set "Event" enum="DisplayEvent" "OnAdded"
        set "LocaKey" "wmgfl_corrosion"
        set "DefaultText" "Corroded!"
    }
}

clone "SkillTemplate" from="effect.bleeding" id="effect.wmgfl_hydro" {
    set "Icon" asset="elements/hydro"
    set "Title" {
        set "m_DefaultTranslation" "Drenched"
    }
    set "Description" {
        set "m_DefaultTranslation" "Waterlogged and exposed. Cover counts one tier worse for 3 turns."
    }
    clear "EventHandlers"
    append "EventHandlers" type="LifetimeLimit" {
        set "Event" enum="LifetimeType" "OnTurnEnd"
        set "Lifetime" 3
        set "ResetLifetimeOnRefresh" #false
    }
    append "EventHandlers" type="ChangeProperty" {
        set "Trigger" enum="UpdateEvent" "OnUpdate"
        set "PropertyType" enum="EntityPropertyType" "CoverTypeOffset"
        set "Amount" -1
        set "AmountMult" 1.0
    }
    append "EventHandlers" type="DisplayText" {
        set "Event" enum="DisplayEvent" "OnAdded"
        set "LocaKey" "wmgfl_hydro"
        set "DefaultText" "Drenched!"
    }
}
