    set "MinCampaignProgress" 0
}

clone "CommodityTemplate" from="commodity.core_world_memorabillia" id="commodity.wmgfl_gift_heavy_metal_necklace" {
    set "Title" {
        set "m_DefaultTranslation" "Heavy Metal Necklace"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Pretty sure this is actually a dog collar. It gives dog collar vibes.

            Wait... ohhhh... I see how it is. That is quite delightful.
            """
    }

    set "Icon" asset="gifts/Item_Icon_love_gift_jewelry_5"
