        set "m_DefaultTranslation" "Why do these things still have controllers? You'd think by now we'd have progressed VR technology so far that we're able to use hand tracking for everything as a bare minimum, and that's with me ignoring how bulky the actual headset is."
    }
    set "Icon" asset="gifts/Item_Icon_love_gift_electrical_5"
