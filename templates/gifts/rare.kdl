        set "m_DefaultTranslation" "If you think I'm going to make a joke about reading then you're mistaken. Anti-intellectualism is a cancer on humanity and you should be ashamed to not be reguarly reading."
    }
    set "Icon" asset="gifts/Item_Icon_love_gift_pendant_2"
