clone "AccessoryTemplate" from="accessory.ammo_hollow_points" id="accessory.limonad_standard_rpg_ammo" {
    // GFL2's Standard RPG Ammo (Support_Ammo_ATG_01_2, the middle of Basic, Standard and Elite),
    // for Team Limonad alone: OnlyEquipableBy names the team's tag, which keeps it out of every
    // other leader's list and lets the team's own list keep it (SupportTeamEquipSystem). It stays
    // an ammo accessory, so it takes the place of any other.
    set "Title" {
        set "m_DefaultTranslation" "Standard RPG Ammo"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "RPG Ammo"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Standard supplies for RPG teams. Only available in limited quantities, but they produce better results on the battlefield.

            <style="Highlight">• +$1% Damage

            • Only one ammo accessory can be equipped
            • Only for Team Limonad</style>
            """
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "passive.limonad_standard_rpg_ammo" path="EventHandlers[0].Properties[0].AmountMult" format="bonus-percent"
    }
    set "Icon" asset="limonad/items/standard_rpg_ammo"
    set "IconEquipment" asset="limonad/items/standard_rpg_ammo"
    set "IconEquipmentDisabled" asset="limonad/items/standard_rpg_ammo_disabled"
    set "BlackMarketMaxQuantity" 0
    append "OnlyEquipableBy" "wmgfl_team_limonad"
    clear "SkillsGranted"
    append "SkillsGranted" "passive.limonad_standard_rpg_ammo"
}

clone "SkillTemplate" from="passive.ammo_hollow_points" id="passive.limonad_standard_rpg_ammo" {
    set "Title" {
        set "m_DefaultTranslation" "RPG Ammo"
    }
    set "Description" {
        set "m_DefaultTranslation" "Increases Damage by $1%."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "passive.limonad_standard_rpg_ammo" path="EventHandlers[0].Properties[0].AmountMult" format="bonus-percent"
    }
    // Hollow points' tags mark it as anti-infantry, low-penetration projectile ammo, which this is
    // not, and its conditional handler applies only to projectile weapons. The team fires only its
    // launcher, so the bonus is plain.
    clear "Tags"
    clear "EventHandlers"
    append "EventHandlers" type="ChangeProperty" {
        set "Trigger" enum="UpdateEvent" "OnUpdate"
        append "Properties" {
            set "PropertyType" enum="EntityPropertyType" "DamageMult"
            set "Amount" 0
            set "AmountMult" 1.2
        }
    }
}
