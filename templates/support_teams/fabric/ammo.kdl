clone "AccessoryTemplate" from="accessory.ammo_hollow_points" id="accessory.fabric_standard_mortar_ammo" {
    // GFL2's Standard Mortar Ammo (Support_Ammo_MRT_01_2, the middle of Basic, Standard and Elite),
    // for Team Fabric alone: OnlyEquipableBy names the team's tag, which keeps it out of every
    // other leader's list and lets the team's own list keep it (SupportTeamEquipSystem). It stays
    // an ammo accessory, so it takes the place of any other.
    set "Title" {
        set "m_DefaultTranslation" "Standard Mortar Ammo"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Mortar Ammo"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Standard supplies used by mortar teams. Can be used by mortars of various calibres. While it is only available in limited quantities, it can produce better results on the battlefield.

            <style="Highlight">+$1% Damage

            • Only one ammo accessory can be equipped
            • Only applies to Team Fabric</style>
            """
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "passive.fabric_standard_mortar_ammo" path="EventHandlers[0].Properties[0].AmountMult" format="bonus-percent"
    }
    set "Icon" asset="fabric/items/standard_mortar_ammo"
    set "IconEquipment" asset="fabric/items/standard_mortar_ammo"
    set "IconEquipmentDisabled" asset="fabric/items/standard_mortar_ammo_disabled"
    set "BlackMarketMaxQuantity" 0
    append "OnlyEquipableBy" "wmgfl_team_fabric"
    clear "SkillsGranted"
    append "SkillsGranted" "passive.fabric_standard_mortar_ammo"
}

clone "SkillTemplate" from="passive.ammo_hollow_points" id="passive.fabric_standard_mortar_ammo" {
    set "Title" {
        set "m_DefaultTranslation" "Mortar Ammo"
    }
    set "Description" {
        set "m_DefaultTranslation" "Increases Damage by $1%."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "passive.fabric_standard_mortar_ammo" path="EventHandlers[0].Properties[0].AmountMult" format="bonus-percent"
    }
    // Hollow points' tags mark it as anti-infantry, low-penetration projectile ammo, which this is
    // not, and its conditional handler applies only to projectile weapons. The team fires only its
    // mortar, so the bonus is plain.
    clear "Tags"
    clear "EventHandlers"
    append "EventHandlers" type="ChangeProperty" {
        set "Trigger" enum="UpdateEvent" "OnUpdate"
        append "Properties" {
            set "PropertyType" enum="EntityPropertyType" "DamageMult"
            set "Amount" 0
            set "AmountMult" 1.2
        }
    }
}
