patch "TextTooltipsConfig" "text_tooltips_config" {
    // The mod's keyword tooltips, all in one place: Jiangyu permits a single
    // patch block per template target across the mod, so every <link="id">
    // registered with the game's TextTooltipsConfig lives here. A skill
    // description writes <link="wmgfl_burn">Burn</link> and hovering the word
    // opens the matching entry as a nested tooltip.
    // The elements. Phase damage is exclusive to SSR weapons: hits build the
    // element on the victim and at 20% of the unit's max hitpoints the effect
    // (templates/elements/) procs.
    append "Tooltips" {
        set "LinkId" "wmgfl_burn"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Burn"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Burn Phase damage builds up on the target. Once it reaches 20% of their max <link=\"hitpoints\">Hitpoints</link> they are Burned, losing $1% max <link=\"hitpoints\">Hitpoints</link> per turn for $2 turns. Build-up is ignored while the fire lasts."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_burn" path="EventHandlers[1].DamagePctMaxHitpoints" format="percent"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_burn" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "wmgfl_shock"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Electric"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Electric Phase damage builds up on the target. Once it reaches 20% of their max <link=\"hitpoints\">Hitpoints</link> they are Electrified, reducing <link=\"accuracy\">Accuracy</link> by $1% for $2 turns. Build-up is ignored while the charge lasts."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_shock" path="EventHandlers[1].Properties[0].AmountMult" format="reduction-percent"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_shock" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "wmgfl_freeze"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Freeze"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Freeze Phase damage builds up on the target. Once it reaches 20% of their max <link=\"hitpoints\">Hitpoints</link> they are Frozen, reducing <link=\"action_points\">Action Points</link> by $1% for $2 turns. Build-up is ignored while the frost lasts."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_freeze" path="EventHandlers[1].Properties[0].AmountMult" format="reduction-percent"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_freeze" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "wmgfl_corrosion"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Corrosion"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Corrosion Phase damage builds up on the target. Once it reaches 20% of their max <link=\"hitpoints\">Hitpoints</link> they are Corroded, losing $1% of current <link=\"armor\">Armour</link> per turn for $2 turns. Build-up is ignored while the acid lasts."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_corrosion" path="EventHandlers[1].DamageArmorPctOfCurrent" format="percent"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_corrosion" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "wmgfl_hydro"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Hydro"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Hydro Phase damage builds up on the target. Once it reaches 20% of their max <link=\"hitpoints\">Hitpoints</link> they are Drenched and their cover counts $1 tier worse for $2 turns. Build-up is ignored while they stay soaked."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_hydro" path="EventHandlers[1].Properties[0].Amount" format="magnitude"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_hydro" path="EventHandlers[0].Lifetime"
        }
    }

    // Soppo's stances (applied by her SSR fire skills, mutually exclusive).
    append "Tooltips" {
        set "LinkId" "soppo_hunter_form"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Hunter Form"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "<link=\"accuracy\">Accuracy</link> increased by $1%."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.soppo_hunter_form" path="EventHandlers[0].Properties[0].AmountMult" format="bonus-percent"
        }
    }
    append "Tooltips" {
        set "LinkId" "soppo_feral_form"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Feral Form"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Damage dealt increased by $1%."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.soppo_feral_form" path="EventHandlers[0].Properties[0].AmountMult" format="bonus-percent"
        }
    }

    // Sextans' kit keywords.
    append "Tooltips" {
        set "LinkId" "sextans_blood_kiss"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Blood Kiss"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Marked by Sextans' blade for $1 turns. <link=\"sextans_midnight_vesper\">Midnight Vesper</link> deals bonus damage to the marked and feeds on them for extra <link=\"hitpoints\">Hitpoints</link>."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.sextans_blood_kiss" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "sextans_coagulation"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Coagulation"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Sextans gains a charge for every enemy her blade finds, up to $1. At $2 charges <link=\"sextans_midnight_vesper\">Midnight Vesper</link> is ready. Using it consumes $2 and keeps the rest."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "active.sextans_ult" path="EventHandlers[1].MaxCharges"
            append "m_Placeholders" bind="SkillTemplate" "active.sextans_ult" path="EventHandlers[1].ChargesNeeded"
        }
    }
    append "Tooltips" {
        set "LinkId" "sextans_midnight_vesper"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Midnight Vesper"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Sextans' ultimate. She dashes to a point of her choosing, cutting through everything on the way. Every victim struck restores her <link=\"hitpoints\">Hitpoints</link>. Marked enemies take extra damage, restore more, and lose their mark. Her allies receive the <link=\"sextans_holy_blood_mark\">Holy Blood Mark</link>. Requires $1 charges of <link=\"sextans_coagulation\">Coagulation</link>."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "active.sextans_ult" path="EventHandlers[1].ChargesNeeded"
        }
    }
    append "Tooltips" {
        set "LinkId" "sextans_holy_blood_mark"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Holy Blood Mark"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "<link=\"critical_chance\">Critical Chance</link> and critical damage rise while the blessing lasts. Lasts $1 turns."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.sextans_holy_blood_mark" path="EventHandlers[2].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "alva_hypothermia"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Hypothermia"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Enemies in Frost Echo take $1% more damage from <link=\"wmgfl_freeze\">Freeze</link> skills. Refreshed each turn they end inside the field, and lasts $2 turns after they leave it."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.alva_frost_echo" path="EventHandlers[1].DamageMult" format="bonus-percent"
            append "m_Placeholders" bind="SkillTemplate" "effect.alva_frost_echo" path="EventHandlers[0].Lifetime"
        }
    }

    // Sinbreaker's Monarch kit keywords.
    append "Tooltips" {
        set "LinkId" "voymastina_target_lock"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Target Lock"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Applied by Dread Ultimatum hits. Sinbreaker's next Pile Bunker against the marked enemy consumes the mark for +$1% <link=\"hitpoint_damage\">Hitpoint damage</link>. Lasts until the end of her next turn."
            clear "m_Placeholders"
            append "m_Placeholders" bind="PerkTemplate" "perk.voymastina_monarch" path="EventHandlers[0].TargetLockBonus" format="percent"
        }
    }
    append "Tooltips" {
        set "LinkId" "voymastina_energy_thief"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Energy Thief"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Sinbreaker's first Pile Bunker execution each turn restores $1% of her maximum <link=\"armor_durability\">armour durability</link>, or all durability if the destroyed unit is a vehicle."
            clear "m_Placeholders"
            append "m_Placeholders" bind="PerkTemplate" "perk.voymastina_monarch" path="EventHandlers[0].RepairFraction" format="percent"
        }
    }
    // The game's own keyword entries for squaddies, in the dummy links' words.
    set "Tooltips" index=12 {
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Dummy Links"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" """
                Dummies are the elements assigned to a squad, linked bodies its leader fights with. Each squad can take on up to 8 dummies. Each dummy adds their <link="hitpoints">Hitpoints</link> to the squad's hitpoint total and their <link="armor_durability">Armor Durability</link> to the armor durability total.

                Dummies are persistent and known by their serial numbers. They are lost for good if killed in combat, except when they are rescued. Then they will be wounded and available again for the next operation.

                Wounded Dummies: {1}
                Max. Dummies: {0}
                """
        }
    }
    set "Tooltips" index=30 {
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Dummies - Manpower"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Up to 8 <link=\"squaddies\">dummies</link> can be added to each squad leader. Each dummy will take one additional set of armor and squad weapon and will increase the hitpoint pool of a unit."
        }
    }
    set "Tooltips" index=48 {
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Initial Dummies"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Choose with how many <link=\"squaddies\">Dummies</link> you start the game."
        }
    }
    set "Tooltips" index=70 {
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Max. Dummies"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "The maximum amount of <link=\"squaddies\">Dummies</link> on the Impetus. When the capacity is reached no more dummies can be added by OCIs, events or through other ways. To expand this build more quarters."
        }
    }
    set "Tooltips" index=72 {
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Dummy Rescue Mode"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Determines how many dummies can be rescued after being downed in a mission. Setting this to \"none\" will lead to no dummies being rescued at all."
        }
    }
}
