// The mod's keyword tooltips, all in one place: Jiangyu permits a single
// patch block per template target across the mod, so every <link="id">
// registered with the game's TextTooltipsConfig lives here. A skill
// description writes <link="wmgfl_burn">Burn</link> and hovering the word
// opens the matching entry as a nested tooltip.
patch "TextTooltipsConfig" "text_tooltips_config" {
    // The elements. Phase damage is exclusive to SSR weapons: hits build the
    // element on the victim and at 20% of the unit's max hitpoints the effect
    // (templates/elements/) procs.
    append "Tooltips" {
        set "LinkId" "wmgfl_burn"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Burn"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Burn Phase damage builds up on the target. Once it reaches 20% of their max Hitpoints they are Burned, losing $1% max Hitpoints per turn for $2 turns. Build-up is ignored while the fire lasts."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_burn" path="EventHandlers[1].DamagePctMaxHitpoints" format="percent"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_burn" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "wmgfl_shock"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Electric"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Electric Phase damage builds up on the target. Once it reaches 20% of their max Hitpoints they are Electrified, reducing Accuracy by $1% for $2 turns. Build-up is ignored while the charge lasts."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_shock" path="EventHandlers[1].AmountMult" format="reduction-percent"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_shock" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "wmgfl_freeze"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Freeze"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Freeze Phase damage builds up on the target. Once it reaches 20% of their max Hitpoints they are Frozen, reducing Action Points by $1% for $2 turns. Build-up is ignored while the frost lasts."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_freeze" path="EventHandlers[1].AmountMult" format="reduction-percent"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_freeze" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "wmgfl_corrosion"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Corrosion"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Corrosion Phase damage builds up on the target. Once it reaches 20% of their max Hitpoints they are Corroded, losing $1% of current Armour per turn for $2 turns. Build-up is ignored while the acid lasts."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_corrosion" path="EventHandlers[1].DamageArmorPctOfCurrent" format="percent"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_corrosion" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "wmgfl_hydro"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Hydro"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Hydro Phase damage builds up on the target. Once it reaches 20% of their max Hitpoints they are Drenched and their cover counts $1 tier worse for $2 turns. Build-up is ignored while they stay soaked."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_hydro" path="EventHandlers[1].Amount" format="magnitude"
            append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_hydro" path="EventHandlers[0].Lifetime"
        }
    }

    // Soppo's stances (applied by her SSR fire skills, mutually exclusive).
    append "Tooltips" {
        set "LinkId" "soppo_hunter_form"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Hunter Form"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Accuracy increased by $1%."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.soppo_hunter_form" path="EventHandlers[0].AmountMult" format="bonus-percent"
        }
    }
    append "Tooltips" {
        set "LinkId" "soppo_feral_form"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Feral Form"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Damage dealt increased by $1%."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.soppo_feral_form" path="EventHandlers[0].AmountMult" format="bonus-percent"
        }
    }

    // Sextans' kit keywords.
    append "Tooltips" {
        set "LinkId" "sextans_blood_kiss"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Blood Kiss"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Marked by Sextans' blade for $1 turns. <link=\"sextans_midnight_vesper\">Midnight Vesper</link> deals bonus damage to the marked and feeds on them for extra vitality."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.sextans_blood_kiss" path="EventHandlers[0].Lifetime"
        }
    }
    append "Tooltips" {
        set "LinkId" "sextans_coagulation"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Coagulation"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Sextans gains a charge for every enemy her blade finds, up to $1. At $2 charges <link=\"sextans_midnight_vesper\">Midnight Vesper</link> is ready. Using it consumes $2 and keeps the rest."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "active.sextans_ult" path="EventHandlers[1].MaxCharges"
            append "m_Placeholders" bind="SkillTemplate" "active.sextans_ult" path="EventHandlers[1].ChargesNeeded"
        }
    }
    append "Tooltips" {
        set "LinkId" "sextans_midnight_vesper"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Midnight Vesper"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Sextans' ultimate. She dashes to a point of her choosing, cutting through everything on the way. Every victim struck restores her vitality. Marked enemies take extra damage, restore more, and lose their mark. Her allies receive the Holy Blood Mark. Requires $1 charges of Coagulation."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "active.sextans_ult" path="EventHandlers[1].ChargesNeeded"
        }
    }
    append "Tooltips" {
        set "LinkId" "sextans_holy_blood_mark"
        set "TooltipHeading" {
            set "m_DefaultTranslation" "Holy Blood Mark"
        }
        set "TooltipText" {
            set "m_DefaultTranslation" "Critical hit chance and critical damage rise while the blessing lasts. Lasts $1 turns."
            clear "m_Placeholders"
            append "m_Placeholders" bind="SkillTemplate" "effect.sextans_holy_blood_mark" path="EventHandlers[2].Lifetime"
        }
    }
}
