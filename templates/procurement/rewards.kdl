clone "StrategicAssetTemplate" from="hardware_reward" id="wmgfl_collapse_piece_reward" {
    set "Name" {
        set "m_DefaultTranslation" "Collapse Pieces ×25"
    }
    set "Description" {
        set "m_DefaultTranslation" "Gain 25 Collapse Pieces."
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "Gain 25 Collapse Pieces."
    }
    set "Icon" asset="procurement/collapse_piece"
    clear "Effects"
    // The native effect grants one piece and names the item in the asset tooltip, which lists
    // one row per item effect. ProcurementRewardSystem grants the rest of the bundle when it fires.
    append "Effects" type="AddItemEffect" {
        set "Item" "commodity.wmgfl_collapse_piece"
    }
}
