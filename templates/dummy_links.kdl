    set "Description" {
        set "m_DefaultTranslation" "Crew living quarters that house enlisted rank personnel. This increases the dummy maximum limit by $1 and casualty recovery rate by $2%."
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" """
            <style="Highlight">• +$1 max <link="squaddies">Dummies.</link>
            • +$2% chance to recover casualties.</style>
            """
    }
}

