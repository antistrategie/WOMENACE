patch "AccessoryTemplate" "accessory.ifak_first_aid_kit" {
    // The game's text calls the bodies in a squad squaddies. Here they are a Doll's dummy links,
    // so the game's descriptions that name them say dummies, word for word otherwise. The
    // interface strings no template carries are replaced in DummyLinkTextSystem, and the
    // keyword tooltips in text_tooltips.kdl. The perks of the game's own leaders keep their
    // text, apart from the ones a Doll's perk tree offers.
    set "Description" {
        set "m_DefaultTranslation" """
            The Individual First Aid Kit contains all tools and drugs needed to treat immediate battlefield trauma. Issuing it to a squad will substantially increase the chances of dummies surviving injuries.

            #########

            Increases Dummy Rescue Chance for this unit by $1% with $2 always being rescued. Does not stack.
            """
    }
}

patch "AccessoryTemplate" "accessory.morphidrin_patch_drugs" {
    set "Description" {
        set "m_DefaultTranslation" """
            A slow release painkiller skin patch suppressing pain and allowing soldiers to keep fighting while recovering from injuries. 

            #########

            Removes "Injured" status effect while on a mission and increases hitpoints per dummy by $1.
            """
    }
}

