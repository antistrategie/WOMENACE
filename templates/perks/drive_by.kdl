clone "SkillTemplate" from="effect.drive_by" id="effect.wmgfl_drive_by" {
    set "EventHandlers" index=1 {
        set "SkillFilter" type="IsAttackFilter" {}
    }
    set "EventHandlers" index=2 {
        set "SkillFilter" type="IsAttackFilter" {}
    }
}

clone "PerkTemplate" from="perk.drive_by" id="perk.wmgfl_drive_by" {
    set "Title" {
        set "m_DefaultTranslation" "Drive By+"
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "-$1 <link=\"action_points\">AP</link> for next Standard Attack after moving. Applies to every weapon."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_drive_by" path="EventHandlers[1].CostDelta" format="magnitude"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            “Our more arcane historical records depict combatants utilizing hardware to drive past their enemies while simultaneously firing upon them with weapons atilt. We are uncertain as to the effectiveness of this strategy, but thanks to modern V&H Gyrostabilizers, our pilots can perhaps replicate this tactic with a greater degree of finesse.”

              – TCR Study on Maneuver Warfare


            <style="Highlight">• -$1 <link="action_points">AP</link> for next Standard Attack after moving. Can trigger multiple times per turn.</style>
            <style="Highlight">• Applies to every weapon, including melee and vehicle mounts.</style>
            """
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_drive_by" path="EventHandlers[1].CostDelta" format="magnitude"
    }

    set "EventHandlers" index=0 {
        set "Effect" "effect.wmgfl_drive_by"
    }
}
