clone "TagTemplate" from="unique" id="jy_weapon_restricted"

clone "TagTemplate" from="unique" id="jy_special_restricted"

clone "TagTemplate" from="unique" id="jy_vehicle_restricted"

clone "TagTemplate" from="unique" id="jy_no_sell"

clone "TagTemplate" from="unique" id="wmgfl_gift"

// Carried by no unit: an armour whose OnlyEquipableBy names only this tag never
// appears in any equip dropdown. Doll outfits use it, so they exist purely as
// transmog carriers (model, icons, name) for the transmog picker.
clone "TagTemplate" from="unique" id="wmgfl_transmog"

patch "StrategyConfig" "strategy_config" {
    append "InitialPickableUnitLeaders" "squad_leader.voymastina"
    append "InitialPickableUnitLeaders" "squad_leader.cheyanne"
    append "InitialPickableUnitLeaders" "squad_leader.leva"
    append "InitialPickableUnitLeaders" "squad_leader.lewis"
    append "InitialPickableUnitLeaders" "squad_leader.makiatto"
    append "InitialPickableUnitLeaders" "squad_leader.sextans"
}

