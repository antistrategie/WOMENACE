clone "TagTemplate" from="unique" id="armor_restricted"

clone "TagTemplate" from="unique" id="vehicle_restricted"

patch "StrategyConfig" "strategy_config" {
    append "InitialPickableUnitLeaders" "squad_leader.voymastina"
    append "InitialPickableUnitLeaders" "squad_leader.cheyanne"
    append "InitialPickableUnitLeaders" "squad_leader.leva"

    append "InitialAdditionalUnlockedItems" "vehicle.voymastina_mech_erwin"
}

patch "DossierItemTemplate" "dossier.squad_leader" {
    append "m_UnlockedLeaders" "squad_leader.voymastina"
    append "m_UnlockedLeaders" "squad_leader.cheyanne"
    append "m_UnlockedLeaders" "squad_leader.leva"
}

