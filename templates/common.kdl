clone "TagTemplate" from="unique" id="jy_weapon_restricted"

clone "TagTemplate" from="unique" id="jy_special_restricted"

clone "TagTemplate" from="unique" id="jy_vehicle_restricted"

clone "TagTemplate" from="unique" id="jy_no_sell"

clone "TagTemplate" from="unique" id="wmgfl_gift"

// Carried by no unit: an armour whose OnlyEquipableBy names only this tag never
// appears in any equip dropdown. Doll outfits use it, so they exist purely as
// transmog carriers (model, icons, name) for the transmog picker.
clone "TagTemplate" from="unique" id="wmgfl_transmog"

// Marks a skill as one of our melee attacks. MeleeCookOffSystem reads it so a target
// that dies to a blade or a pile bunker passes its death blast over the attacker.
//
// Cloned from "unique" like every other marker tag here, which carries TagType UNIQUE.
// That type is reachable from the engine's own tag queries once the tag sits on a
// SkillTemplate, but there is no inert TagType to pick instead (the enum has no NONE)
// and every alternative describes something less true of these skills. jy_no_sell
// already rides WeaponTemplate.Tags on the same basis.
clone "TagTemplate" from="unique" id="wmgfl_melee"

// Marks a skill as a vehicle gun granted by its entity rather than by an equipped
// weapon item. No item backs such a skill, so every vanilla mechanic that identifies
// vehicle weapon skills through their granting item rejects it: ammo cases, the
// dropship supply drop and Drive By all pass it over. EntityWeaponParitySystem reads
// this tag and answers those checks on the skill's behalf.
clone "TagTemplate" from="unique" id="wmgfl_entity_weapon"

// Weapon-type proficiency. A doll's speaker carries one of these to name the weapon
// class she is trained on. WeaponProficiencySystem reads the tag and grants an
// affinity-scaled accuracy bonus while she wields a weapon of that class.
clone "TagTemplate" from="unique" id="wmgfl_class_ar"

clone "TagTemplate" from="unique" id="wmgfl_class_smg"

clone "TagTemplate" from="unique" id="wmgfl_class_rifle"

clone "TagTemplate" from="unique" id="wmgfl_class_mg"

clone "TagTemplate" from="unique" id="wmgfl_class_blade"

