clone "PerkTemplate" from="passive.wmgfl_remolding_sentinel" id="passive.wmgfl_remolding_vanguard" {
    set "Title" {
        set "m_DefaultTranslation" "Remolding Pattern (Vanguard)"
    }
    set "Description" {
        set "m_DefaultTranslation" "Damage dealt to nearby enemies is increased by $1%."
        clear "m_Placeholders"
        append "m_Placeholders" bind="PerkTemplate" "passive.wmgfl_remolding_vanguard" path="EventHandlers[0].Properties[0].AmountMult" format="bonus-percent"
    }
    set "Icon" asset="remolding/vanguard"
    set "PerkIcon" asset="remolding/vanguard"
    set "EventHandlers" index=0 {
        set "Condition" type="DistanceCondition" {
            set "CheckEntity" enum="CheckTarget" "Target"
            set "MaxDistance" 3
            set "Negated" #false
        }
        set "DefaultText" "Remolding Pattern (Vanguard)"
    }
}

clone "SkillTemplate" from="active.use_pirate_drugs_protagon" id="active.wmgfl_remolding_second_wind" {
    set "Title" {
        set "m_DefaultTranslation" "Overdrive"
    }
    set "Description" {
        set "m_DefaultTranslation" "Take an extra turn with $1% of maximum <link=\"action_points\">AP</link>. Can only be used once per round."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_remolding_second_wind" path="EventHandlers[1].ActionPointsAvailable" format="percent"
    }
    set "Icon" asset="remolding/vanguard"
    set "IconDisabled" asset="remolding/vanguard"
    clear "Tags"
    append "Tags" "utility"
    append "Tags" "accessory"
    set "ActionPointCost" 20
    set "IsLimitedUses" #true
    set "Uses" 2
    set "EventHandlers" index=0 {
        set "SkillToAdd" "effect.wmgfl_remolding_second_wind"
    }
    set "EventHandlers" index=1 {
        clear "NotUsableIfActorHasSkill"
        append "NotUsableIfActorHasSkill" "effect.wmgfl_remolding_second_wind"
    }
}

clone "SkillTemplate" from="effect.pirate_drugs_protagon" id="effect.wmgfl_remolding_second_wind" {
    set "Title" {
        set "m_DefaultTranslation" "Overdrive"
    }
    set "Description" {
        set "m_DefaultTranslation" "Granted an extra turn with $1% of maximum <link=\"action_points\">AP</link>. Overdrive cannot be used again this round."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.wmgfl_remolding_second_wind" path="EventHandlers[1].ActionPointsAvailable" format="percent"
    }
    set "Icon" asset="remolding/vanguard"
    set "EventHandlers" index=1 {
        set "ActionPointsAvailable" 0.75
    }
}
