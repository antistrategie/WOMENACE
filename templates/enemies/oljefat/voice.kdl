clone "ConversationTemplate" from="Pirate_Heavy/pirate_heavies_introduce_themselves" id="Oljefat/introduce" {
    set "Active" #true
    set "Roles" index=1 {
        set "m_SerializedRequirements" index=0 type="HasOneTag" {
            set "Tags" "wmgfl_oljefat"
        }
    }
    set "Condition" {
        set "ExpressionStr" ""
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_oljefat_va"
                        set "itemId" "Single_Skill_001"
                    }
                    set "RoleGuid" "Discovered"
                    set "Text" "I'll burn you all."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

