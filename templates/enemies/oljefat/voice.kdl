clone "TagTemplate" from="unique" id="wmgfl_oljefat"

clone "SpeakerTemplate" from="enemy.pirate_chaingun_team" id="wmgfl_oljefat_speaker" {
    set "Tags" "wmgfl_oljefat pirate"
    set "Nickname" {
        set "m_DefaultTranslation" "Oljefat"
    }
    set "BarkImage" asset="oljefat/bark"
}

clone "SoundBank" from="tactical_barks_jeansy_va" id="wmgfl_tactical_barks_oljefat_va" {
