        set "Template" "enemy.wmgfl_oljefat"
        set "Weight" 7
        set "WeightMultAfterPick" 0.1
        set "MaxConcurrentPctOfArmyPoints" 57
    }
}

patch "ArmyTemplate" "army.pirate_offensive_mid_game_reinforcements" {
    append "PossibleUnits" {
        set "Template" "enemy.wmgfl_oljefat"
        set "Weight" 7
        set "WeightMultAfterPick" 0.0
        set "MaxConcurrentPctOfArmyPoints" 57
    }
}
