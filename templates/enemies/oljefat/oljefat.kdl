clone "ElementAnimatorTemplate" from="animator.construct_soldier" id="animator.wmgfl_oljefat" {
    set "DeathBehaviour" enum="AnimatorDeathBehaviour" "DeathAnimations"
}

clone "EntityTemplate" from="enemy.pirate_flamethrower_team" id="enemy.wmgfl_oljefat" {
    set "Title" {
        set "m_DefaultTranslation" "Oljefat"
    }
    set "Description" {
        set "m_DefaultTranslation" "A pirate arsonist sealed in a heavy fireproof suit. Its twin-nozzle flamethrower burns out anything that holds a position, and it carries incendiary charges for targets out of reach."
    }

    set "SpeakerTemplate" "wmgfl_oljefat_speaker"
    set "AnimatorTemplate" "animator.wmgfl_oljefat"
    set "FactionSpecificAnimation" enum="FactionAnimationType" "None"
    set "AimWithVisualSlot" enum="VisualAlterationSlot" "EntireModel"
    set "IsAffectedByFatalities" #false
    set "ChanceForFemaleElements" 0
    set "Scale" {
        set "x" 1.0
        set "y" 1.0
    }
    set "HUDOffset" {
        set "y" 3.0
    }

    set "ArmyPointCost" 500
    append "Tags" "large"
    append "Tags" "heavy_armor"
    append "Tags" "mini_boss"
    append "Tags" "short_range"

    set "AIRole" {
        set "CoverAgainstOpponents" #false
        set "PeekInAndOutOfCover" #false
        set "IsAllowedToEvadeEnemies" #false
        set "ThreatFromOpponents" #true
        set "UseAoeAgainstSingleTargets" #true
        set "SafetyScale" 0.0
        set "InflictSuppression" 1.0
    }

    set "Properties" {
        set "MinElements" 1
        set "MaxElements" 1
        set "HitpointsPerElement" 350
        set "Armor" 100
        set "ArmorSide" 100
        set "ArmorBack" 100
        set "ArmorDurabilityPerElement" 250.0
        set "Accuracy" 70.0
        set "Discipline" 90.0
        set "Vision" 9
        set "SoundOnMovementStepOverrides2" #null
        set "SoundOnMovementStep" {
            set "bankId" "wmgfl_oljefat_sfx"
            set "itemId" "Footstep"
        }
        set "SoundOnDeath" {
            set "bankId" "wmgfl_oljefat_sfx"
            set "itemId" "Collision_Body"
        }
    }

    clear "AttachedPrefabs"
    clear "Items"
    append "Items" "accessory.wmgfl_oljefat_combustible_pack"
    clear "Loot"

    append "Skills" "active.wmgfl_oljefat_thermal_sterilization"
}

clone "SkillTemplate" from="active.pirate_heavy_flamethrower" id="active.wmgfl_oljefat_thermal_sterilization" {
    set "Title" {
        set "m_DefaultTranslation" "Thermal Sterilization"
    }
    set "Description" {
        set "m_DefaultTranslation" "Spray a wide cone of burning fuel that sets the ground on fire."
        clear "m_Placeholders"
    }

    set "ActionPointCost" 60
    set "IsLimitedUses" #false
    set "AnimationType" enum="AnimationType" "SpecialAttack1"
    set "DelayAfterAnimationTrigger" 0.8
    set "ConeAngle" 60
    append "Tags" "incendiary"

    set "IsOverridingRanges" #true
    set "MinRange" 1
    set "IdealRange" 2
    set "MaxRange" 4

    set "EventHandlers" index=1 {
        set "ElementsHit" 3
        set "ElementsHitPercentage" 0.6
        set "Damage" 70.0
        set "ArmorPenetration" 40.0
        set "DamageToArmorDurability" 110.0
    }
    remove "EventHandlers" index=5

    set "IsSoundOnAttackPerElementPlayingAfterAnimationDelay" #true
    set "IsSoundOnAttackPerElementFarPlayingAfterAnimationDelay" #true
    clear "SoundsOnAttack"
    clear "SoundsOnAttackFar"
    clear "SoundsOnAttackPerElement"
    append "SoundsOnAttackPerElement" {
        set "bankId" "wmgfl_oljefat_sfx"
        set "itemId" "Flame"
    }
    clear "SoundsOnAttackPerElementFar"
    append "SoundsOnAttackPerElementFar" {
        set "bankId" "wmgfl_oljefat_sfx"
        set "itemId" "Flame"
    }
}

clone "SkillTemplate" from="active.throw_incendiary_grenade" id="active.wmgfl_oljefat_flashpoint_overdrive" {
    set "Title" {
        set "m_DefaultTranslation" "Flashpoint Overdrive"
    }
    set "Description" {
        set "m_DefaultTranslation" "Throw an unstable fuel charge that bursts into flame on impact and sets the area on fire."
        clear "m_Placeholders"
    }

    set "ActionPointCost" 60
    set "IsLimitedUses" #true
    set "Uses" 2
    set "IsWeaponSetupRequired" #false
    set "MuzzleType" enum="MuzzleType" "Muzzle2"
    set "AnimationType" enum="AnimationType" "SpecialAttack2"
    set "DelayAfterAnimationTrigger" 0.45
    set "IsAlwaysHitting" #true
    set "CanHitAnotherTile" #false
    set "ScatterChance" 0
    set "AoEChanceToHitCenter" 100

    set "IsOverridingRanges" #true
    set "MinRange" 5
    set "IdealRange" 6
    set "MaxRange" 7

    set "EventHandlers" index=1 {
        set "ElementsHit" 3
        set "ElementsHitPercentage" 0.6
        set "Damage" 50.0
        set "ArmorPenetration" 35.0
        set "Suppression" 10.0
        set "DamageToArmorDurability" 80.0
    }

    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_oljefat_sfx"
        set "itemId" "Combustible_Throw"
    }
    clear "SoundsOnHit"
    append "SoundsOnHit" {
        set "bankId" "wmgfl_oljefat_sfx"
        set "itemId" "Combustible_Hit"
    }
}

clone "AccessoryTemplate" from="accessory.incendiary_grenade" id="accessory.wmgfl_oljefat_combustible_pack" {
    clear "SkillsGranted"
    append "SkillsGranted" "active.wmgfl_oljefat_flashpoint_overdrive"
}

patch "ArmyTemplate" "army.pirate_offensive_mid_game" {
    append "PossibleUnits" {
        set "Template" "enemy.wmgfl_oljefat"
        set "Weight" 6
        set "WeightMultAfterPick" 0.1
        set "MaxConcurrentPctOfArmyPoints" 57
    }
}

