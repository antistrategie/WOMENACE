clone "ShipUpgradeTemplate" from="oci.unbent_medevac" id="oci.wmgfl_fairy_lodge" {
    set "Icon" asset="fairies/fairy_lodge"
    set "Name" {
        set "m_DefaultTranslation" "Fairy Lodge"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Fairy Lodge"
    }
    set "Description" {
        set "m_DefaultTranslation" "A converted storage bay that houses and maintains support fairies."
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "<style=\"Highlight\">• Deployed Dolls gain +20 Affinity after each mission.</style>"
    }
    set "UnlockType" enum="ShipUpgradeUnlockType" "Always"
    set "OciPointsCosts" 40

    clear "Effects"
    append "ChildUpgrades" "oci.wmgfl_reinforcement_fairy"
    append "ChildUpgrades" "oci.wmgfl_peace_fairy"
    append "ChildUpgrades" "oci.wmgfl_parachute_fairy"
    append "ChildUpgrades" "oci.wmgfl_rescue_fairy"
}

clone "ShipUpgradeSlotTemplate" from="ship_upgrade_slot.hull" id="ship_upgrade_slot.wmgfl_fairies" {
    set "Name" {
        set "m_DefaultTranslation" "Fairies"
    }
    // FairySlotsSystem owns the additional slots outside the game's ten-slot save arrays.
    clear "Slots"
    clear "BasicUpgrades"
    append "BasicUpgrades" "oci.wmgfl_fairy_lodge"
}
