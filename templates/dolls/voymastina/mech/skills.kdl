clone "SkillTemplate" from="active.fire_assault_rifle_tier1_762" id="active.voymastina_mech_gun" {
    set "Title" {
        set "m_DefaultTranslation" "Dread Ultimatum"
    }
    set "Description" {
        set "m_DefaultTranslation" "Fire a <link=\"rate_of_fire\">$1-round burst</link>, applying <link=\"voymastina_target_lock\">Target Lock</link> on hit."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "active.voymastina_mech_gun" path="Repetitions"
    }

    set "ActionPointCost" 40
    set "Uses" 24

    // The mech grants this skill itself, so no weapon item backs it: the tag is what
    // lets ammo cases and the supply drop recognise it as a vehicle gun with ammo.
    append "Tags" "wmgfl_entity_weapon"

    set "MuzzleType" enum="MuzzleType" "Muzzle"
    set "IsWeaponSetupRequired" #false
    set "AnimationType" enum="AnimationType" "ShootSingle"
    set "KeyBind" enum="KeyBindPlayerSetting" "SelectItemSkill1"
    set "Order" enum="SkillOrder" "OffensiveTargeted"

    set "Repetitions" 3
    set "RepetitionDelay" 0.1
    set "DelayAfterAnimationTrigger" 1.35

    set "EventHandlers" index=0 {
        set "Damage" 37.0
        set "ArmorPenetration" 30.0
        set "Suppression" 3.0
        set "DamageToArmorDurability" 7.0
    }
    append "EventHandlers" type="WOMENACE:SinbreakerWeapon" {}

    set "IsSoundOnAttackPerElementPlayingAfterAnimationDelay" #true
    set "IsSoundOnAttackPerElementFarPlayingAfterAnimationDelay" #true

    clear "SoundsOnAttack"
    clear "SoundsOnAttackFar"
    clear "SoundsOnAttackPerElement"

    append "SoundsOnAttackPerElement" {
        set "bankId" "wmgfl_weapons_ar_addition_bank"
        set "itemId" "ar_burst"
    }
    append "SoundsOnAttackPerElement" {
        set "bankId" "weapons_soundbank"
        set "itemId" "small_caliber_brass_burst"
    }
    clear "SoundsOnAttackPerElementFar"
    append "SoundsOnAttackPerElementFar" {
        set "bankId" "wmgfl_weapons_ar_addition_bank"
        set "itemId" "ar_burst_distant"
    }
}

clone "SkillTemplate" from="active.launch_construct_rocket" id="active.voymastina_mech_rocket" {
    set "Title" {
        set "m_DefaultTranslation" "Sirius Fall"
    }
    set "Description" {
        set "m_DefaultTranslation" "Launch a high-explosive rocket at the target."
        clear "m_Placeholders"
    }

    set "ActionPointCost" 50
    set "Uses" 11

    append "Tags" "wmgfl_entity_weapon"

    set "MuzzleType" enum="MuzzleType" "Muzzle2"
    set "AnimationType" enum="AnimationType" "SpecialAttack1"
    set "KeyBind" enum="KeyBindPlayerSetting" "SelectItemSkill2"
    set "Order" enum="SkillOrder" "OffensiveSpecial"

    set "DelayAfterAnimationTrigger" 1.333

    set "EventHandlers" index=0 {
        set "Damage" 130.0
        set "ArmorPenetration" 80.0
        set "Suppression" 50.0
        set "DamageToArmorDurability" 50.0
        set "ElementsHit" 3
    }
}

clone "SkillTemplate" from="active.wetteroth_thats_a_knife" id="active.voymastina_mech_drill" {
    set "Title" {
        set "m_DefaultTranslation" "Pile Bunker"
    }
    set "Description" {
        set "m_DefaultTranslation" "Close in for a guaranteed melee strike that ignores cover. Consumes <link=\"voymastina_target_lock\">Target Lock</link> for bonus <link=\"hitpoint_damage\">Hitpoint damage</link>. Executions activate <link=\"voymastina_energy_thief\">Energy Thief</link>."
        clear "m_Placeholders"
    }

    // The knife base is culled after combat and the per-mission grant does not
    // reliably restore it, so a granted clone goes missing on later missions.
    // This is permanent kit: keep it out of the cull.
    set "IsRemovedAfterCombat" #false

    set "ActionPointCost" 60

    set "MuzzleType" enum="MuzzleType" "Muzzle3"
    set "AnimationType" enum="AnimationType" "SpecialAttack2"
    set "KeyBind" enum="KeyBindPlayerSetting" "SelectItemSkill3"
    set "Order" enum="SkillOrder" "OffensiveSpecial2"

    set "DelayAfterAnimationTrigger" 4.2

    set "IsOverridingRanges" #true
    set "MinRange" 1
    set "IdealRange" 1
    set "MaxRange" 6

    // The knife's sole exclusion is hovering. OnBeforeAnySkillUsed
    // (0x748DA0) zeroes its damage multiplier in hits and previews alike.
    // OnVerifyTarget (0x749050) reads EntityFlagsRequired only, so clearing
    // this damage exclusion preserves the existing targeting permissions.
    set "EventHandlers" index=0 {
        set "Damage" 150.0
        set "ArmorPenetration" 160.0
        set "Suppression" 80.0
        set "DamageToArmorDurability" 160.0
        clear "TargetCannotHaveOneOfTheseTags"
    }
    append "EventHandlers" type="WOMENACE:SinbreakerWeapon" {}

    clear "SoundsOnUse"
    clear "SoundsOnHit"

    append "SoundsOnUse" {
        set "bankId" "wmgfl_voymastina_mech_sfx"
        set "itemId" "UltraSkill_Satk"
    }
    append "SoundsOnHit" {
        set "bankId" "wmgfl_voymastina_mech_sfx"
        set "itemId" "UltraSkill_Cast"
    }

    append "Tags" "armor_piercing"
    append "Tags" "armor_damaging"
    append "Tags" "wmgfl_entity_weapon"
    append "Tags" "wmgfl_melee"
}
