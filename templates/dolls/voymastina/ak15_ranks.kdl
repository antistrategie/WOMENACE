clone "CommodityTemplate" from="commodity.construct_weapon_parts" id="commodity.wmgfl_component_voymastina_ak15" {
    set "Title" {
        set "m_DefaultTranslation" "Kalashnikova-15 Component"
    }
    set "Description" {
        set "m_DefaultTranslation" "[PLACEHOLDER] Weapon component for Kalashnikova-15"
    }
    append "Tags" "jy_no_sell"
    set "Icon" asset="weapon/ak15/Icon"
    set "Rarity" 0
    set "TradeValue" 0
    set "BlackMarketMaxQuantity" 0
    set "MinCampaignProgress" 0
}

clone "BlueprintTemplate" from="blueprint.squad_weapon_electro_magnetic_enhanced_assault_rifle" id="blueprint.wmgfl_voymastina_ak15_duplicate" {
    set "m_CraftingResult" "weapon.voymastina_ak15"
    clear "m_CraftingMaterials"
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_component_voymastina_ak15"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.construct_weapon_parts"
        set "Count" 4
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.construct_cybernetic_optics"
        set "Count" 2
    }
}
