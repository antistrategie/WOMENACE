clone "TagTemplate" from="unique" id="wmgfl_robella"

clone "SpeakerTemplate" from="carda" id="wmgfl_robella_speaker" {
    set "Tags" "wmgfl_robella female infantry waybacker wmgfl_class_smg"
    set "Nickname" {
        set "m_DefaultTranslation" "Robella"
    }
    set "Forename" {
        set "m_DefaultTranslation" "Robella"
    }
    set "Surname" {
        set "m_DefaultTranslation" ""
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Name: Robella (RO635)

            Proficiency: Frontline Command

            Birth: Unknown

            Age: Classified

            Affiliation(s): AR Team
            """
    }

    set "BarkImage" asset="robella/bark"
    set "StandLookLeftImage" asset="robella/stand_look_left"
    set "StandLookRightImage" asset="robella/stand_look_right"
    set "StandLookRightInactiveImage" asset="robella/stand_look_right_inactive"
}

clone "EntityTemplate" from="player_squad.carda" id="player_squad.robella" {
    append "Tags" "wmgfl_robella"
    set "Title" {
        set "m_DefaultTranslation" "AR Team"
    }
    set "Description" {
        set "m_DefaultTranslation" "On the surface, Robella appears decisive and acts with swift efficiency. In reality, in places unseen, she has already been struggling alone for a long time. Her sensitivity, gentleness, and delicacy are things that only you can see."
    }

    set "Badge" asset="robella/badge_mini"
    set "BadgeWhite" asset="robella/badge_mini"
    clear "Items"
    append "Items" "armor.player_fatigues"
    append "Items" "weapon.robella"
}

clone "UnitLeaderTemplate" from="squad_leader.carda" id="squad_leader.robella" {
    set "InfantryUnitTemplate" "player_squad.robella"
    set "SpeakerTemplate" "wmgfl_robella_speaker"
    set "CustomHead" #null
    set "UnitTitle" {
        set "m_DefaultTranslation" "Tactical Doll"
    }
    set "UnitDescription" {
        set "m_DefaultTranslation" "On the surface, Robella appears decisive and acts with swift efficiency. In reality, in places unseen, she has already been struggling alone for a long time. Her sensitivity, gentleness, and delicacy are things that only you can see."
    }

    set "InitialAttributes" index=0 100
    set "InitialAttributes" index=1 70
    set "InitialAttributes" index=2 85
    set "InitialAttributes" index=3 100
    set "InitialAttributes" index=4 100
    set "InitialAttributes" index=5 20
    set "InitialAttributes" index=6 100

    set "QualityLevel" 3
    set "GrowthPotential" 5
    set "FixedSupplyCost" 60
    set "SquaddieTax" 45
    set "Rarity" 5

    set "InitialPerk" "perk.command_rally"
    set "PerkTrees" index=0 "perk_tree.robella"

    set "Slot" asset="robella/slot"
    set "SlotInactive" asset="robella/slot_inactive"
    set "SlotBadge" asset="robella/slot_badge"

    set "BadgeDragged" asset="robella/badge_dragged"
    set "BigBadge" asset="robella/big_badge"
    set "BadgeUnitWindow" asset="robella/badge_unit_window"
    set "BadgeMini" asset="robella/badge_mini"

    set "HiringSelectBarkSound" {
        set "bankId" "wmgfl_tactical_barks_robella_va"
        set "itemId" "Series_Chosen_Auto_Series_Tone_Positive_007"
    }
    set "HiredBarkSound" {
        set "bankId" "wmgfl_tactical_barks_robella_va"
        set "itemId" "Series_Chosen_Series_Tone_Positive_006"
    }
    set "PromotionBarkSounds" index=0 {
        set "PerkTier" 1
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Series_Tone_Positive_001"
        }
    }
    set "PromotionBarkSounds" index=1 {
        set "PerkTier" 2
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Series_Up_002"
        }
    }
    set "PromotionBarkSounds" index=2 {
        set "PerkTier" 3
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Series_Up_004"
        }
    }
    set "PromotionBarkSounds" index=3 {
        set "PerkTier" 4
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Series_Up_005"
        }
    }

    clear "EmotionalStateResponses"
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Eager"
        set "Text" {
            set "m_DefaultTranslation" "Hm. Two used coffee cups on the console... Do we have guests?"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Series_Daily_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Determined"
        set "Text" {
            set "m_DefaultTranslation" "For those we must protect."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Single_Passive_SSR_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Overconfident"
        set "Text" {
            set "m_DefaultTranslation" "Please consider the budget for the next mission rather than my injuries."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Series_Daily_004"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Euphoric"
        set "Text" {
            set "m_DefaultTranslation" "Commander, do you have any plans today? I found a movie on social media that looks interesting. If you'd like, we could go together..."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Single_Friendliness_002"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Hesitant"
        set "Text" {
            set "m_DefaultTranslation" "Wait, isn't that the post I put up on social media? Why do you have this... Just, forget it."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Single_Friendliness_003"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Frustrated"
        set "Text" {
            set "m_DefaultTranslation" "Gotta get better."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Series_Up_002"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Disheartened"
        set "Text" {
            set "m_DefaultTranslation" "Please overlook my blunder in the last engagement. I didn't expect that many Dinergates to show up."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Single_Friendliness_005"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Miserable"
        set "Text" {
            set "m_DefaultTranslation" "The plan was flawed. Sorry, everyone."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_robella_va"
            set "itemId" "Series_Lose_Single_Lose_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "GoodwillTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "AnimosityTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
}
