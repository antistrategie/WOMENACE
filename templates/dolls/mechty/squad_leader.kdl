clone "TagTemplate" from="unique" id="wmgfl_mechty"

clone "SpeakerTemplate" from="sy" id="wmgfl_mechty_speaker" {
    set "Tags" "wmgfl_mechty pirate_sl female infantry waybacker wmgfl_class_ar"
    set "Nickname" {
        set "m_DefaultTranslation" "Mechty"
    }
    set "Forename" {
        set "m_DefaultTranslation" "Mechty"
    }
    set "Surname" {
        set "m_DefaultTranslation" ""
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Name: Mechty (G11)

            Proficiency: Support, Sleeping

            Birth: Unknown

            Age: Classified

            Affiliation(s): H.I.D.E. 404 Team A
            """
    }

    set "BarkImage" asset="mechty/bark"
    set "StandLookLeftImage" asset="mechty/stand_look_left"
    set "StandLookRightImage" asset="mechty/stand_look_right"
    set "StandLookRightInactiveImage" asset="mechty/stand_look_right_inactive"
}

clone "EntityTemplate" from="player_squad.sy" id="player_squad.mechty" {
    append "Tags" "wmgfl_mechty"
    set "Title" {
        set "m_DefaultTranslation" "H.I.D.E. 404 Team A"
    }
    set "Description" {
        set "m_DefaultTranslation" "A doll who approaches everything with peak laziness-except for gaming and reading manga. She's mastered the ultimate skill: falling asleep anytime, anywhere, under any circumstance. Although she seems to embody the philosophy of \"lying flat\" to the extreme, she reveals her dependable side in times of crisis-though in her words, \"It'd be better if we just never ran into any 'crisis' at all...\""
    }

    set "Badge" asset="mechty/badge_mini"
    set "BadgeWhite" asset="mechty/badge_mini"
    clear "Items"
    append "Items" "armor.player_fatigues"
    append "Items" "weapon.mechty"

    set "Scale" {
        set "x" 1.0
        set "y" 1.0
    }
    set "OverrideScaleForSquadLeader" #false
}

clone "UnitLeaderTemplate" from="squad_leader.sy" id="squad_leader.mechty" {
    set "InfantryUnitTemplate" "player_squad.mechty"
    set "SpeakerTemplate" "wmgfl_mechty_speaker"
    set "CustomHead" #null
    set "UnitTitle" {
        set "m_DefaultTranslation" "Tactical Doll"
    }
    set "UnitDescription" {
        set "m_DefaultTranslation" "A doll who approaches everything with peak laziness-except for gaming and reading manga. She's mastered the ultimate skill: falling asleep anytime, anywhere, under any circumstance. Although she seems to embody the philosophy of \"lying flat\" to the extreme, she reveals her dependable side in times of crisis-though in her words, \"It'd be better if we just never ran into any 'crisis' at all...\""
    }

    set "InitialAttributes" index=0 63
    set "InitialAttributes" index=1 90
    set "InitialAttributes" index=2 70
    set "InitialAttributes" index=3 100
    set "InitialAttributes" index=4 100
    set "InitialAttributes" index=5 35
    set "InitialAttributes" index=6 60

    set "QualityLevel" 3
    set "GrowthPotential" 5
    set "FixedSupplyCost" 100
    set "PromotionCostMult" 0.8
    set "SquaddieTax" 25
    set "Rarity" 5

    set "InitialPerk" "perk.mechty_let_me_sleep"
    set "PerkTrees" index=0 "perk_tree.mechty"

    set "Slot" asset="mechty/slot"
    set "SlotInactive" asset="mechty/slot_inactive"
    set "SlotBadge" asset="mechty/slot_badge"

    set "BadgeDragged" asset="mechty/badge_dragged"
    set "BigBadge" asset="mechty/big_badge"
    set "BadgeUnitWindow" asset="mechty/badge_unit_window"
    set "BadgeMini" asset="mechty/badge_mini"

    set "HiringSelectBarkSound" {
        set "bankId" "wmgfl_tactical_barks_mechty_va"
        set "itemId" "Series_Chosen_Series_Tone_Positive_006"
    }
    set "HiredBarkSound" {
        set "bankId" "wmgfl_tactical_barks_mechty_va"
        set "itemId" "Series_Chosen_Auto_Series_Tone_Positive_001"
    }

    set "PromotionBarkSounds" index=0 {
        set "PerkTier" 1
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Series_Up_001"
        }
    }
    set "PromotionBarkSounds" index=1 {
        set "PerkTier" 2
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Series_Up_002"
        }
    }
    set "PromotionBarkSounds" index=2 {
        set "PerkTier" 3
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Series_Up_004"
        }
    }
    set "PromotionBarkSounds" index=3 {
        set "PerkTier" 4
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Series_Up_008"
        }
    }

    clear "EmotionalStateResponses"
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Eager"
        set "Text" {
            set "m_DefaultTranslation" "I'm at my strongest!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Series_Up_008"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Determined"
        set "Text" {
            set "m_DefaultTranslation" "Let's wrap this up quick and head home!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Series_Skill02_Single_Skill_002"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Overconfident"
        set "Text" {
            set "m_DefaultTranslation" "Oh, you’re here, Commander. Perfect timing—I’ll go grab a nap."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Single_Login_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Euphoric"
        set "Text" {
            set "m_DefaultTranslation" "You're not hitting my on-switch, are you? Hearing your voice snaps me wide awake."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Single_Friendliness_013"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Hesitant"
        set "Text" {
            set "m_DefaultTranslation" "You sure you want someone like me?"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Series_Up_003"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Frustrated"
        set "Text" {
            set "m_DefaultTranslation" "Klukai's such a slave driver. If she keeps making me use high-output mode that often, I won't last."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Series_Daily_003"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Disheartened"
        set "Text" {
            set "m_DefaultTranslation" "Battery's dead. Let's fall back for now. Next time, for sure."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_mechty_va"
            set "itemId" "Series_Lose_Single_Lose_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Miserable"
        set "Text" {
            set "m_DefaultTranslation" "..."
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "GoodwillTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "AnimosityTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
}
