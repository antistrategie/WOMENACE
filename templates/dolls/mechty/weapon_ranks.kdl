clone "CommodityTemplate" from="commodity.construct_weapon_parts" id="commodity.wmgfl_component_mechty" {
    set "Title" {
        set "m_DefaultTranslation" "G11 Component"
    }
    set "Description" {
        set "m_DefaultTranslation" "Weapon component for the G11."
    }
    append "Tags" "jy_no_sell"
    set "Icon" asset="weapon/mechty/Icon"
    set "Rarity" 0
    set "TradeValue" 0
    set "BlackMarketMaxQuantity" 0
    set "MinCampaignProgress" 0
}

clone "BlueprintTemplate" from="blueprint.squad_weapon_electro_magnetic_enhanced_assault_rifle" id="blueprint.wmgfl_mechty_duplicate" {
    set "m_CraftingResult" "weapon.mechty"
    clear "m_CraftingMaterials"
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_ar_barrel"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_ar_receiver"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_ar_grip"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_ar_sights"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_component_mechty"
        set "Count" 1
    }
}
