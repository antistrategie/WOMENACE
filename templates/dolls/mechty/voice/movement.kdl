clone "ConversationTemplate" from="JeanSy/moving_finished" id="Mechty/moving_finished" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_mechty"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_mechty_va"
                        set "itemId" "Series_Set_Click_Series_Tone_Positive_002"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Yeah, yeah."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

clone "ConversationTemplate" from="JeanSy/taking_fire" id="Mechty/taking_fire" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_mechty"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_mechty_va"
                        set "itemId" "Series_Hitted_Series_Shield_Broken"
                    }
                    set "RoleGuid" "Damaged"
                    set "Text" "Ah!"
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}
