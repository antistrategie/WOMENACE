clone "PerkTemplate" from="perk.steady_gun" id="perk.asteria_bond" {
    set "Title" {
        set "m_DefaultTranslation" "Bond Connextion"
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "Select a friendly squad and give them a buff."
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Always there for a friend in need.

            <style="Highlight">• Grants the skill 'Bond Connextion'. Asteria bonds with a friendly squad and that squad deals $1% more damage for the rest of the battle.</style>
            <style="Highlight">• The bond holds a single charge per mission.</style>
            """
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.asteria_bond" path="EventHandlers[0].AmountMult" format="bonus-percent"
    }

    set "Icon" asset="asteria/perks/bond"
    set "IconDisabled" asset="asteria/perks/bond_inactive"
    set "PerkIcon" asset="asteria/perks/bond"

    clear "EventHandlers"
    append "EventHandlers" type="AddSkill" {
        set "Event" enum="AddEvent" "OnMissionStart"
        set "SkillToAdd" "active.asteria_bond_connextion"
    }
    // The charge. Using a skill tagged asteria_bond makes Asteria use the spend skill on herself,
    // which plants the spent marker, and the bond skill greys while she carries it. The perk hosts
    // this rather than the bond skill because AddSkill on the bond skill lands on the bonded ally,
    // and `Uses 1` on the skill is no gate at all: the engine re-derives uses from the template at
    // every turn boundary.
    append "EventHandlers" type="ApplySkillToSelf" {
        set "SkillToApply" "active.asteria_bond_spend"
        set "Event" enum="ApplyOnEvent" "OnSkillWithTagsUsed"
        append "RequiredTags" "asteria_bond"
        set "RequiredLogic" enum="LogicType" "Or"
        set "ChanceToApply" 100
    }
}

clone "TagTemplate" from="unique" id="asteria_bond"

// What ApplySkillToSelf fires. It does not add SkillToApply to the actor: it creates an instance
// and uses it on the owner's tile, free and without a usability check, so a bare status effect
// there does nothing. A hidden self-use active whose own AddSkill lands the marker is the shape
// vanilla uses (damage_effect.powerlines_damaged.active, active.emp_discharge_small).
clone "SkillTemplate" from="active.special.lucky_shot" id="active.asteria_bond_spend" {
    set "Title" {
        set "m_DefaultTranslation" "Bond Spent"
    }
    set "Description" {
        set "m_DefaultTranslation" "Asteria has bonded with a squad this mission."
    }
    set "IsHidden" #true
    set "ActionPointCost" 0
    set "IsLimitedUses" #false
    set "IsRemovedAfterCombat" #true
    // Used on the owner's own tile, so it reaches no further than that.
    set "MaxRange" 0
    set "AoEType" enum="SkillAoEType" "CenterOnly"
    clear "EventHandlers"
    append "EventHandlers" type="AddSkill" {
        set "Event" enum="AddEvent" "OnUse"
        set "SkillToAdd" "effect.asteria_bond_spent"
    }
}

// Marks the bond as spent for the rest of the mission. A hidden status effect on Asteria
// herself, so it survives every resync and a mid-mission save, and the engine drops it after
// combat like any other effect.
clone "SkillTemplate" from="effect.reduced_ap_after_transport" id="effect.asteria_bond_spent" {
    set "Title" {
        set "m_DefaultTranslation" "Bond Spent"
    }
    set "Description" {
        set "m_DefaultTranslation" "Asteria has bonded with a squad this mission."
    }
    clear "EventHandlers"
}

clone "SkillTemplate" from="offmap.shield_projector" id="active.asteria_bond_connextion" {
    set "Title" {
        set "m_DefaultTranslation" "Bond Connextion"
    }
    set "Description" {
        set "m_DefaultTranslation" "Bond with a friendly squad. That squad deals $1% more damage for the rest of the battle."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.asteria_bond" path="EventHandlers[0].AmountMult" format="bonus-percent"
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "Bonds with a friendly squad, raising its damage by $1% for the rest of the battle."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.asteria_bond" path="EventHandlers[0].AmountMult" format="bonus-percent"
    }
    set "Icon" asset="asteria/skills/bond_connextion"
    set "IconDisabled" asset="asteria/skills/bond_connextion_disabled"
    set "TargetsAllowed" enum="SkillTarget" "AlliedActor"
    set "ActionPointCost" 10
    set "HideApCosts" #false
    set "ExecutingElement" enum="ExecutingElementType" "SpecialOnly"
    // No use counter. The charge is the spent marker, and a counter the engine refills each
    // turn would disagree with it on the tile.
    set "IsLimitedUses" #false
    set "IsStacking" #false
    set "IsRemovedAfterCombat" #true
    append "Tags" "asteria_bond"
    clear "EventHandlers"
    append "EventHandlers" type="AddSkill" {
        set "Event" enum="AddEvent" "OnUse"
        set "SkillToAdd" "effect.asteria_bond"
        set "ShowHUDText" #true
    }
    append "EventHandlers" type="LimitUsability" {
        append "NotUsableIfActorHasSkill" "effect.asteria_bond_spent"
    }
}

clone "SkillTemplate" from="effect.bleeding" id="effect.asteria_bond" {
    set "Icon" asset="asteria/effects/bond"
    set "Title" {
        set "m_DefaultTranslation" "Bond"
    }
    set "Description" {
        set "m_DefaultTranslation" "Asteria is bonded with this squad. Damage dealt increased by $1%."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.asteria_bond" path="EventHandlers[0].AmountMult" format="bonus-percent"
    }
    clear "EventHandlers"
    append "EventHandlers" type="ChangeProperty" {
        set "Trigger" enum="UpdateEvent" "OnUpdate"
        set "PropertyType" enum="EntityPropertyType" "DamageMult"
        set "Amount" 0
        set "AmountMult" 1.15
    }
    append "EventHandlers" type="DisplayText" {
        set "Event" enum="DisplayEvent" "OnAdded"
        set "LocaKey" "asteria_bond"
        set "DefaultText" "Bonded!"
    }
}
