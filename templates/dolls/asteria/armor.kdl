clone "ArmorTemplate" from="armor.player_fatigues" id="armor.asteria_default" {
    set "DeployCosts" {
        set "m_Supplies" 0
    }
    set "Title" {
        set "m_DefaultTranslation" "Seeker"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Field Outfit"
    }
    set "Description" {
        set "m_DefaultTranslation" "Asteria in her usual outfit. It blends past and present, much like how she seeks her own path while remaining true to herself."
    }
    set "Icon" asset="asteria/armor/default/Icon"
    set "IconEquipment" asset="asteria/armor/default/IconEquipment"
    set "IconSkillBar" asset="asteria/armor/default/IconSkillBar"
    set "SquadLeaderMode" enum="SquadLeaderModelMode" "SameAsOthers"
    append "OnlyEquipableBy" "wmgfl_transmog"
    append "Tags" "jy_no_sell"
}
