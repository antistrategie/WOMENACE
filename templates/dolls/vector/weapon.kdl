clone "WeaponTemplate" from="weapon.generic_smg_tier1_ppp" id="weapon.vector" {
    append "Tags" "jy_no_sell"
    set "Title" {
        set "m_DefaultTranslation" "Ksvec .45 ACP"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "SMG"
    }
    set "Description" {
        set "m_DefaultTranslation" "A firearm highly compatible with Vector. Modified based on her combat preferences, it is highly maneuverable and stable."
    }
    set "Model" asset="weapon/vector/main"
    set "SkillsGranted" index=0 "active.fire_vector_kriss"
    set "SkillsGranted" index=1 "active.fire_vector_kriss_tap"
    set "Icon" asset="weapon/vector/Icon"
    set "IconEquipment" asset="weapon/vector/IconEquipment"
    set "IconEquipmentDisabled" asset="weapon/vector/IconEquipmentDisabled"
    set "IconSkillBar" asset="weapon/vector/IconSkillBar"
    set "IconSkillBarDisabled" asset="weapon/vector/IconSkillBarDisabled"

    set "AccuracyDropoff" -6.0
    set "ArmorPenetration" 12.0
    set "ArmorPenetrationDropoff" -2.4

    set "Damage" 14.0
    set "DamageDropoff" -1.2
    set "DamageToArmorDurability" 10.0
    set "DamageToArmorDurabilityDropoff" -1.35

    set "MaxRange" 4
    set "IdealRange" 2
    set "Suppression" 4.0

    set "DeployCosts" {
        set "m_Supplies" 13
    }

    set "BlackMarketMaxQuantity" 0
}

clone "SkillTemplate" from="active.fire_smg_tier1_burst" id="active.fire_vector_kriss" {
    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_burst"
    }
    append "SoundsOnAttack" {
        set "bankId" "weapons_soundbank"
        set "itemId" "small_caliber_brass_burst"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_burst_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_burst_distant"
    }
    set "Repetitions" 7
    set "RepetitionDelay" 0.15
}

clone "SkillTemplate" from="active.fire_smg_tier_1_tap_fire" id="active.fire_vector_kriss_tap" {
    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_single"
    }
    append "SoundsOnAttack" {
        set "bankId" "weapons_soundbank"
        set "itemId" "small_caliber_brass_burst"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_single_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_single_distant"
    }
    set "MaxRange" 6
}

// SSR weapon
clone "WeaponTemplate" from="specialweapon.infantry_automatic_rifle_tier2" id="weapon.vector_ssr" {
    append "Tags" "jy_no_sell"
    set "Title" {
        set "m_DefaultTranslation" "Banshee's Whisper"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "SMG"
    }
    set "Description" {
        set "m_DefaultTranslation" "A high-performance submachine gun assigned to Vector. Based on the Ksvec .45 ACP, it has been completely overhauled. Pull the trigger, and let death whisper a song into the ears of enemies."
    }

    set "Model" asset="weapon/vector_ssr/main"
    set "Icon" asset="weapon/vector_ssr/Icon"
    set "IconEquipment" asset="weapon/vector_ssr/IconEquipment"
    set "IconEquipmentDisabled" asset="weapon/vector_ssr/IconEquipmentDisabled"
    set "IconSkillBar" asset="weapon/vector_ssr/IconSkillBar"
    set "IconSkillBarDisabled" asset="weapon/vector_ssr/IconSkillBarDisabled"

    set "AccuracyBonus" 5.0
    set "AccuracyDropoff" -6.0
    set "ArmorPenetration" 20.0
    set "ArmorPenetrationDropoff" -2.0

    set "Damage" 16.0
    set "DamageDropoff" -1.2
    set "DamageToArmorDurability" 12.0
    set "DamageToArmorDurabilityDropoff" -1.2

    set "MaxRange" 5
    set "IdealRange" 2
    set "Suppression" 20.0
    set "DeployCosts" {
        set "m_Supplies" 30
    }

    set "BlackMarketMaxQuantity" 0

    clear "SkillsGranted"
    append "SkillsGranted" "active.vector_ssr_meltdown"
    append "SkillsGranted" "active.vector_ssr_searing"
}

clone "SkillTemplate" from="active.fire_automatic_rifle" id="active.vector_ssr_meltdown" {
    set "Title" {
        set "m_DefaultTranslation" "Dead End Meltdown"
    }
    set "Description" {
        set "m_DefaultTranslation" "Sprays incendiary rounds that build <link=\"wmgfl_burn\">Burn</link>. Deals 20% more damage to Burning targets."
    }
    set "MaxRange" 5
    set "Repetitions" 7
    set "RepetitionDelay" 0.15
    set "Uses" 16

    append "EventHandlers" type="SynchronizeItemUses" {}

    append "EventHandlers" type="WOMENACE:ElementalDamage" {
        set "Element" "Burn"
        set "AmountPerHit" 4.0
    }
    // Vector's imprint: her own hits apply Overburn to the victim (owner-gated in code)
    append "EventHandlers" type="WOMENACE:OverburnOnHit" {}

    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_burst"
    }
    append "SoundsOnAttack" {
        set "bankId" "weapons_soundbank"
        set "itemId" "small_caliber_brass_burst"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_burst_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_burst_distant"
    }
}

clone "SkillTemplate" from="active.light_mg_suppressive_fire" id="active.vector_ssr_searing" {
    set "Title" {
        set "m_DefaultTranslation" "Searing Finale"
    }
    set "Description" {
        set "m_DefaultTranslation" "Sprays incendiary rounds across 5 contiguous tiles, setting them on fire and building <link=\"wmgfl_burn\">Burn</link>. Deals high suppression and 20% more damage to Burning targets."
    }

    set "AoEType" enum="SkillAoEType" "SelectTilesOnUse"
    set "IsSoundOnAttackPerElementPlayingAfterAnimationDelay" #true
    set "ScatterMode" enum="ScatterMode" "Strafing"

    set "ActionPointCost" 80
    set "MaxRange" 5
    set "IdealRange" 2
    set "Repetitions" 20
    set "RepetitionDelay" 0.15

    set "SelectableTiles" 5
    set "Uses" 16

    set "EventHandlers" index=0 {
        set "AccuracyMult" 0.75
        set "SuppressionDealtMult" 1.5
    }

    insert "EventHandlers" index=0 type="SpawnTileEffect" {
        set "EffectToSpawn" "tile_effect.fire"
        set "ChanceAtCenter" 100
        set "ChancePerTileFromCenter" 0
    }

    insert "EventHandlers" index=2 type="ClearTileEffectGroup" {
        set "EffectsToClear" "tile_effects_mines"
        set "TriggerEffect" #true
    }

    append "EventHandlers" type="SynchronizeItemUses" {}

    append "EventHandlers" type="AttackProc" {
        set "SkillToAdd" "effect.wmgfl_burn"
        set "Chance" 100
    }

    // Vector's imprint: her own hits apply Overburn to the victim (owner-gated in code)
    append "EventHandlers" type="WOMENACE:OverburnOnHit" {}

    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_burst"
    }
    append "SoundsOnAttack" {
        set "bankId" "weapons_soundbank"
        set "itemId" "small_caliber_brass_burst"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_burst_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_smg_addition_bank"
        set "itemId" "smg_burst_distant"
    }
}

clone "SkillTemplate" from="effect.bleeding" id="effect.wmgfl_overburn" {
    set "Icon" asset="vector/ssr/overburn"
    set "Title" {
        set "m_DefaultTranslation" "Overburn"
    }
    set "Description" {
        set "m_DefaultTranslation" "If the target dies while <link=\"wmgfl_burn\">Burning</link>, the fire and Overburn spread to the healthiest enemy within 2 tiles that is not already Burning. If all of them are, Overburn alone jumps to the healthiest. Lasts as long as the Burn does."
    }
    clear "EventHandlers"
    append "EventHandlers" type="DisplayText" {
        set "Event" enum="DisplayEvent" "OnAdded"
        set "LocaKey" "wmgfl_overburn"
        set "DefaultText" "Overburn!"
    }
    // keeps the bearer's death position fresh for the spread (the engine
    // unlinks a dying actor from its tile before the death event fires) and
    // removes Overburn the moment the bearer stops Burning
    append "EventHandlers" type="WOMENACE:OverburnTracker" {}
}
