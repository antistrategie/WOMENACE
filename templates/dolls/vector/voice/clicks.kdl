clone "ConversationTemplate" from="JeanSy/click_bark" id="Vector/click_bark" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_vector"
        }
    }
    set "Priority" 100
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="ACTION" {
            set "m_SerAction" type="SetFlag" {
                set "FlagName" "click_bark_vector"
                set "FlagValue" #true
            }
        }
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_vector_va"
                        set "itemId" "Series_Set_Click_Series_Up_004"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Don't say I didn't warn you."
                }
            }
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_vector_va"
                        set "itemId" "Series_Chosen_Series_Tone_Positive_003"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Roger."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

