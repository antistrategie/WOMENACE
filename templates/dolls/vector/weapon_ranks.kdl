    set "Damage" 15.5
    set "ArmorPenetration" 13.0
    set "DamageToArmorDurability" 11.0
}

clone "WeaponTemplate" from="weapon.vector" id="weapon.vector_r3" {
    set "Damage" 17.0
    set "ArmorPenetration" 14.0
    set "DamageToArmorDurability" 12.0
}

clone "WeaponTemplate" from="weapon.vector" id="weapon.vector_r4" {
    set "Damage" 18.5
    set "ArmorPenetration" 16.0
    set "DamageToArmorDurability" 13.0
}

clone "WeaponTemplate" from="weapon.vector" id="weapon.vector_r5" {
    set "Damage" 20.0
    set "ArmorPenetration" 18.0
    set "DamageToArmorDurability" 14.0
