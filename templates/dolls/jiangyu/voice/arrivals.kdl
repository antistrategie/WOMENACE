clone "ConversationTemplate" from="Carda_Early/arrival_carda" id="Jiangyu/arrival_jiangyu" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_jiangyu"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_jiangyu_va"
                        set "itemId" "Single_Login_001"
                    }
                    set "RoleGuid" "Carda"
                    set "Text" "Well, hello there, Commander. Feeling energetic today? I sure do too!"
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}
