clone "TagTemplate" from="unique" id="wmgfl_jiangyu"

clone "SpeakerTemplate" from="carda" id="wmgfl_jiangyu_speaker" {
    set "Tags" "wmgfl_jiangyu female infantry waybacker wmgfl_class_ar"
    set "Nickname" {
        set "m_DefaultTranslation" "Jiangyu"
    }
    set "Forename" {
        set "m_DefaultTranslation" "Jiangyu"
    }
    set "Surname" {
        set "m_DefaultTranslation" ""
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Name: Jiangyu (Type 97)

            Proficiency: Mobility & Assist

            Birth: Unknown

            Age: Classified

            Affiliation(s): Monsoon Squad
            """
    }

    set "BarkImage" asset="jiangyu/bark"
    set "StandLookLeftImage" asset="jiangyu/stand_look_left"
    set "StandLookRightImage" asset="jiangyu/stand_look_right"
    set "StandLookRightInactiveImage" asset="jiangyu/stand_look_right_inactive"
}

clone "EntityTemplate" from="player_squad.carda" id="player_squad.jiangyu" {
    append "Tags" "wmgfl_jiangyu"
    set "Title" {
        set "m_DefaultTranslation" "Monsoon Squad"
    }
    set "Description" {
        set "m_DefaultTranslation" "A lively and enthusiastic Doll who follows in her older sister's footsteps with a carefree spirit. She roams the lands with her bandmates, bringing fresh and fiery notes to \"Monsoon\"."
    }

    set "Badge" asset="jiangyu/badge_mini"
    set "BadgeWhite" asset="jiangyu/badge_mini"
    clear "Items"
    append "Items" "armor.player_fatigues"
    append "Items" "weapon.jiangyu"
}

clone "UnitLeaderTemplate" from="squad_leader.carda" id="squad_leader.jiangyu" {
    set "InfantryUnitTemplate" "player_squad.jiangyu"
    set "SpeakerTemplate" "wmgfl_jiangyu_speaker"
    set "CustomHead" #null
    set "UnitTitle" {
        set "m_DefaultTranslation" "Tactical Doll"
    }
    set "UnitDescription" {
        set "m_DefaultTranslation" "A lively and enthusiastic Doll who follows in her older sister's footsteps with a carefree spirit. She roams the lands with her bandmates, bringing fresh and fiery notes to \"Monsoon\"."
    }

    set "InitialAttributes" index=0 100
    set "InitialAttributes" index=1 70
    set "InitialAttributes" index=2 85
    set "InitialAttributes" index=3 100
    set "InitialAttributes" index=4 100
    set "InitialAttributes" index=5 20
    set "InitialAttributes" index=6 100

    set "QualityLevel" 3
    set "GrowthPotential" 5
    set "FixedSupplyCost" 60
    set "SquaddieTax" 45
    set "Rarity" 5

    set "InitialPerk" "perk.athletic"
    set "PerkTrees" index=0 "perk_tree.jiangyu"

    set "Slot" asset="jiangyu/slot"
    set "SlotInactive" asset="jiangyu/slot_inactive"
    set "SlotBadge" asset="jiangyu/slot_badge"

    set "BadgeDragged" asset="jiangyu/badge_dragged"
    set "BigBadge" asset="jiangyu/big_badge"
    set "BadgeUnitWindow" asset="jiangyu/badge_unit_window"
    set "BadgeMini" asset="jiangyu/badge_mini"

    set "HiringSelectBarkSound" {
        set "bankId" "wmgfl_tactical_barks_jiangyu_va"
        set "itemId" "Series_Chosen_Auto_Series_Up_006"
    }
    set "HiredBarkSound" {
        set "bankId" "wmgfl_tactical_barks_jiangyu_va"
        set "itemId" "Series_Chosen_Single_Passive_SSR_001"
    }
    set "PromotionBarkSounds" index=0 {
        set "PerkTier" 1
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Series_Tone_Positive_001"
        }
    }
    set "PromotionBarkSounds" index=1 {
        set "PerkTier" 2
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Series_Up_002"
        }
    }
    set "PromotionBarkSounds" index=2 {
        set "PerkTier" 3
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Series_Up_004"
        }
    }
    set "PromotionBarkSounds" index=3 {
        set "PerkTier" 4
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Series_Up_005"
        }
    }

    clear "EmotionalStateResponses"
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Eager"
        set "Text" {
            set "m_DefaultTranslation" "Commander, give me more opportunities to shine. I'll behave and listen to Leader Groza's orders!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Series_Daily_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Determined"
        set "Text" {
            set "m_DefaultTranslation" "Heh! You can't hit me!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Series_Chosen_Single_Passive_SSR_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Overconfident"
        set "Text" {
            set "m_DefaultTranslation" "Lately, doesn't everyone seem so stressed and unhappy? Hehe, it's my turn to lighten the mood!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Series_Daily_004"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Euphoric"
        set "Text" {
            set "m_DefaultTranslation" "I wasn't slacking today--I was mapping out the Elmo's entire layout."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Single_Friendliness_002"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Hesitant"
        set "Text" {
            set "m_DefaultTranslation" "If there's nothing else, I'm heading back. I promised my sister I'd be online for band practice."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Single_Friendliness_003"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Frustrated"
        set "Text" {
            set "m_DefaultTranslation" "Aw, don't pat my head, I'm not a kid..."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Single_Friendliness_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Disheartened"
        set "Text" {
            set "m_DefaultTranslation" "Urgh... Commander, do you have any tricks to increase income? The band hasn't been doing too well recently and I'd like to help out too."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Single_Friendliness_005"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Miserable"
        set "Text" {
            set "m_DefaultTranslation" "Oh no, oh no... I've made another rookie mistake. Big Sis is definitely going to lecture me when I get back!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_jiangyu_va"
            set "itemId" "Series_Lose_Single_Lose_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "GoodwillTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "AnimosityTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
}
