clone "TagTemplate" from="unique" id="wmgfl_soppo"

clone "SpeakerTemplate" from="sy" id="wmgfl_soppo_speaker" {
    set "Tags" "wmgfl_soppo pirate_sl female infantry waybacker wmgfl_class_ar"
    set "Nickname" {
        set "m_DefaultTranslation" "Soppo"
    }
    set "Forename" {
        set "m_DefaultTranslation" "Soppo"
    }
    set "Surname" {
        set "m_DefaultTranslation" ""
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Name: Soppo (M4 SOPMOD II)

            Proficiency: AoE Damage & Agile Combat

            Birth: Unknown

            Age: Classified

            Affiliation(s): AR Team
            """
    }

    set "BarkImage" asset="soppo/bark"
    set "StandLookLeftImage" asset="soppo/stand_look_left"
    set "StandLookRightImage" asset="soppo/stand_look_right"
    set "StandLookRightInactiveImage" asset="soppo/stand_look_right_inactive"
}

clone "EntityTemplate" from="player_squad.sy" id="player_squad.soppo" {
    append "Tags" "wmgfl_soppo"
    set "Title" {
        set "m_DefaultTranslation" "AR Team"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            A lively and energetic T-Doll who loves battle. She's simple-minded, prefers straightforward actions, rarely engages in deep thinking, and unconditionally trusts her teammates, obeying all your orders.
            "Commander, what do we do next? Haven't decided? Well… how about we go have some fun—"
            """
    }

    set "Badge" asset="soppo/badge_mini"
    set "BadgeWhite" asset="soppo/badge_mini"
    clear "Items"
    append "Items" "armor.player_fatigues"
    append "Items" "weapon.soppo"

    set "Scale" {
        set "x" 1.0
        set "y" 1.0
    }
    set "OverrideScaleForSquadLeader" #false
}

clone "UnitLeaderTemplate" from="squad_leader.sy" id="squad_leader.soppo" {
    set "InfantryUnitTemplate" "player_squad.soppo"
    set "SpeakerTemplate" "wmgfl_soppo_speaker"
    set "CustomHead" #null
    set "UnitTitle" {
        set "m_DefaultTranslation" "Tactical Doll"
    }
    set "UnitDescription" {
        set "m_DefaultTranslation" """
            A lively and energetic T-Doll who loves battle. She's simple-minded, prefers straightforward actions, rarely engages in deep thinking, and unconditionally trusts her teammates, obeying all your orders.
            "Commander, what do we do next? Haven't decided? Well… how about we go have some fun—"
            """
    }

    set "InitialAttributes" index=0 88
    set "InitialAttributes" index=1 80
    set "InitialAttributes" index=2 90
    set "InitialAttributes" index=3 100
    set "InitialAttributes" index=4 100
    set "InitialAttributes" index=5 35
    set "InitialAttributes" index=6 60

    set "QualityLevel" 3
    set "GrowthPotential" 5
    set "FixedSupplyCost" 100
    set "PromotionCostMult" 0.8
    set "SquaddieTax" 25
    set "Rarity" 5

    set "InitialPerk" "perk.spear_of_the_spine_weiwu"
    set "PerkTrees" index=0 "perk_tree.soppo"

    set "Slot" asset="soppo/slot"
    set "SlotInactive" asset="soppo/slot_inactive"
    set "SlotBadge" asset="soppo/slot_badge"

    set "BadgeDragged" asset="soppo/badge_dragged"
    set "BigBadge" asset="soppo/big_badge"
    set "BadgeUnitWindow" asset="soppo/badge_unit_window"
    set "BadgeMini" asset="soppo/badge_mini"

    set "HiringSelectBarkSound" {
        set "bankId" "wmgfl_tactical_barks_soppo_va"
        set "itemId" "Series_Chosen_Series_Tone_Positive_006"
    }
    set "HiredBarkSound" {
        set "bankId" "wmgfl_tactical_barks_soppo_va"
        set "itemId" "Series_Chosen_Auto_Series_Tone_Positive_007"
    }

    set "PromotionBarkSounds" index=0 {
        set "PerkTier" 1
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Series_Up_001"
        }
    }
    set "PromotionBarkSounds" index=1 {
        set "PerkTier" 2
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Series_Up_002"
        }
    }
    set "PromotionBarkSounds" index=2 {
        set "PerkTier" 3
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Series_Up_003"
        }
    }
    set "PromotionBarkSounds" index=3 {
        set "PerkTier" 4
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Series_Up_004"
        }
    }

    clear "EmotionalStateResponses"
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Eager"
        set "Text" {
            set "m_DefaultTranslation" "Commander, let’s go hunting."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Single_Login_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Determined"
        set "Text" {
            set "m_DefaultTranslation" "I'm gonna smash it all!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Series_Up_004"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Overconfident"
        set "Text" {
            set "m_DefaultTranslation" "Even if you beg on your knees, I won’t forgive you."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Series_Win_Single_Win_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Euphoric"
        set "Text" {
            set "m_DefaultTranslation" "Alright—test this! Still remember me?"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Single_Obtain_SSR_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Hesitant"
        set "Text" {
            set "m_DefaultTranslation" "Am I up?"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Series_Tone_Positive_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Frustrated"
        set "Text" {
            set "m_DefaultTranslation" "(Pbbbbt!)"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Series_Up_002"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Disheartened"
        set "Text" {
            set "m_DefaultTranslation" "No time—no time! Commander, can we hurry up?"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_soppo_va"
            set "itemId" "Series_Lose_Single_Lose_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Miserable"
        set "Text" {
            set "m_DefaultTranslation" "..."
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "GoodwillTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "AnimosityTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
}
