clone "ConversationTemplate" from="JeanSy/moving_finished" id="Soppo/moving_finished" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_soppo"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_soppo_va"
                        set "itemId" "Series_Tone_Positive_001"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Am I up?"
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

clone "ConversationTemplate" from="JeanSy/taking_fire" id="Soppo/taking_fire" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_soppo"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_soppo_va"
                        set "itemId" "Series_Hitted"
                    }
                    set "RoleGuid" "Damaged"
                    set "Text" "(Ah!)"
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}
