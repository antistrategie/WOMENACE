clone "CommodityTemplate" from="commodity.construct_weapon_parts" id="commodity.wmgfl_component_soppo_ssr" {
    set "Title" {
        set "m_DefaultTranslation" "Skysunderer's Howl Component"
    }
    set "Description" {
        set "m_DefaultTranslation" "[PLACEHOLDER] Weapon component for Skysunderer's Howl"
    }
    append "Tags" "jy_no_sell"
    set "Icon" asset="weapon/soppo_ssr/Icon"
    set "Rarity" 0
    set "TradeValue" 0
    set "BlackMarketMaxQuantity" 0
    set "MinCampaignProgress" 0
}

clone "BlueprintTemplate" from="blueprint.squad_weapon_electro_magnetic_enhanced_assault_rifle" id="blueprint.wmgfl_soppo_ssr_duplicate" {
    set "m_CraftingResult" "weapon.soppo_ssr"
    clear "m_CraftingMaterials"
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_component_soppo_ssr"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.construct_weapon_parts"
        set "Count" 4
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.construct_cybernetic_optics"
        set "Count" 2
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.construct_advanced_alloys"
        set "Count" 2
    }
}
