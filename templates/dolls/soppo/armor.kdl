clone "ArmorTemplate" from="armor.player_fatigues" id="armor.soppo_default" {
    set "DeployCosts" {
        set "m_Supplies" 0
    }
    set "Title" {
        set "m_DefaultTranslation" "Rimestorm"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Combat Gear"
    }
    set "Description" {
        set "m_DefaultTranslation" "Soppo in her usual outfit. Its airy design can't hide her burning passion. She's long since decided to carve a path to the future with you."
    }
    set "Icon" asset="soppo/armor/default/Icon"
    set "IconEquipment" asset="soppo/armor/default/IconEquipment"
    set "IconSkillBar" asset="soppo/armor/default/IconSkillBar"
    set "SquadLeaderMode" enum="SquadLeaderModelMode" "SameAsOthers"
    append "OnlyEquipableBy" "wmgfl_transmog"
    append "Tags" "jy_no_sell"
}

clone "ArmorTemplate" from="armor.player_fatigues" id="armor.soppo_redline" {
    set "DeployCosts" {
        set "m_Supplies" 0
    }
    set "Title" {
        set "m_DefaultTranslation" "Redline Racer"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Racing Suit"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            "Commander! If you don't get on, I'm going to head out without you!"
            The engine roar sets your heart ablaze and drags your thoughts back to reality. She radiates waves of tangible heat, her cute little fang glittering in the sunlight. Your saftey belt's buckled; are you read to rampage across the course with Soppo?
            """
    }
    set "Icon" asset="soppo/armor/redline/Icon"
    set "IconEquipment" asset="soppo/armor/redline/IconEquipment"
    set "IconSkillBar" asset="soppo/armor/redline/IconSkillBar"
    set "SquadLeaderMode" enum="SquadLeaderModelMode" "SameAsOthers"
    append "OnlyEquipableBy" "wmgfl_transmog"
    append "Tags" "jy_no_sell"
}
