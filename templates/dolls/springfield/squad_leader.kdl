clone "TagTemplate" from="unique" id="wmgfl_springfield"

clone "SpeakerTemplate" from="carda" id="wmgfl_springfield_speaker" {
    set "Tags" "wmgfl_springfield female infantry waybacker wmgfl_class_rifle"
    set "Nickname" {
        set "m_DefaultTranslation" "Springfield"
    }
    set "Forename" {
        set "m_DefaultTranslation" "Springfield"
    }
    set "Surname" {
        set "m_DefaultTranslation" ""
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Name: Springfield (M1903)

            Proficiency: Support & Marksmanship

            Birth: Unknown

            Age: Classified

            Affiliation(s): Zucchero Café
            """
    }

    set "BarkImage" asset="springfield/bark"
    set "StandLookLeftImage" asset="springfield/stand_look_left"
    set "StandLookRightImage" asset="springfield/stand_look_right"
    set "StandLookRightInactiveImage" asset="springfield/stand_look_right_inactive"
}

clone "EntityTemplate" from="player_squad.carda" id="player_squad.springfield" {
    append "Tags" "wmgfl_springfield"
    set "Title" {
        set "m_DefaultTranslation" "Zucchero Café"
    }
    set "Description" {
        set "m_DefaultTranslation" "Gentle, strong, and understanding of others, she is a tactful and witty Doll who mingles well with different groups of people without allowing anyone to take advantage of her. Behind her tolerance lies an adherence to principles, that being Springfield's one and only principle—She shall always protect her friends and those who are important to her."
    }

    set "Badge" asset="springfield/badge_mini"
    set "BadgeWhite" asset="springfield/badge_mini"
    clear "Items"
    append "Items" "armor.player_fatigues"
    append "Items" "weapon.springfield"
}

clone "UnitLeaderTemplate" from="squad_leader.carda" id="squad_leader.springfield" {
    set "InfantryUnitTemplate" "player_squad.springfield"
    set "SpeakerTemplate" "wmgfl_springfield_speaker"
    set "CustomHead" #null
    set "UnitTitle" {
        set "m_DefaultTranslation" "Tactical Doll"
    }
    set "UnitDescription" {
        set "m_DefaultTranslation" "Gentle, strong, and understanding of others, she is a tactful and witty Doll who mingles well with different groups of people without allowing anyone to take advantage of her. Behind her tolerance lies an adherence to principles, that being Springfield's one and only principle—She shall always protect her friends and those who are important to her."
    }

    set "InitialAttributes" index=0 75
    set "InitialAttributes" index=1 75
    set "InitialAttributes" index=2 90
    set "InitialAttributes" index=3 100
    set "InitialAttributes" index=4 100
    set "InitialAttributes" index=5 30
    set "InitialAttributes" index=6 60

    set "QualityLevel" 3
    set "GrowthPotential" 5
    set "FixedSupplyCost" 60
    set "SquaddieTax" 45
    set "Rarity" 5

    set "InitialPerk" "perk.first_aid"
    set "PerkTrees" index=0 "perk_tree.springfield"

    set "Slot" asset="springfield/slot"
    set "SlotInactive" asset="springfield/slot_inactive"
    set "SlotBadge" asset="springfield/slot_badge"

    set "BadgeDragged" asset="springfield/badge_dragged"
    set "BigBadge" asset="springfield/big_badge"
    set "BadgeUnitWindow" asset="springfield/badge_unit_window"
    set "BadgeMini" asset="springfield/badge_mini"

    set "HiringSelectBarkSound" {
        set "bankId" "wmgfl_tactical_barks_springfield_va"
        set "itemId" "Series_Chosen_Series_Tone_Positive_010"
    }
    set "HiredBarkSound" {
        set "bankId" "wmgfl_tactical_barks_springfield_va"
        set "itemId" "Series_Chosen_Auto_Series_Tone_Positive_002"
    }
    set "PromotionBarkSounds" index=0 {
        set "PerkTier" 1
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Series_Up_001"
        }
    }
    set "PromotionBarkSounds" index=1 {
        set "PerkTier" 2
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Series_Up_002"
        }
    }
    set "PromotionBarkSounds" index=2 {
        set "PerkTier" 3
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Series_Up_004"
        }
    }
    set "PromotionBarkSounds" index=3 {
        set "PerkTier" 4
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Series_Up_005"
        }
    }

    clear "EmotionalStateResponses"
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Eager"
        set "Text" {
            set "m_DefaultTranslation" "Oh, Commander, I'm working on a new cake for the menu—could I get your opinion?"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Series_Daily_006"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Determined"
        set "Text" {
            set "m_DefaultTranslation" "We take on all kinds of jobs here at Zucchero, so if you're busy, please don't hesitate to ask me."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Single_Friendliness_003"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Overconfident"
        set "Text" {
            set "m_DefaultTranslation" "The most important part of blending is gauging how well the beans suit each other. By that measure, we're the perfect blend."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Single_Friendliness_009"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Euphoric"
        set "Text" {
            set "m_DefaultTranslation" "It lifts my spirits to think I'll be seeing you every day from now on."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Single_Friendliness_013"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Hesitant"
        set "Text" {
            set "m_DefaultTranslation" "Not just the Elmo—she has to handle maintenance and repairs for the dolls as well. Will Meilin be all right?"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Series_Daily_007"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Frustrated"
        set "Text" {
            set "m_DefaultTranslation" "(Tch)"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Series_Tone_Negative_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Disheartened"
        set "Text" {
            set "m_DefaultTranslation" "Afternoon tea will have to wait until I've cleared the stack of paperwork on my desk."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Single_Friendliness_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Miserable"
        set "Text" {
            set "m_DefaultTranslation" "There's always next time. Don't be discouraged."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_springfield_va"
            set "itemId" "Series_Lose_Single_Lose_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "GoodwillTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "AnimosityTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
}
