clone "ConversationTemplate" from="Carda_Early/click_bark" id="Springfield/click_bark_springfield" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_springfield"
        }
    }
    set "Priority" 100
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="ACTION" {
            set "m_SerAction" type="SetFlag" {
                set "FlagName" "click_bark_springfield"
                set "FlagValue" #true
            }
        }
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_springfield_va"
                        set "itemId" "Series_Set_Click_Series_Up_007"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Preparation complete."
                }
            }
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_springfield_va"
                        set "itemId" "Series_Cancel_Series_Tone_Positive_005"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Leave it to me."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

