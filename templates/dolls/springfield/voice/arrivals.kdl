clone "ConversationTemplate" from="Carda_Early/arrival_carda" id="Springfield/arrival_springfield" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_springfield"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_springfield_va"
                        set "itemId" "Single_Login_001"
                    }
                    set "RoleGuid" "Carda"
                    set "Text" "Welcome back, Commander. Would you like some hot coffee?"
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}
