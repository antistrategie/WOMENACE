clone "TagTemplate" from="unique" id="wmgfl_ots14"

clone "SpeakerTemplate" from="sy" id="wmgfl_ots14_speaker" {
    set "Tags" "wmgfl_ots14 pirate_sl female infantry waybacker wmgfl_class_ar"
    set "Nickname" {
        set "m_DefaultTranslation" "OTs-14"
    }
    set "Forename" {
        set "m_DefaultTranslation" "OTs-14"
    }
    set "Surname" {
        set "m_DefaultTranslation" ""
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Name: OTs-14

            Proficiency: Armored Core

            Birth: Unknown

            Age: Classified

            Affiliation(s): Elmo - Third-Gen Doll Echelon
            """
    }

    set "BarkImage" asset="ots14/bark"
    set "StandLookLeftImage" asset="ots14/stand_look_left"
    set "StandLookRightImage" asset="ots14/stand_look_right"
    set "StandLookRightInactiveImage" asset="ots14/stand_look_right_inactive"
}

clone "EntityTemplate" from="player_squad.sy" id="player_squad.ots14" {
    append "Tags" "wmgfl_ots14"
    append "Tags" "jy_special_restricted"
    set "Title" {
        set "m_DefaultTranslation" "Elmo - Third-Gen Doll Echelon"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            A calm, serious, proud, and confident third-generation T-Doll. The modifications granted her unparalleled power, making her even more resilient than before—enough to conceal her underlying unease and vulnerability.
            "How did today's plan go? Commander, may I hear a little about it?"
            """
    }

    set "Properties" {
        set "Vision" 11
    }

    set "Badge" asset="ots14/badge_mini"
    set "BadgeWhite" asset="ots14/badge_mini"
    clear "Items"
    append "Items" "armor.player_fatigues"
    append "Items" "weapon.ots14"

    set "Scale" {
        set "x" 1.0
        set "y" 1.0
    }
    set "OverrideScaleForSquadLeader" #false
}

clone "UnitLeaderTemplate" from="squad_leader.sy" id="squad_leader.ots14" {
    set "InfantryUnitTemplate" "player_squad.ots14"
    set "SpeakerTemplate" "wmgfl_ots14_speaker"
    set "InitialPerk" "perk.wmgfl_os_tuning"
    set "PerkTrees" index=0 "perk_tree.ots14"
    set "CustomHead" #null
    set "UnitTitle" {
        set "m_DefaultTranslation" "Tactical Doll"
    }
    set "UnitDescription" {
        set "m_DefaultTranslation" """
            A calm, serious, proud, and confident third-generation T-Doll. The modifications granted her unparalleled power, making her even more resilient than before—enough to conceal her underlying unease and vulnerability.
            "How did today's plan go? Commander, may I hear a little about it?"
            """
    }

    set "InitialAttributes" index=0 130
    set "InitialAttributes" index=1 90
    set "InitialAttributes" index=2 120
    set "InitialAttributes" index=3 135
    set "InitialAttributes" index=4 255
    set "InitialAttributes" index=5 70
    set "InitialAttributes" index=6 100

    set "QualityLevel" 4
    set "GrowthPotential" 5
    set "FixedSupplyCost" 400
    set "PromotionCostMult" 0.8
    set "SquaddieTax" 0
    set "Rarity" 5

    set "Slot" asset="ots14/slot"
    set "SlotInactive" asset="ots14/slot_inactive"
    set "SlotBadge" asset="ots14/slot_badge"

    set "BadgeDragged" asset="ots14/badge_dragged"
    set "BigBadge" asset="ots14/big_badge"
    set "BadgeUnitWindow" asset="ots14/badge_unit_window"
    set "BadgeMini" asset="ots14/badge_mini"

    set "HiringSelectBarkSound" {
        set "bankId" "wmgfl_tactical_barks_ots14_va"
        set "itemId" "Series_Chosen_Series_Tone_Positive_006"
    }
    set "HiredBarkSound" {
        set "bankId" "wmgfl_tactical_barks_ots14_va"
        set "itemId" "Series_Chosen_Auto_Series_Tone_Positive_007"
    }

    set "PromotionBarkSounds" index=0 {
        set "PerkTier" 1
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Series_Up_001"
        }
    }
    set "PromotionBarkSounds" index=1 {
        set "PerkTier" 2
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Series_Up_002"
        }
    }
    set "PromotionBarkSounds" index=2 {
        set "PerkTier" 3
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Series_Up_003"
        }
    }
    set "PromotionBarkSounds" index=3 {
        set "PerkTier" 4
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Series_Up_005"
        }
    }

    clear "EmotionalStateResponses"
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Eager"
        set "Text" {
            set "m_DefaultTranslation" "Do we need to review today’s schedule? Or would you prefer tea time first?"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Single_Login_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Determined"
        set "Text" {
            set "m_DefaultTranslation" "I wonder if I’m even stronger now."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Series_Up_003"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Overconfident"
        set "Text" {
            set "m_DefaultTranslation" "Exactly as planned. Can’t wait for the victory party."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Series_Win_Single_Win_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Euphoric"
        set "Text" {
            set "m_DefaultTranslation" "I’m finally back by your side. Let’s stick together on the road ahead."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Single_Obtain_SSR_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Hesitant"
        set "Text" {
            set "m_DefaultTranslation" "Please, don’t hate me."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Series_Up_004"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Frustrated"
        set "Text" {
            set "m_DefaultTranslation" "Stay out of my way."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Series_Attack_Series_Tone_Positive_003"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Disheartened"
        set "Text" {
            set "m_DefaultTranslation" "Don't look over here."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Single_Passive_SSR_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Miserable"
        set "Text" {
            set "m_DefaultTranslation" "Don’t look."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_ots14_va"
            set "itemId" "Series_Die_Series_Tone_Negative_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "GoodwillTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "AnimosityTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
}
