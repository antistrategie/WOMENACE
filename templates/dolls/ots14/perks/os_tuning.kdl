clone "PerkTemplate" from="perk.steady_gun" id="perk.wmgfl_os_tuning" {
    set "Title" {
        set "m_DefaultTranslation" "OS Tuning"
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "OTs-14's combat OS runs her weapons bay and field kits."
    }
    set "Description" {
        set "m_DefaultTranslation" """
            “Got a job for you, 621.”

              – Handler Walter


            <style="Highlight">• Weapons Bay: OTs-14 carries up to four special weapons on her arms.</style>
            <style="Highlight">  • Arms holding the same weapon can fire together as one action, as a pair or as all four at once.</style>
            <style="Highlight">  • OTs-14 can impersonate any owner imprint from a Doll SSR weapon.</style>
            <style="Highlight">• Field Kit: grants the skills 'Repair Kit' and 'Ammo Refill'. The kit holds a single charge per mission and using either skill expends it for both.</style>
            """
    }

    set "Icon" asset="ots14/perks/os_tuning"
    set "IconDisabled" asset="ots14/perks/os_tuning_inactive"
    set "PerkIcon" asset="ots14/perks/os_tuning"

    clear "EventHandlers"
    append "EventHandlers" type="AddSkill" {
        set "Event" enum="AddEvent" "OnMissionStart"
        set "SkillToAdd" "active.wmgfl_bay_repair"
    }
    append "EventHandlers" type="AddSkill" {
        set "Event" enum="AddEvent" "OnMissionStart"
        set "SkillToAdd" "active.wmgfl_bay_reload"
    }
    // The kit's one charge. Using either skill tagged wmgfl_field_kit makes OTs-14 use the spend
    // skill on herself, which plants the spent marker, and both skills grey while she carries it.
    // `Uses 1` on the skills is no gate: the engine re-derives uses from the template at every
    // turn boundary.
    append "EventHandlers" type="ApplySkillToSelf" {
        set "SkillToApply" "active.wmgfl_field_kit_spend"
        set "Event" enum="ApplyOnEvent" "OnSkillWithTagsUsed"
        append "RequiredTags" "wmgfl_field_kit"
        set "RequiredLogic" enum="LogicType" "Or"
        set "ChanceToApply" 100
    }
}

clone "TagTemplate" from="unique" id="wmgfl_field_kit"

// What ApplySkillToSelf fires. It does not add SkillToApply to the actor: it creates an instance
// and uses it on the owner's tile, free and without a usability check, so a bare status effect
// there does nothing. A hidden self-use active whose own AddSkill lands the marker is the shape
// vanilla uses (damage_effect.powerlines_damaged.active, active.emp_discharge_small).
clone "SkillTemplate" from="active.special.lucky_shot" id="active.wmgfl_field_kit_spend" {
    set "Title" {
        set "m_DefaultTranslation" "Field Kit Spent"
    }
    set "Description" {
        set "m_DefaultTranslation" "OTs-14 has used her field kit this mission."
    }
    set "IsHidden" #true
    set "ActionPointCost" 0
    set "IsLimitedUses" #false
    set "IsRemovedAfterCombat" #true
    // Used on the owner's own tile, so it reaches no further than that.
    set "MaxRange" 0
    set "AoEType" enum="SkillAoEType" "CenterOnly"
    clear "EventHandlers"
    append "EventHandlers" type="AddSkill" {
        set "Event" enum="AddEvent" "OnUse"
        set "SkillToAdd" "effect.wmgfl_field_kit_spent"
    }
}

// Marks the field kit as spent for the rest of the mission. A hidden status effect on OTs-14
// herself, so it survives every resync and a mid-mission save, and the engine drops it after
// combat like any other effect.
clone "SkillTemplate" from="effect.reduced_ap_after_transport" id="effect.wmgfl_field_kit_spent" {
    set "Title" {
        set "m_DefaultTranslation" "Field Kit Spent"
    }
    set "Description" {
        set "m_DefaultTranslation" "OTs-14 has used her field kit this mission."
    }
    clear "EventHandlers"
}

clone "SkillTemplate" from="active.treat_wounds" id="active.wmgfl_bay_repair" {
    set "Title" {
        set "m_DefaultTranslation" "Repair Kit"
    }
    set "Description" {
        set "m_DefaultTranslation" "Patch up OTs-14's chassis, restoring all HP."
    }
    set "Icon" asset="ots14/skills/repair"
    set "IconDisabled" asset="ots14/skills/repair_disabled"
    set "ActionPointCost" 20
    // No use counter. The charge is the spent marker, and a counter the engine refills each
    // turn would disagree with it on the tile.
    set "IsLimitedUses" #false
    set "IsRemovedAfterCombat" #true
    append "Tags" "wmgfl_field_kit"
    clear "EventHandlers"
    append "EventHandlers" type="WOMENACE:HealUserToFull" {}
    append "EventHandlers" type="LimitUsability" {
        append "NotUsableIfActorHasSkill" "effect.wmgfl_field_kit_spent"
    }
}

clone "SkillTemplate" from="active.rogue_ammo_runner_refill_ammo" id="active.wmgfl_bay_reload" {
    set "Title" {
        set "m_DefaultTranslation" "Ammo Refill"
    }
    set "Description" {
        set "m_DefaultTranslation" "Refill the ammunition of every weapon OTs-14 carries."
    }
    set "Icon" asset="ots14/skills/reload"
    set "IconDisabled" asset="ots14/skills/reload_disabled"
    set "IsTargeted" #false
    set "TargetsAllowed" enum="SkillTarget" "EmptyTile"
    set "MinRange" 0
    set "MaxRange" 0
    set "ActionPointCost" 20
    set "IsLimitedUses" #false
    set "IsRemovedAfterCombat" #true
    append "Tags" "wmgfl_field_kit"
    append "EventHandlers" type="LimitUsability" {
        append "NotUsableIfActorHasSkill" "effect.wmgfl_field_kit_spent"
    }
}
