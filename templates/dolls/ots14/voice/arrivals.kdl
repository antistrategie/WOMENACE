clone "ConversationTemplate" from="JeanSy/arrival_jeansy" id="Ots14/arrival_ots14" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_ots14"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_ots14_va"
                        set "itemId" "Series_Battle_Start_Series_Tone_Positive_002"
                    }
                    set "RoleGuid" "JeanSy"
                    set "Text" "Target confirmed."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}
