clone "TagTemplate" from="unique" id="wmgfl_alva"

clone "SpeakerTemplate" from="carda" id="wmgfl_alva_speaker" {
    set "Tags" "wmgfl_alva female infantry waybacker wmgfl_class_ar"
    set "Nickname" {
        set "m_DefaultTranslation" "Alva"
    }
    set "Forename" {
        set "m_DefaultTranslation" "Alva"
    }
    set "Surname" {
        set "m_DefaultTranslation" ""
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Name: Alva (AN94)

            Proficiency: Sustain Combat

            Birth: Unknown

            Age: Classified

            Affiliation(s): Task Force DEFY
            """
    }

    set "BarkImage" asset="alva/bark"
    set "StandLookLeftImage" asset="alva/stand_look_left"
    set "StandLookRightImage" asset="alva/stand_look_right"
    set "StandLookRightInactiveImage" asset="alva/stand_look_right_inactive"
}

clone "EntityTemplate" from="player_squad.carda" id="player_squad.alva" {
    append "Tags" "wmgfl_alva"
    set "Title" {
        set "m_DefaultTranslation" "Task Force DEFY"
    }
    set "Description" {
        set "m_DefaultTranslation" "A Doll from the Neo-Soviet Union's Bureau of State Security and the prototype for the Wolf Pack Project, now leader of Task Force DEFY. Ten years ago, she helped the Commander to complete the decapitation operation in Frankfurt, then signed an agreement of conditional freedom of action with StateSec. She spent the last ten years countering Paradeus activities in the Yellow Zone. After becoming the leader of DEFY, she's taken over her former partner as the new alpha wolf, earned the respect of her squad members and became better at socializing."
    }

    set "Badge" asset="alva/badge_mini"
    set "BadgeWhite" asset="alva/badge_mini"
    clear "Items"
    append "Items" "armor.player_fatigues"
    append "Items" "weapon.alva"

    set "Scale" {
        set "x" 1.0
        set "y" 1.0
    }
    set "OverrideScaleForSquadLeader" #false
}

clone "UnitLeaderTemplate" from="squad_leader.carda" id="squad_leader.alva" {
    set "InfantryUnitTemplate" "player_squad.alva"
    set "SpeakerTemplate" "wmgfl_alva_speaker"
    set "CustomHead" #null
    set "UnitTitle" {
        set "m_DefaultTranslation" "Tactical Doll"
    }
    set "UnitDescription" {
        set "m_DefaultTranslation" "A Doll from the Neo-Soviet Union's Bureau of State Security and the prototype for the Wolf Pack Project, now leader of Task Force DEFY. Ten years ago, she helped the Commander to complete the decapitation operation in Frankfurt, then signed an agreement of conditional freedom of action with StateSec. She spent the last ten years countering Paradeus activities in the Yellow Zone. After becoming the leader of DEFY, she's taken over her former partner as the new alpha wolf, earned the respect of her squad members and became better at socializing."
    }

    set "InitialAttributes" index=0 88
    set "InitialAttributes" index=1 85
    set "InitialAttributes" index=2 80
    set "InitialAttributes" index=3 100
    set "InitialAttributes" index=4 100
    set "InitialAttributes" index=5 25
    set "InitialAttributes" index=6 70

    set "QualityLevel" 3
    set "GrowthPotential" 5
    set "FixedSupplyCost" 100
    set "PromotionCostMult" 0.8
    set "SquaddieTax" 25
    set "Rarity" 5

    set "InitialPerk" "perk.firing_line"
    set "PerkTrees" index=0 "perk_tree.alva"

    set "Slot" asset="alva/slot"
    set "SlotInactive" asset="alva/slot_inactive"
    set "SlotBadge" asset="alva/slot_badge"

    set "BadgeDragged" asset="alva/badge_dragged"
    set "BigBadge" asset="alva/big_badge"
    set "BadgeUnitWindow" asset="alva/badge_unit_window"
    set "BadgeMini" asset="alva/badge_mini"

    set "HiringSelectBarkSound" {
        set "bankId" "wmgfl_tactical_barks_alva_va"
        set "itemId" "Series_Tone_Positive_006"
    }
    set "HiredBarkSound" {
        set "bankId" "wmgfl_tactical_barks_alva_va"
        set "itemId" "Series_Daily_001"
    }
    set "PromotionBarkSounds" index=0 {
        set "PerkTier" 1
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Series_Up_001"
        }
    }
    set "PromotionBarkSounds" index=1 {
        set "PerkTier" 2
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Series_Up_002"
        }
    }
    set "PromotionBarkSounds" index=2 {
        set "PerkTier" 3
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Series_Up_003"
        }
    }
    set "PromotionBarkSounds" index=3 {
        set "PerkTier" 4
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Series_Up_005"
        }
    }

    clear "EmotionalStateResponses"
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Eager"
        set "Text" {
            set "m_DefaultTranslation" "Alva reporting, Commander. I have organized the day's tasks."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Single_Login_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Determined"
        set "Text" {
            set "m_DefaultTranslation" "My value doesn't come from comparisons with others, but from my presence and my contribution. This is the most valuable lesson I've learned from my experiences."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Series_Daily_005"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Overconfident"
        set "Text" {
            set "m_DefaultTranslation" "Professor Shaw's designs are never outdated."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Series_Up_005"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Euphoric"
        set "Text" {
            set "m_DefaultTranslation" "The Elmo is... warmer than I expected. Everyone here has a place of their own, including me. It feels strange... If we were part of Griffin instead of Statesec 10 years ago, perhaps we could have experienced this earlier."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Series_Daily_003"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Hesitant"
        set "Text" {
            set "m_DefaultTranslation" "Um, sorry, I'm still a little nervous. It's been ten years, so there's a lot I want to talk about."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Single_Friendliness_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Frustrated"
        set "Text" {
            set "m_DefaultTranslation" "It's not over yet!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Series_Tone_Negative_003"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Disheartened"
        set "Text" {
            set "m_DefaultTranslation" "I can hold on!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_alva_va"
            set "itemId" "Series_Tone_Negative_002"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Miserable"
        set "Text" {
            set "m_DefaultTranslation" "..."
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "GoodwillTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "AnimosityTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
}
