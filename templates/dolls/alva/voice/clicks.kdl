clone "ConversationTemplate" from="Carda_Early/click_bark" id="Alva/click_bark_alva" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_alva"
        }
    }
    set "Priority" 100
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="ACTION" {
            set "m_SerAction" type="SetFlag" {
                set "FlagName" "click_bark_alva"
                set "FlagValue" #true
            }
        }
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_alva_va"
                        set "itemId" "Series_Tone_Positive_001"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Preparations complete."
                }
            }
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_alva_va"
                        set "itemId" "Series_Tone_Positive_006"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Leave it to me."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

