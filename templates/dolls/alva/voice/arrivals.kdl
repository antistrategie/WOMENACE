clone "ConversationTemplate" from="Carda_Early/arrival_carda" id="Alva/arrival_alva" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_alva"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_alva_va"
                        set "itemId" "Series_Tone_Positive_001"
                    }
                    set "RoleGuid" "Carda"
                    set "Text" "Preparations complete."
                }
            }
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_alva_va"
                        set "itemId" "Series_Tone_Positive_007"
                    }
                    set "RoleGuid" "Carda"
                    set "Text" "Mission accepted."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}
