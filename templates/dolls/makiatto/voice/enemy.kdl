clone "ConversationTemplate" from="Carda_Early/enemy_damage_blocked" id="Makiatto/enemy_damage_blocked_makiatto" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_makiatto"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_makiatto_va"
                        set "itemId" "End"
                    }
                    set "RoleGuid" "Attacker"
                    set "Text" "(Hmph)"
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

