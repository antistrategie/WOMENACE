    set "Damage" 18.0
    set "ArmorPenetration" 14.0
    set "DamageToArmorDurability" 13.0
}

clone "WeaponTemplate" from="weapon.leva" id="weapon.leva_r4" {
    set "Damage" 19.5
    set "ArmorPenetration" 16.0
    set "DamageToArmorDurability" 14.0
}

clone "WeaponTemplate" from="weapon.leva" id="weapon.leva_r5" {
    set "Damage" 21.0
    set "ArmorPenetration" 18.0
