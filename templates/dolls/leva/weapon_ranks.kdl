clone "CommodityTemplate" from="commodity.construct_weapon_parts" id="commodity.wmgfl_component_leva" {
    set "Title" {
        set "m_DefaultTranslation" "UMP45 Component"
    }
    set "Description" {
        set "m_DefaultTranslation" "[PLACEHOLDER] Weapon component for UMP45"
    }
    append "Tags" "jy_no_sell"
    set "Icon" asset="weapon/leva/Icon"
    set "Rarity" 0
    set "TradeValue" 0
    set "BlackMarketMaxQuantity" 0
    set "MinCampaignProgress" 0
}

clone "BlueprintTemplate" from="blueprint.squad_weapon_electro_magnetic_enhanced_assault_rifle" id="blueprint.wmgfl_leva_duplicate" {
    set "m_CraftingResult" "weapon.leva"
    clear "m_CraftingMaterials"
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_component_leva"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.construct_weapon_parts"
        set "Count" 4
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.construct_cybernetic_optics"
        set "Count" 2
    }
}
