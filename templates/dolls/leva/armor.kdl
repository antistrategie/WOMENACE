clone "ArmorTemplate" from="armor.player_fatigues" id="armor.leva_default" {
    set "DeployCosts" {
        set "m_Supplies" 0
    }
    set "Title" {
        set "m_DefaultTranslation" "Reasoned Gaze"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Field Outfit"
    }
    set "Description" {
        set "m_DefaultTranslation" "Leva's typical outfit. Infusing her unique personaility into this outfit design which symbolizes rationality reflects how she walks a lonley path but never compromises her principles. This unique contradiction is where Leva's charm lies."
    }
    set "Icon" asset="leva/armor/default/Icon"
    set "IconEquipment" asset="leva/armor/default/IconEquipment"
    set "IconSkillBar" asset="leva/armor/default/IconSkillBar"
    set "SquadLeaderMode" enum="SquadLeaderModelMode" "SameAsOthers"
    append "OnlyEquipableBy" "wmgfl_transmog"
    append "Tags" "jy_no_sell"
}

clone "ArmorTemplate" from="armor.player_fatigues" id="armor.leva_diamond_flower" {
    set "DeployCosts" {
        set "m_Supplies" 0
    }
    set "Title" {
        set "m_DefaultTranslation" "Diamond Flower"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Formal Wear"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            "I've taken part in many more parties than in the past. However, there's one that I've been looking forward to; I've never gotten an invite for it... So what are you waiting for, Commander~?"
            She fixes you with her mirthful eyes, waiting for your answer.
            """
    }
    set "Icon" asset="leva/armor/diamond/Icon"
    set "IconEquipment" asset="leva/armor/diamond/IconEquipment"
    set "IconSkillBar" asset="leva/armor/diamond/IconSkillBar"
    set "SquadLeaderMode" enum="SquadLeaderModelMode" "SameAsOthers"
    append "OnlyEquipableBy" "wmgfl_transmog"
    append "Tags" "jy_no_sell"
}

clone "ArmorTemplate" from="armor.player_fatigues" id="armor.leva_sultry_tempo" {
    set "DeployCosts" {
        set "m_Supplies" 0
    }
    set "Title" {
        set "m_DefaultTranslation" "Sultry Tempo"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Summer Outfit"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Commander, it seems you're having trouble deciding where to place your eyes. Do you need me to go over there and correct you?
            The sunlight chases her curves, and her sunny disposition swells the places where the sweat soaks the fabric.
            """
    }
    set "Icon" asset="leva/armor/sultry_tempo/Icon"
    set "IconEquipment" asset="leva/armor/sultry_tempo/IconEquipment"
    set "IconSkillBar" asset="leva/armor/sultry_tempo/IconSkillBar"
    set "SquadLeaderMode" enum="SquadLeaderModelMode" "SameAsOthers"
    append "OnlyEquipableBy" "wmgfl_transmog"
    append "Tags" "jy_no_sell"
}
