    set "Damage" 11.0
    set "ArmorPenetration" 12.0
    set "Suppression" 4.5
}

clone "WeaponTemplate" from="weapon.helen" id="weapon.helen_r3" {
    set "Damage" 12.0
    set "ArmorPenetration" 13.0
    set "Suppression" 5.0
}

