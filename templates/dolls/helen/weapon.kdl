clone "WeaponTemplate" from="weapon.generic_combat_shotgun_tier_1_cs185" id="weapon.helen" {
    append "Tags" "jy_no_sell"
    append "Tags" "wmgfl_class_shotgun"
    set "Title" {
        set "m_DefaultTranslation" "DP-12"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Shotgun"
    }
    set "Description" {
        set "m_DefaultTranslation" "A firearm that is highly compatible with Helen. Modified based on her combat preferences. Its magazine capacity has been increased, making it more suitable for mobile tactics in additional situations."
    }
    set "Model" asset="weapon/helen/main"
    set "SkillsGranted" index=0 "active.fire_helen_dp12"
    append "SkillsGranted" "active.fire_helen_dp12_slugshot"
    set "Icon" asset="weapon/helen/Icon"
    set "IconEquipment" asset="weapon/helen/IconEquipment"
    set "IconEquipmentDisabled" asset="weapon/helen/IconEquipmentDisabled"
    set "IconSkillBar" asset="weapon/helen/IconSkillBar"
    set "IconSkillBarDisabled" asset="weapon/helen/IconSkillBarDisabled"

    set "Damage" 10.0
    set "ArmorPenetration" 10.0
    set "Suppression" 4.0

    set "BlackMarketMaxQuantity" 0
}

clone "SkillTemplate" from="active.fire_combat_shotgun_tier_1" id="active.fire_helen_dp12" {
    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_sg_addition_bank"
        set "itemId" "sg_single"
    }
    append "SoundsOnAttack" {
        set "bankId" "weapons_soundbank"
        set "itemId" "combat_shotgun_casings"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_sg_addition_bank"
        set "itemId" "sg_single_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_sg_addition_bank"
        set "itemId" "sg_single_distant"
    }
    append "EventHandlers" type="SynchronizeItemUses" {}
}

clone "SkillTemplate" from="active.fire_battle_rifle_tier_1_aimed_fire_marksman" id="active.fire_helen_dp12_slugshot" {
    set "Title" {
        set "m_DefaultTranslation" "Slug Shot"
    }
    set "Description" {
        set "m_DefaultTranslation" "Switch to slug round and fire an accurate volley with higher penetration to target beyond normal range."
    }
    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_sg_addition_bank"
        set "itemId" "sg_single"
    }
    append "SoundsOnAttack" {
        set "bankId" "weapons_soundbank"
        set "itemId" "combat_shotgun_casings"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_sg_addition_bank"
        set "itemId" "sg_single_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_sg_addition_bank"
        set "itemId" "sg_single_distant"
    }
    set "Uses" 16
    set "MaxRange" 6
    set "IdealRange" 4
    set "IsOverridingRanges" #true
    set "EventHandlers" index=0 {
        set "AccuracyBonus" 20.0
        set "ArmorPenetrationMult" 3.5
        set "DamageMult" 1.5
        set "ElementsHitPercentage" 0.0
    }
    set "IsDeploymentRequired" #false
}
