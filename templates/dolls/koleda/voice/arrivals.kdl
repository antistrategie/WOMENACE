clone "ConversationTemplate" from="Carda_Early/arrival_carda" id="Koleda/arrival_koleda" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_koleda"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_koleda_va"
                        set "itemId" "Single_Login_001"
                    }
                    set "RoleGuid" "Carda"
                    set "Text" "About time you woke up. Hey, wanna slack off together? Aww, you're way too serious, Commander."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}
