clone "WeaponTemplate" from="weapon.generic_carbine_tier1_spc" id="weapon.sextans" {
    append "Tags" "jy_no_sell"
    append "Tags" "wmgfl_class_blade"
    set "Title" {
        set "m_DefaultTranslation" "Nightsnake"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Sword"
    }
    set "Description" {
        set "m_DefaultTranslation" "A blade that's highly compatible with Sextans. Modified based on her combat preferences, its hilt use the latest composite allows, allowing it to sink silently into an enemy's body."
    }

    set "Model" asset="weapon/sextans/main"

    set "Icon" asset="weapon/sextans/Icon"
    set "IconEquipment" asset="weapon/sextans/IconEquipment"
    set "IconEquipmentDisabled" asset="weapon/sextans/IconEquipmentDisabled"
    set "IconSkillBar" asset="weapon/sextans/IconSkillBar"
    set "IconSkillBarDisabled" asset="weapon/sextans/IconSkillBarDisabled"

    set "Damage" 0.0
    set "ArmorPenetration" 0.0
    set "Suppression" 0.0
    set "AccuracyBonus" 0.0

    set "DeployCosts" {
        set "m_Supplies" 15
    }

    append "OnlyEquipableBy" "wmgfl_sextans"
    // Hers alone: the loader's inventory filter drops an item self-tagged with the slot restriction
    // tag from every non-restricted leader's dropdown, and keeps it for a restricted unit (Sextans is
    // jy_weapon_restricted). Same mechanism the mech chassis uses via jy_vehicle_restricted.
    append "Tags" "jy_weapon_restricted"
    set "BlackMarketMaxQuantity" 0

    clear "SkillsGranted"
    append "SkillsGranted" "active.sextans_slash"
    append "SkillsGranted" "active.sextans_thrust"
    append "SkillsGranted" "active.sextans_ult"
    append "SkillsGranted" "active.sextans_ult_strike"
    append "SkillsGranted" "active.sextans_ult_rend"
}

clone "SkillTemplate" from="active.wetteroth_thats_a_knife" id="active.sextans_slash" {
    // The knife base is culled after combat and the per-mission grant does not
    // reliably restore it, so a granted clone goes missing on later missions.
    // These are permanent weapon skills: keep them out of the cull.
    set "IsRemovedAfterCombat" #false

    set "Title" {
        set "m_DefaultTranslation" "Dreamscape Garrote"
    }
    set "Description" {
        set "m_DefaultTranslation" "A sweeping cut with the sword. Applies <link=\"sextans_blood_kiss\">Blood Kiss</link> and builds a stack of <link=\"sextans_coagulation\">Coagulation</link> for every enemy hit."
    }

    set "Icon" asset="sextans/skills/slash"
    set "IconDisabled" asset="sextans/skills/slash_inactive"

    // hit chance from her accuracy, not a guaranteed strike
    set "IsAlwaysHitting" #false

    set "ActionPointCost" 20
    set "AnimationType" enum="AnimationType" "Attack"
    set "DelayAfterAnimationTrigger" 0.8

    set "IsOverridingRanges" #true
    set "MinRange" 1
    set "IdealRange" 1
    set "MaxRange" 1

    clear "SoundsOnUse"
    append "SoundsOnUse" {
        set "bankId" "wmgfl_sextans_sfx"
        set "itemId" "Atk"
    }

    set "EventHandlers" index=0 {
        set "Damage" 30.0
        set "ArmorPenetration" 100.0
        set "Suppression" 0.0
        set "DamageToArmorDurability" 50.0
    }

    append "EventHandlers" type="WOMENACE:MarkOnHit" {
        set "EffectId" "effect.sextans_blood_kiss"
        set "GrantsCharge" #true
    }

    append "Tags" "armor_piercing"
    append "Tags" "anti_infantry"
    append "Tags" "wmgfl_melee"
}

clone "SkillTemplate" from="active.wetteroth_thats_a_knife" id="active.sextans_thrust" {
    set "IsRemovedAfterCombat" #false

    set "Title" {
        set "m_DefaultTranslation" "Sanctuary Lauds"
    }
    set "Description" {
        set "m_DefaultTranslation" "A thrust through every enemy in a line. Applies <link=\"sextans_blood_kiss\">Blood Kiss</link> and builds a stack of <link=\"sextans_coagulation\">Coagulation</link> for every enemy hit."
    }

    set "Icon" asset="sextans/skills/thrust"
    set "IconDisabled" asset="sextans/skills/thrust_inactive"

    // hit chance from her accuracy, not a guaranteed strike
    set "IsAlwaysHitting" #false

    set "ActionPointCost" 50
    set "AnimationType" enum="AnimationType" "SpecialAttack1"
    set "KeyBind" enum="KeyBindPlayerSetting" "SelectItemSkill2"
    set "Order" enum="SkillOrder" "OffensiveSpecial"
    set "DelayAfterAnimationTrigger" 0.9

    set "IsOverridingRanges" #true
    set "MinRange" 1
    set "IdealRange" 1
    set "MaxRange" 1

    set "ScatterChance" 0
    set "AoEChanceToHitCenter" 100

    clear "SoundsOnUse"
    append "SoundsOnUse" {
        set "bankId" "wmgfl_sextans_sfx"
        set "itemId" "Skill01"
    }
    append "SoundsOnUse" {
        set "bankId" "wmgfl_tactical_barks_sextans_va"
        set "itemId" "Series_Skill01_Single_Skill_001"
    }

    set "EventHandlers" index=0 {
        set "Damage" 25.0
        set "ArmorPenetration" 100.0
        set "Suppression" 0.0
        set "DamageToArmorDurability" 40.0
    }

    append "Tags" "area_of_effect"
    append "Tags" "armor_piercing"
    append "Tags" "anti_infantry"
    append "Tags" "wmgfl_melee"

    append "EventHandlers" type="WOMENACE:MarkOnHit" {
        set "EffectId" "effect.sextans_blood_kiss"
        set "GrantsCharge" #true
    }
}

// The ultimate: a dash. The player picks the DESTINATION tile (only empty,
// standable tiles are valid targets, so she can never land inside a wall or
// an enemy), and the swathe is the line from her to it, snapped to the eight
// compass directions. She vanishes mid wind-up, reappears at the chosen
// tile, and only then do the wounds arrive down the whole line. Locked
// behind 4 Coagulation stacks (SextansUltHandler flips the uses from 0 to 1
// at full charge). On impact: marked enemies take the rend's bonus damage,
// each marked enemy restores her vitality, and every ally is consecrated
// with the Holy Blood Mark.
clone "SkillTemplate" from="active.wetteroth_thats_a_knife" id="active.sextans_ult" {
    set "IsRemovedAfterCombat" #false

    set "Title" {
        set "m_DefaultTranslation" "Midnight Vesper"
    }
    set "Description" {
        set "m_DefaultTranslation" "Sextans dashes to a point of her choosing, running her blade through everything on the way. Every victim hit restores her vitality. Enemies with <link=\"sextans_blood_kiss\">Blood Kiss</link> take extra damage and restore more, and her allies are given <link=\"sextans_holy_blood_mark\">Holy Blood Mark</link>. Requires 4 stacks of <link=\"sextans_coagulation\">Coagulation</link>."
    }

    set "Icon" asset="sextans/skills/ult"
    set "IconDisabled" asset="sextans/skills/ult_inactive"

    set "ActionPointCost" 20
    set "AnimationType" enum="AnimationType" "SpecialAttack2"
    set "KeyBind" enum="KeyBindPlayerSetting" "SelectItemSkill3"
    set "Order" enum="SkillOrder" "OffensiveSpecial2"
    set "DelayAfterAnimationTrigger" 2.2

    // MaxRange is the dash length: keep it equal to the ult's Tiles in
    // SextansPierceShapeSystem.Shapes (8) or the swathe and the targetable
    // area disagree
    set "IsOverridingRanges" #true
    set "MinRange" 1
    set "IdealRange" 1
    set "MaxRange" 8

    set "ScatterChance" 0
    set "AoEChanceToHitCenter" 100

    // locked until Coagulation fills
    set "IsLimitedUses" #true
    set "Uses" 0

    clear "SoundsOnUse"
    append "SoundsOnUse" {
        set "bankId" "wmgfl_sextans_sfx"
        set "itemId" "UltraSkill_Cast"
    }
    append "SoundsOnUse" {
        set "bankId" "wmgfl_tactical_barks_sextans_va"
        set "itemId" "Series_Ultimate_Single_Ultimate_SSR_001"
    }
    clear "SoundsOnHit"
    append "SoundsOnHit" {
        set "bankId" "wmgfl_sextans_sfx"
        set "itemId" "UltraSkill_Hit"
    }

    // The Attack handler carries the ult's attack presentation: it fires the
    // AnimationType trigger so the ult plays its animation. It deals nothing
    // on use because PierceAoEShape hands the application pass an empty tile
    // list (SextansUltSystem deals the real wounds itself), so its Damage and
    // ArmorPenetration stay non-zero and read straight onto the tooltip's
    // stat rows. Keep them mirroring the strike and rend riders below.
    set "EventHandlers" index=0 {
        set "Damage" 50.0
        set "DamageMult" 1.0
        set "ArmorPenetration" 120.0
        set "Suppression" 0.0
        set "DamageToArmorDurability" 50.0
        set "DamageToArmorDurabilityMult" 1.0
    }

    append "EventHandlers" type="WOMENACE:SextansUlt" {
        set "ChargesNeeded" 4
        set "MaxCharges" 6
        set "TeleportDelay" 1.0
        set "DashDuration" 0.075
        set "PayoffDelay" 2.4
        set "HealFraction" 0.3
        set "HealFractionMarked" 0.4
        set "UltRallyFraction" 0.1
        set "HealCap" 20
    }

    append "Tags" "area_of_effect"
    append "Tags" "unique"
    append "Tags" "wmgfl_melee"
}

// Hidden rider: the ultimate's lane damage, applied by SextansUltSystem to
// every hostile on the dash lane after the teleport. Never shown on the bar.
clone "SkillTemplate" from="active.wetteroth_thats_a_knife" id="active.sextans_ult_strike" {
    set "IsRemovedAfterCombat" #false

    set "Title" {
        set "m_DefaultTranslation" "Midnight Vesper"
    }
    set "IsHidden" #true
    set "AnimationType" enum="AnimationType" "None"
    set "DelayAfterAnimationTrigger" 0.0

    set "IsOverridingRanges" #true
    set "MinRange" 1
    set "IdealRange" 1
    set "MaxRange" 99

    // silent riders: with one application per victim, inherited knife hit
    // sounds stack into a wall of noise. The ult's own UltraSkill_Hit
    // carries the beat alone.
    clear "SoundsOnUse"
    clear "SoundsOnHit"
    clear "SoundsOnAttack"
    clear "SoundsOnAttackPerElement"

    set "EventHandlers" index=0 {
        set "Damage" 50.0
        set "ArmorPenetration" 120.0
        set "Suppression" 0.0
        set "DamageToArmorDurability" 50.0
    }

    append "Tags" "wmgfl_melee"
}

// Hidden rider: the bonus damage enemies marked with Blood Kiss take from the
// ultimate. Applied tile by tile by SextansUltSystem, never shown on the bar.
clone "SkillTemplate" from="active.wetteroth_thats_a_knife" id="active.sextans_ult_rend" {
    set "IsRemovedAfterCombat" #false

    set "Title" {
        set "m_DefaultTranslation" "Midnight Vesper"
    }
    set "IsHidden" #true
    set "AnimationType" enum="AnimationType" "None"
    set "DelayAfterAnimationTrigger" 0.0

    set "IsOverridingRanges" #true
    set "MinRange" 1
    set "IdealRange" 1
    set "MaxRange" 99

    // silent riders: with one application per victim, inherited knife hit
    // sounds stack into a wall of noise. The ult's own UltraSkill_Hit
    // carries the beat alone.
    clear "SoundsOnUse"
    clear "SoundsOnHit"
    clear "SoundsOnAttack"
    clear "SoundsOnAttackPerElement"

    set "EventHandlers" index=0 {
        set "Damage" 20.0
        set "ArmorPenetration" 100.0
        set "Suppression" 0.0
    }

    append "Tags" "wmgfl_melee"
}

// Sextans' SSR sword. Same weapon as Night Snake (weapon.sextans) with a
// different model, but its strikes hit harder and every hit builds Shock. The
// slash and thrust carry a WOMENACE:ElementalDamage handler; the ult builds
// Shock in code (SextansUltSystem, gated on this weapon).
//
// The extra damage lives on the skills' Attack handler (EventHandlers index 0),
// NOT on the weapon: the weapon's own Damage is 0 (the SR sword too), so a
// weapon-level bonus deals nothing. It is registered in SsrImprintSystem only
// for the SSR tooltip / SSR-weapon status, not for a weapon damage bonus.
clone "WeaponTemplate" from="weapon.sextans" id="weapon.sextans_ssr" {
    append "Tags" "jy_no_sell"
    set "Title" {
        set "m_DefaultTranslation" "Twilight Rose"
    }
    set "Description" {
        set "m_DefaultTranslation" "A high-performance blade assigned to Sextans. It is light and handles very well, reflecting an enchanting gleam in the sunset. Through formlessness, it overcomes the foe and seizes victory."
    }

    set "DeployCosts" {
        set "m_Supplies" 30
    }

    set "Model" asset="weapon/sextans_ssr/main"

    set "Icon" asset="weapon/sextans_ssr/Icon"
    set "IconEquipment" asset="weapon/sextans_ssr/IconEquipment"
    set "IconEquipmentDisabled" asset="weapon/sextans_ssr/IconEquipmentDisabled"
    set "IconSkillBar" asset="weapon/sextans_ssr/IconSkillBar"
    set "IconSkillBarDisabled" asset="weapon/sextans_ssr/IconSkillBarDisabled"

    clear "SkillsGranted"
    append "SkillsGranted" "active.sextans_ssr_slash"
    append "SkillsGranted" "active.sextans_ssr_thrust"

    append "SkillsGranted" "active.sextans_ssr_ult"
    append "SkillsGranted" "active.sextans_ssr_ult_strike"
    append "SkillsGranted" "active.sextans_ssr_ult_rend"
}

// The SSR ult chain. Cloned from Night Snake's with identical numbers (the swords' ults match at
// every rank), but kept as SEPARATE skills so calibration ranks each sword's kit independently:
// ranking up one sword never touches the other's skills (see weapon_ranks.kdl / ssr_ranks.kdl).
// The SSR ult's lane hits build Shock in code, gated on this weapon granting the cast
// (SextansUltSystem), not on a KDL ElementalDamage handler here, because the handler would also
// electrify the strike/rend riders' applications.
clone "SkillTemplate" from="active.sextans_ult" id="active.sextans_ssr_ult"

clone "SkillTemplate" from="active.sextans_ult_strike" id="active.sextans_ssr_ult_strike"

clone "SkillTemplate" from="active.sextans_ult_rend" id="active.sextans_ssr_ult_rend"

clone "SkillTemplate" from="active.sextans_slash" id="active.sextans_ssr_slash" {
    set "Description" {
        set "m_DefaultTranslation" "A sweeping cut on a single enemy. Applies <link=\"sextans_blood_kiss\">Blood Kiss</link>, builds a <link=\"sextans_coagulation\">Coagulation</link> stack per enemy hit, and builds <link=\"wmgfl_shock\">Shock</link>."
    }

    set "EventHandlers" index=0 {
        set "Damage" 40.0
    }

    append "EventHandlers" type="WOMENACE:ElementalDamage" {
        set "Element" "Shock"
        set "AmountPerHit" 20.0
    }
}

clone "SkillTemplate" from="active.sextans_thrust" id="active.sextans_ssr_thrust" {
    set "Description" {
        set "m_DefaultTranslation" "A thrust through every enemy in a line. Applies <link=\"sextans_blood_kiss\">Blood Kiss</link>, builds a <link=\"sextans_coagulation\">Coagulation</link> stack per enemy hit, and builds <link=\"wmgfl_shock\">Shock</link>."
    }

    set "EventHandlers" index=0 {
        set "Damage" 35.0
    }

    append "EventHandlers" type="WOMENACE:ElementalDamage" {
        set "Element" "Shock"
        set "AmountPerHit" 20.0
    }
}
