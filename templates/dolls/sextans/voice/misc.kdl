clone "ConversationTemplate" from="Carda_Early/morale_recovery" id="Sextans/morale_recovery" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_sextans"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_sextans_va"
                        set "itemId" "Series_Up_001"
                    }
                    set "RoleGuid" "Recovered"
                    set "Text" "Recovered."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

