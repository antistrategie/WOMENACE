clone "ArmorTemplate" from="armor.player_fatigues" id="armor.sextans_default" {
    set "Title" {
        set "m_DefaultTranslation" "Twilight Phantom"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Field Outfit"
    }
    set "Description" {
        set "m_DefaultTranslation" "Sextans in her usual outfit. It's very convenient for moving around in the darkness. Beware her nighttime ambushes."
    }
    set "Icon" asset="sextans/armor/default/Icon"
    set "IconEquipment" asset="sextans/armor/default/IconEquipment"
    set "IconSkillBar" asset="sextans/armor/default/IconSkillBar"
    set "SquadLeaderMode" enum="SquadLeaderModelMode" "SameAsOthers"
    append "OnlyEquipableBy" "wmgfl_transmog"
    append "Tags" "jy_no_sell"
}

clone "ArmorTemplate" from="armor.sextans_default" id="armor.sextans_nocte" {
    set "Title" {
        set "m_DefaultTranslation" "Nocte Bewitchment"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Maid Costume"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            "Your Excellency... Does this outfit please you? It is a little cold tonight, but your hands are so warm... would you allow me to hold them?"
            There's a glimmer of a charming smile in Sextans' eyes.
            """
    }
    set "Icon" asset="sextans/armor/nocte/Icon"
    set "IconEquipment" asset="sextans/armor/nocte/IconEquipment"
    set "IconSkillBar" asset="sextans/armor/nocte/IconSkillBar"
    set "SquadLeaderMode" enum="SquadLeaderModelMode" "SameAsOthers"
    append "OnlyEquipableBy" "wmgfl_transmog"
    append "Tags" "jy_no_sell"
}
