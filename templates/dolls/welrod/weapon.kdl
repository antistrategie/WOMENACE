clone "WeaponTemplate" from="weapon.generic_smg_tier1_ppp" id="weapon.welrod" {
    // A handgun in the main weapon slot. Vanilla pistols are accessories drawn from the
    // holster, and their pistol-animation skills hide the main weapon while firing. The fire
    // skill below keeps UsePistolAnimation off so the gun stays in hand, and
    // HandgunPoseSystem drives the pistol aiming pose for wmgfl_class_hg weapons instead.
    append "Tags" "wmgfl_doll_weapon"
    append "Tags" "jy_no_sell"
    append "Tags" "wmgfl_class_hg"
    set "Title" {
        set "m_DefaultTranslation" "Welrod MK.II"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Handgun"
    }
    set "Description" {
        set "m_DefaultTranslation" "A firearm highly compatible with Welrod. It's suitable for detective work and covert opts. Its special design reduces firing noise to a bare minimum."
    }

    set "Model" asset="weapon/welrod/main"
    set "Icon" asset="weapon/welrod/Icon"
    set "IconEquipment" asset="weapon/welrod/IconEquipment"
    set "IconEquipmentDisabled" asset="weapon/welrod/IconEquipmentDisabled"
    set "IconSkillBar" asset="weapon/welrod/IconSkillBar"
    set "IconSkillBarDisabled" asset="weapon/welrod/IconSkillBarDisabled"

    set "AccuracyBonus" 5.0
    set "AccuracyDropoff" -12.0
    set "ArmorPenetration" 5.0
    set "ArmorPenetrationDropoff" -2.7

    set "Damage" 9.0
    set "DamageDropoff" -1.6
    set "DamageToArmorDurability" 5.0
    set "DamageToArmorDurabilityDropoff" -1.35

    set "MaxRange" 3
    set "IdealRange" 1
    set "Suppression" 2.0

    set "DeployCosts" {
        set "m_Supplies" 5
    }

    set "BlackMarketMaxQuantity" 0

    clear "SkillsGranted"
    append "SkillsGranted" "active.fire_welrod"
}

clone "SkillTemplate" from="active.fire_smg_tier_1_SOF_suppressed" id="active.fire_welrod" {
    set "Title" {
        set "m_DefaultTranslation" "Shoot"
    }
    set "Description" {
        set "m_DefaultTranslation" "A single silenced shot fired at close range."
        clear "m_Placeholders"
    }
    set "Icon" asset="skill_04"
    set "IconDisabled" asset="skill_04_inactive"
    clear "Tags"
    append "Tags" "short_range"
    append "Tags" "projectile"
    append "Tags" "squad_weapon"
    set "ActionPointCost" 25
    set "IsLimitedUses" #false
    set "Uses" 0
    set "AnimationType" enum="AnimationType" "ShootSingle"
    set "UsePistolAnimation" #false
    set "IsSilent" #true
    set "Repetitions" 1
    set "MuzzleEffect" asset="muzzle_flash_single_suppressed_01"

    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "weapons_soundbank"
        set "itemId" "ap_pistol_01_nsf_suppressed"
    }
    append "SoundsOnAttack" {
        set "bankId" "weapons_soundbank"
        set "itemId" "medium_caliber_brass_single_01"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "weapons_soundbank"
        set "itemId" "ap_pistol_01_nsf_suppressed"
    }
}
