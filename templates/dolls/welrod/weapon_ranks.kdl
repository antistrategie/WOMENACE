clone "CommodityTemplate" from="commodity.construct_weapon_parts" id="commodity.wmgfl_component_welrod" {
    set "Title" {
        set "m_DefaultTranslation" "Welrod MkII Component"
    }
    set "Description" {
        set "m_DefaultTranslation" "[PLACEHOLDER] Weapon component for Welrod MkII"
    }
    append "Tags" "jy_no_sell"
    set "Icon" asset="weapon/welrod/Icon"
    set "Rarity" 0
    set "TradeValue" 0
    set "BlackMarketMaxQuantity" 0
    set "MinCampaignProgress" 0
}

clone "BlueprintTemplate" from="blueprint.squad_weapon_electro_magnetic_enhanced_assault_rifle" id="blueprint.wmgfl_welrod_duplicate" {
    set "m_CraftingResult" "weapon.welrod"
    clear "m_CraftingMaterials"
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_hg_barrel"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_hg_receiver"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_hg_grip"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_hg_sights"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_component_welrod"
        set "Count" 1
    }
}
