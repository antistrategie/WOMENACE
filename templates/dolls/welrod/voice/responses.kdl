clone "ConversationTemplate" from="JeanSy/response_kill_anyone_nice" id="Welrod/response_kill" {
    set "Active" #true
    set "Roles" index=2 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_welrod"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_welrod_va"
                        set "itemId" "Series_Kill_Single_Kill_001"
                    }
                    set "RoleGuid" "JeanSy"
                    set "Text" "Evil has been eradicated."
                }
            }
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_welrod_va"
                        set "itemId" "Series_Tone_Positive_001"
                    }
                    set "RoleGuid" "JeanSy"
                    set "Text" "Your intellect will always be your most reliable weapon."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

