clone "ConversationTemplate" from="JeanSy/click_bark" id="Welrod/click_bark" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_welrod"
        }
    }
    set "Priority" 100
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="ACTION" {
            set "m_SerAction" type="SetFlag" {
                set "FlagName" "click_bark_welrod"
                set "FlagValue" #true
            }
        }
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_welrod_va"
                        set "itemId" "Series_Battle_Start_Series_Tone_Positive_002"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "The hammer of justice."
                }
            }
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_welrod_va"
                        set "itemId" "Series_Chosen_Auto_Series_Tone_Positive_007"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Don't rush."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

