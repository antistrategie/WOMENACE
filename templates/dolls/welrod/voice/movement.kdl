clone "ConversationTemplate" from="JeanSy/missed_cover" id="Welrod/missed_cover" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_welrod"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_welrod_va"
                        set "itemId" "Series_Up_002"
                    }
                    set "RoleGuid" "Attacker"
                    set "Text" "I need more clues."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

clone "ConversationTemplate" from="JeanSy/missed_open" id="Welrod/missed_open" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_welrod"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="ACTION" {
            set "m_SerAction" type="SetFlag" {
                set "FlagName" "welrod_missed_played"
                set "FlagValue" #true
            }
        }
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_welrod_va"
                        set "itemId" "Series_Up_002"
                    }
                    set "RoleGuid" "Attacker"
                    set "Text" "I need more clues."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

