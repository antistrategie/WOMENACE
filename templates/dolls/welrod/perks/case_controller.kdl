clone "PerkTemplate" from="perk.steady_gun" id="perk.welrod_case_controller" {
    // Case Controller, Welrod's starting perk: she gets nothing from cover, has no critical chance
    // of her own, but squad weapons other than pistols cost more AP and she is much harder to kill.
    set "Title" {
        set "m_DefaultTranslation" "Case Controller"
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "+$1% HP / +$2% DR / -$3% Suppression taken. NO cover, NO base CRIT, +$4 AP cost for non-pistol Squad Weapons."
        clear "m_Placeholders"
        append "m_Placeholders" bind="PerkTemplate" "perk.welrod_case_controller" path="EventHandlers[0].Properties[0].AmountMult" format="bonus-percent"
        append "m_Placeholders" bind="PerkTemplate" "perk.welrod_case_controller" path="EventHandlers[0].Properties[1].AmountMult" format="reduction-percent"
        append "m_Placeholders" bind="PerkTemplate" "perk.welrod_case_controller" path="EventHandlers[0].Properties[2].AmountMult" format="reduction-percent"
        append "m_Placeholders" bind="PerkTemplate" "perk.welrod_case_controller" path="EventHandlers[2].CostDelta" format="magnitude"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Why is she so SMALL? Why is she standing in the open? Why is she still standing? Field reports on Welrod tend to raise more questions than they answer.


            <style="Highlight">• +$1% <link="hitpoints">Hitpoints</link> and +$2% <link="damage_reduction">Damage Reduction</link>.

            • -$3% <link="suppression">Suppression</link> taken.

            • Squad Weapons other than pistols cost +$4 AP to use.

            • The SL gains NO protection from cover and has no base <link="critical_chance">Critical Chance</link>.</style>
            """
        clear "m_Placeholders"
        append "m_Placeholders" bind="PerkTemplate" "perk.welrod_case_controller" path="EventHandlers[0].Properties[0].AmountMult" format="bonus-percent"
        append "m_Placeholders" bind="PerkTemplate" "perk.welrod_case_controller" path="EventHandlers[0].Properties[1].AmountMult" format="reduction-percent"
        append "m_Placeholders" bind="PerkTemplate" "perk.welrod_case_controller" path="EventHandlers[0].Properties[2].AmountMult" format="reduction-percent"
        append "m_Placeholders" bind="PerkTemplate" "perk.welrod_case_controller" path="EventHandlers[2].CostDelta" format="magnitude"
    }

    set "Icon" asset="welrod/perks/case_controller"
    set "IconDisabled" asset="welrod/perks/case_controller_inactive"
    set "PerkIcon" asset="welrod/perks/case_controller"

    clear "EventHandlers"
    append "EventHandlers" type="ChangeProperty" {
        set "Trigger" enum="UpdateEvent" "OnUpdate"
        append "Properties" {
            set "PropertyType" enum="EntityPropertyType" "HitpointsPerElementMult"
            set "Amount" 0
            set "AmountMult" 1.5
        }
        append "Properties" {
            set "PropertyType" enum="EntityPropertyType" "DamageSustainedMult"
            set "Amount" 0
            set "AmountMult" 0.5
        }
        append "Properties" {
            set "PropertyType" enum="EntityPropertyType" "SuppressionImpactMult"
            set "Amount" 0
            set "AmountMult" 0.5
        }
        append "Properties" {
            set "PropertyType" enum="EntityPropertyType" "CoverEffectivenessMult"
            set "Amount" 0
            set "AmountMult" 0.0
        }
    }
    append "EventHandlers" type="WOMENACE:SetCriticalChance" {
        set "Value" 0
    }
    // Its skill filter (squad weapons other than pistols) is installed by WeaponClassFilterSystem.
    append "EventHandlers" type="ChangeActionPointCost" {
        set "CostDelta" 20
    }
}
