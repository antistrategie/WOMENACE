clone "WeaponTemplate" from="weapon.generic_battle_rifle_tier1_crowbar_marksman" id="weapon.nemesis" {
    append "Tags" "wmgfl_doll_weapon"
    append "Tags" "jy_no_sell"
    append "Tags" "wmgfl_class_rifle"
    set "Title" {
        set "m_DefaultTranslation" ".50 Nemesis"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Anti-Materiel Rifle"
    }
    set "Description" {
        set "m_DefaultTranslation" "A firearm highly compatible with Nemesis. Modified based on her combat preferences. Features further improved firepower and accuracy."
    }
    set "Model" asset="weapon/nemesis/main"
    set "SkillsGranted" index=0 "active.fire_nemesis"
    set "SkillsGranted" index=1 "active.fire_nemesis_quickshot"
    set "Icon" asset="weapon/nemesis/Icon"
    set "IconEquipment" asset="weapon/nemesis/IconEquipment"
    set "IconEquipmentDisabled" asset="weapon/nemesis/IconEquipmentDisabled"
    set "IconSkillBar" asset="weapon/nemesis/IconSkillBar"
    set "IconSkillBarDisabled" asset="weapon/nemesis/IconSkillBarDisabled"

    set "AccuracyBonus" 10.0
    set "AccuracyDropoff" -11.0
    set "ArmorPenetration" 105.0
    set "ArmorPenetrationDropoff" -0.94

    set "Damage" 23.0
    set "DamageDropoff" -0.55
    set "DamageToArmorDurability" 55.0
    set "DamageToArmorDurabilityDropoff" -0.31

    set "MaxRange" 13
    set "IdealRange" 10
    set "Suppression" 12.0

    set "DeployCosts" {
        set "m_Supplies" 25
    }

    set "BlackMarketMaxQuantity" 0
}

clone "SkillTemplate" from="active.fire_battle_rifle_tier_1_aimed_fire_marksman" id="active.fire_nemesis" {
    set "Title" {
        set "m_DefaultTranslation" "Aimed Volley"
    }
    set "Description" {
        set "m_DefaultTranslation" "Deliver a volley with high <link=\"accuracy\">Accuracy</link> at the designated target. Requires deployment."
    }

    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }
    set "ActionPointCost" 60
    set "Uses" 5
    set "EventHandlers" index=0 {
        set "AccuracyBonus" 0.0
        set "DamageMult" 1.0
    }
    set "IsOverridingRanges" #false
}

clone "SkillTemplate" from="active.fire_battle_rifle_tier_1_aimed_fire_marksman" id="active.fire_nemesis_quickshot" {
    set "Title" {
        set "m_DefaultTranslation" "Guidance Shot"
    }
    set "Description" {
        set "m_DefaultTranslation" "Fire a single accurate round at the target. On a hit, the target is marked, and all attacks on it gain <link=\"accuracy\">Accuracy</link>."
    }

    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }
    set "ActionPointCost" 40
    set "Uses" 5
    set "ExecutingElement" enum="ExecutingElementType" "OneAtRandomExceptSpecial"
    set "IsOverridingRanges" #false
    set "IsDeploymentRequired" #false
    // The mark Call Out Target places: every attack on the target gains Accuracy, and Directed
    // Fire's bonus applies against it.
    append "EventHandlers" type="AddSkill" {
        set "Event" enum="AddEvent" "OnUse"
        set "SkillToAdd" "effect.designated_target"
        set "OnlyApplyOnHit" #true
        set "ShowHUDText" #true
    }
}
