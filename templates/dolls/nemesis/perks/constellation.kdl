clone "PerkTemplate" from="perk.steady_gun" id="perk.nemesis_constellation" {
    // Constellation, Nemesis's tier 3 perk: ConstellationSystem gives every rifle Doll on her side
    // effect.nemesis_constellation while she is alive in the mission.
    set "Title" {
        set "m_DefaultTranslation" "Constellation"
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "+$1 ACC / +$2% DMG to ALL rifle Dolls for each other rifle Doll in the battle."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.nemesis_constellation" path="EventHandlers[0].AccuracyPerDoll"
        append "m_Placeholders" bind="SkillTemplate" "effect.nemesis_constellation" path="EventHandlers[0].DamagePerDoll" format="percent"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Connect the dots. Then shoot them.


            <style="Highlight">• +$1 <link="accuracy">Accuracy</link> and +$2% Damage to ALL rifle Dolls on your side for each other living rifle Doll in the battle.


            ** Only while the SL is alive. **</style>
            """
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.nemesis_constellation" path="EventHandlers[0].AccuracyPerDoll"
        append "m_Placeholders" bind="SkillTemplate" "effect.nemesis_constellation" path="EventHandlers[0].DamagePerDoll" format="percent"
    }

    set "Icon" asset="nemesis/perks/constellation"
    set "IconDisabled" asset="nemesis/perks/constellation_inactive"
    set "PerkIcon" asset="nemesis/perks/constellation"

    clear "EventHandlers"
    append "EventHandlers" type="WOMENACE:Constellation" {
        set "Effect" ref="SkillTemplate" "effect.nemesis_constellation"
    }
}

clone "SkillTemplate" from="effect.solid_grouping" id="effect.nemesis_constellation" {
    set "Icon" asset="nemesis/effects/constellation"
    set "Title" {
        set "m_DefaultTranslation" "Constellation"
    }
    set "Description" {
        set "m_DefaultTranslation" "+$1 <link=\"accuracy\">Accuracy</link> and +$2% Damage for each other living rifle Doll in the battle."
        clear "m_Placeholders"
        append "m_Placeholders" bind="SkillTemplate" "effect.nemesis_constellation" path="EventHandlers[0].AccuracyPerDoll"
        append "m_Placeholders" bind="SkillTemplate" "effect.nemesis_constellation" path="EventHandlers[0].DamagePerDoll" format="percent"
    }
    set "IsRemovedAfterCombat" #true
    clear "EventHandlers"
    append "EventHandlers" type="WOMENACE:ConstellationBonus" {
        set "AccuracyPerDoll" 5
        set "DamagePerDoll" 0.05
    }
}
