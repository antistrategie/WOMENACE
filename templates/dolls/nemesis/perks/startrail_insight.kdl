clone "PerkTemplate" from="perk.steady_gun" id="perk.nemesis_startrail_insight" {
    // Star Rail Insight, Nemesis's tier 2 foresight perk: StartrailInsightSystem reads the next
    // actions of the enemies closest to her at the start of every allied unit's turn and shows
    // them as a vision. The description says plainly that each read goes stale as that unit acts.
    set "Title" {
        set "m_DefaultTranslation" "Star Rail Insight"
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "See the next action of the $1 closest enemies at the start of each allied turn."
        clear "m_Placeholders"
        append "m_Placeholders" bind="PerkTemplate" "perk.nemesis_startrail_insight" path="EventHandlers[0].MaxEnemies"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            “Destiny's course is becoming apparent.”

              – Black Swan


            <style="Highlight">• At the start of each allied unit's turn, foresees the next action of the $1 closest detected enemies.

            • Afterimages show where enemies will move. Units they are likely to attack are marked.


            ** The vision does NOT update during the turn. Enemies react to what you do, so they may act differently. **</style>
            """
        clear "m_Placeholders"
        append "m_Placeholders" bind="PerkTemplate" "perk.nemesis_startrail_insight" path="EventHandlers[0].MaxEnemies"
    }

    set "Icon" asset="nemesis/perks/startrail_insight"
    set "IconDisabled" asset="nemesis/perks/startrail_insight_inactive"
    set "PerkIcon" asset="nemesis/perks/startrail_insight"

    clear "EventHandlers"
    append "EventHandlers" type="WOMENACE:StartrailInsight" {
        set "MaxEnemies" 10
        set "AttackShare" 0.25
    }
}
