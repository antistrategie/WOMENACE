clone "PerkTemplate" from="perk.steady_gun" id="perk.nemesis_converging_light" {
    set "Title" {
        set "m_DefaultTranslation" "Converging Light"
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "$1% chance to return to the roster after the operation if KILLED IN ACTION."
        clear "m_Placeholders"
        append "m_Placeholders" bind="PerkTemplate" "perk.nemesis_converging_light" path="EventHandlers[0].Chance"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Nemesis has seen every way this mission can end, including the ones where she does not walk out. She has also seen the one where she walks back in, and would rather nobody made a fuss about it.


            <style="Highlight">• When KILLED IN ACTION, the SL has a $1% chance to return to the roster when the operation ends.


            ** There is no limit to how often she can return. **</style>
            """
        clear "m_Placeholders"
        append "m_Placeholders" bind="PerkTemplate" "perk.nemesis_converging_light" path="EventHandlers[0].Chance"
    }

    set "Icon" asset="nemesis/perks/converging_light"
    set "IconDisabled" asset="nemesis/perks/converging_light_inactive"
    set "PerkIcon" asset="nemesis/perks/converging_light"

    clear "EventHandlers"
    append "EventHandlers" type="WOMENACE:ConvergingLight" {
        set "Chance" 70
    }
}
