clone "PerkTemplate" from="perk.steady_gun" id="perk.nemesis_converging_light" {
    // Converging Light, Nemesis's tier 4 perk: ConvergingLightSystem notes her permanent death
    // and rolls the chance when the operation ends, putting her back on the roster on a success.
    set "Title" {
        set "m_DefaultTranslation" "Converging Light"
    }
    set "ShortDescription" {
        set "m_DefaultTranslation" "When killed in action, $1% chance to return to the roster when the operation ends."
        clear "m_Placeholders"
        append "m_Placeholders" bind="PerkTemplate" "perk.nemesis_converging_light" path="EventHandlers[0].Chance"
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Nemesis has already seen the version of events where she walks back in.


            <style="Highlight">• When this unit is killed in action, it has a $1% chance to return to the roster when the operation ends.
            • There is no limit to how often it can return.</style>
            """
        clear "m_Placeholders"
        append "m_Placeholders" bind="PerkTemplate" "perk.nemesis_converging_light" path="EventHandlers[0].Chance"
    }

    set "Icon" asset="nemesis/perks/converging_light"
    set "IconDisabled" asset="nemesis/perks/converging_light_inactive"
    set "PerkIcon" asset="nemesis/perks/converging_light"

    clear "EventHandlers"
    append "EventHandlers" type="WOMENACE:ConvergingLight" {
        set "Chance" 60
    }
}
