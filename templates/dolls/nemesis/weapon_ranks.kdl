clone "CommodityTemplate" from="commodity.construct_weapon_parts" id="commodity.wmgfl_component_nemesis" {
    set "Title" {
        set "m_DefaultTranslation" ".50 Nemesis Component"
    }
    set "Description" {
        set "m_DefaultTranslation" "[PLACEHOLDER] Weapon component for .50 Nemesis"
    }
    append "Tags" "jy_no_sell"
    set "Icon" asset="weapon/nemesis/Icon"
    set "Rarity" 0
    set "TradeValue" 0
    set "BlackMarketMaxQuantity" 0
    set "MinCampaignProgress" 0
}

clone "BlueprintTemplate" from="blueprint.squad_weapon_electro_magnetic_enhanced_assault_rifle" id="blueprint.wmgfl_nemesis_duplicate" {
    set "m_CraftingResult" "weapon.nemesis"
    clear "m_CraftingMaterials"
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_rf_barrel"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_rf_receiver"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_rf_grip"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_part_rf_sights"
        set "Count" 1
    }
    append "m_CraftingMaterials" {
        set "Template" "commodity.wmgfl_component_nemesis"
        set "Count" 1
    }
}
