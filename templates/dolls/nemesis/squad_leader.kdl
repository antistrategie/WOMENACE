clone "TagTemplate" from="unique" id="wmgfl_nemesis"

clone "SpeakerTemplate" from="carda" id="wmgfl_nemesis_speaker" {
    set "Tags" "wmgfl_nemesis female infantry waybacker wmgfl_class_rifle"
    set "Nickname" {
        set "m_DefaultTranslation" "Nemesis Gnosis"
    }
    set "Forename" {
        set "m_DefaultTranslation" "Nemesis Gnosis"
    }
    set "Surname" {
        set "m_DefaultTranslation" ""
    }
    set "Description" {
        set "m_DefaultTranslation" """
            Name: Nemesis Gnosis (.50 Nemesis)

            Proficiency: Long Range Anti-Material

            Birth: Unknown

            Age: Classified

            Affiliation(s): Groza's Team
            """
    }

    set "BarkImage" asset="nemesis/bark"
    set "StandLookLeftImage" asset="nemesis/stand_look_left"
    set "StandLookRightImage" asset="nemesis/stand_look_right"
    set "StandLookRightInactiveImage" asset="nemesis/stand_look_right_inactive"
}

clone "EntityTemplate" from="player_squad.carda" id="player_squad.nemesis" {
    append "Tags" "wmgfl_nemesis"
    set "Title" {
        set "m_DefaultTranslation" "Groza's Team"
    }
    set "Description" {
        set "m_DefaultTranslation" "After returning to her first body, Nemesis has not only awakened brand-new powers related to the future, but she has also regained the ability to speak normally. Those words which were once incomprehensible are no longer a barrier to understanding. \"...The light is serene and the gentle winds call... Commander, would you like to hear today's predictions?\""
    }

    set "Badge" asset="nemesis/badge_unit_window"
    set "BadgeWhite" asset="nemesis/badge_white"
    clear "Items"
    append "Items" "armor.player_fatigues"
    append "Items" "weapon.nemesis"

    set "Scale" {
        set "x" 1.0
        set "y" 1.0
    }
    set "OverrideScaleForSquadLeader" #false
}

clone "UnitLeaderTemplate" from="squad_leader.carda" id="squad_leader.nemesis" {
    set "FactionBackground" asset="factions/background_groza_1180x1040"
    set "BigBackground" asset="factions/background_groza_972x906"
    set "SlotFactionBackground" asset="factions/background_groza_162x162"
    set "InfantryUnitTemplate" "player_squad.nemesis"
    set "SpeakerTemplate" "wmgfl_nemesis_speaker"
    set "CustomHead" #null
    set "UnitTitle" {
        set "m_DefaultTranslation" "Tactical Doll"
    }
    set "UnitDescription" {
        set "m_DefaultTranslation" "After returning to her first body, Nemesis has not only awakened brand-new powers related to the future, but she has also regained the ability to speak normally. Those words which were once incomprehensible are no longer a barrier to understanding. \"...The light is serene and the gentle winds call... Commander, would you like to hear today's predictions?\""
    }

    set "InitialAttributes" index=0 75
    set "InitialAttributes" index=1 85
    set "InitialAttributes" index=2 90
    set "InitialAttributes" index=3 100
    set "InitialAttributes" index=4 100
    set "InitialAttributes" index=5 20
    set "InitialAttributes" index=6 70

    set "QualityLevel" 3
    set "GrowthPotential" 5
    set "FixedSupplyCost" 100
    set "PromotionCostMult" 0.8
    set "SquaddieTax" 25
    set "Rarity" 5

    set "InitialPerk" "perk.nemesis_divination"
    set "PerkTrees" index=0 "perk_tree.nemesis"

    set "Slot" asset="nemesis/slot"
    set "SlotInactive" asset="nemesis/slot_inactive"
    set "SlotBadge" asset="nemesis/slot_badge"

    set "BadgeDragged" asset="nemesis/badge_dragged"
    set "BigBadge" asset="nemesis/big_badge"
    set "BadgeUnitWindow" asset="nemesis/badge_unit_window"
    set "BadgeMini" asset="nemesis/badge_mini"

    set "HiringSelectBarkSound" {
        set "bankId" "wmgfl_tactical_barks_nemesis_va"
        set "itemId" "Series_Chosen_Series_Tone_Positive_006"
    }
    set "HiredBarkSound" {
        set "bankId" "wmgfl_tactical_barks_nemesis_va"
        set "itemId" "Series_Set_Click_Series_Tone_Positive_004"
    }

    set "PromotionBarkSounds" index=0 {
        set "PerkTier" 1
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_nemesis_va"
            set "itemId" "Series_Up_001"
        }
    }
    set "PromotionBarkSounds" index=1 {
        set "PerkTier" 2
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_nemesis_va"
            set "itemId" "Series_Up_002"
        }
    }
    set "PromotionBarkSounds" index=2 {
        set "PerkTier" 3
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_nemesis_va"
            set "itemId" "Series_Up_004"
        }
    }
    set "PromotionBarkSounds" index=3 {
        set "PerkTier" 4
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_nemesis_va"
            set "itemId" "Series_Up_005"
        }
    }

    clear "EmotionalStateResponses"
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Eager"
        set "Text" {
            set "m_DefaultTranslation" "Awaiting orders."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_nemesis_va"
            set "itemId" "Series_Set_Click_Series_Tone_Positive_004"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Determined"
        set "Text" {
            set "m_DefaultTranslation" "Destiny passes judgement!"
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_nemesis_va"
            set "itemId" "Series_Ultimate_Single_Ultimate_SSR_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Overconfident"
        set "Text" {
            set "m_DefaultTranslation" "Divination successful."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_nemesis_va"
            set "itemId" "Series_Skill02_Single_Skill_002"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Euphoric"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Hesitant"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Frustrated"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Disheartened"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "Miserable"
        set "Text" {
            set "m_DefaultTranslation" "...A misread path... drowning... infiltrating... the shadows of night..."
        }
        set "Sound" {
            set "bankId" "wmgfl_tactical_barks_nemesis_va"
            set "itemId" "Series_Lose_Single_Lose_001"
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "GoodwillTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
    append "EmotionalStateResponses" {
        set "EmotionalState" enum="EmotionalStateType" "AnimosityTowards"
        set "Text" {
            set "m_DefaultTranslation" ""
        }
    }
}
