clone "ConversationTemplate" from="Carda_Early/enemy_damage_blocked" id="Nemesis/enemy_damage_blocked_nemesis" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_nemesis"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_nemesis_va"
                        set "itemId" "Series_Up_003"
                    }
                    set "RoleGuid" "Attacker"
                    set "Text" "...nusquam..."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

