clone "ConversationTemplate" from="Carda_Early/objective_first" id="Nemesis/objective_first_nemesis" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_nemesis"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_nemesis_va"
                        set "itemId" "Series_Hit_Single_Hit_001"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Guidance anchored."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

