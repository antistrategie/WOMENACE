clone "ConversationTemplate" from="Carda_Early/morale_recovery" id="Nemesis/morale_recovery_nemesis" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_nemesis"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_nemesis_va"
                        set "itemId" "Series_Up_005"
                    }
                    set "RoleGuid" "Recovered"
                    set "Text" "Abiding by... the revelation of light."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

