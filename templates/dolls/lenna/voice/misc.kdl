clone "ConversationTemplate" from="JeanSy/morale_recovery" id="Lenna/morale_recovery" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_lenna"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_lenna_va"
                        set "itemId" "Series_Daily_002"
                    }
                    set "RoleGuid" "Recovered"
                    set "Text" "Wait, there's still work? Alright, let's wrap this up quick!"
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

