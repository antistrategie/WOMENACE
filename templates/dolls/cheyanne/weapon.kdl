clone "WeaponTemplate" from="weapon.generic_battle_rifle_tier1_crowbar_marksman" id="weapon.cheyanne" {
    append "Tags" "jy_no_sell"
    append "Tags" "wmgfl_class_rifle"
    set "Title" {
        set "m_DefaultTranslation" ".408 Sniper Rifle"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Sniper Rifle"
    }
    set "Description" {
        set "m_DefaultTranslation" "A firearm highly compatible with Cheyanne. Modified based on her combat preferences. Its suppressor improves its heat dissipation efficiency and precision when firing consecutive shots."
    }
    set "Model" asset="weapon/cheyanne/main"
    set "SkillsGranted" index=0 "active.fire_cheyanne_m200"
    set "SkillsGranted" index=1 "active.fire_cheyanne_m200_quickshot"
    set "Icon" asset="weapon/cheyanne/Icon"
    set "IconEquipment" asset="weapon/cheyanne/IconEquipment"
    set "IconEquipmentDisabled" asset="weapon/cheyanne/IconEquipmentDisabled"
    set "IconSkillBar" asset="weapon/cheyanne/IconSkillBar"
    set "IconSkillBarDisabled" asset="weapon/cheyanne/IconSkillBarDisabled"

    set "AccuracyBonus" 15.0
    set "AccuracyDropoff" -11.0
    set "ArmorPenetration" 80.0
    set "ArmorPenetrationDropoff" -0.6

    set "Damage" 23.0
    set "DamageDropoff" -0.35
    set "DamageToArmorDurability" 40.0
    set "DamageToArmorDurabilityDropoff" -0.2

    set "MaxRange" 13
    set "IdealRange" 11
    set "Suppression" 8.0

    set "DeployCosts" {
        set "m_Supplies" 25
    }

    set "BlackMarketMaxQuantity" 0
}

clone "SkillTemplate" from="active.fire_battle_rifle_tier_1_aimed_fire_marksman" id="active.fire_cheyanne_m200" {
    set "Title" {
        set "m_DefaultTranslation" "Aimed Volley"
    }
    set "Description" {
        set "m_DefaultTranslation" "Deliver a highly accuracy volley at designated target. Require deploy."
    }

    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }
    set "ActionPointCost" 60
    set "Uses" 7
    set "EventHandlers" index=0 {
        set "AccuracyBonus" 0.0
        set "DamageMult" 1.0
    }
    set "IsOverridingRanges" #false
}

clone "SkillTemplate" from="active.fire_battle_rifle_tier_1_aimed_fire_marksman" id="active.fire_cheyanne_m200_quickshot" {
    set "Title" {
        set "m_DefaultTranslation" "Quick Shot"
    }
    set "Description" {
        set "m_DefaultTranslation" "Nimbly fire a single accurate round at designated target."
    }

    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }
    set "ActionPointCost" 40
    set "Uses" 7
    set "ExecutingElement" enum="ExecutingElementType" "OneAtRandomExceptSpecial"
    set "IsOverridingRanges" #false
    set "IsDeploymentRequired" #false
}

// SSR weapon
clone "WeaponTemplate" from="specialweapon.anti_materiel_rifle_tier1" id="weapon.cheyanne_ssr" {
    append "Tags" "jy_no_sell"
    set "Title" {
        set "m_DefaultTranslation" "Nightwalker Cardamom"
    }
    set "ShortName" {
        set "m_DefaultTranslation" "Sniper Rifle"
    }
    set "Description" {
        set "m_DefaultTranslation" "A high-performance rifle assigned to Cheyanne. Based on the .408 Sniper Rifle, its range and firepower have been boosted over the original allowing it to deliver death from a distant hiding place straight to the enemies' vitals."
    }

    set "Model" asset="weapon/cheyanne_ssr/main"
    set "Icon" asset="weapon/cheyanne_ssr/Icon"
    set "IconEquipment" asset="weapon/cheyanne_ssr/IconEquipment"
    set "IconEquipmentDisabled" asset="weapon/cheyanne_ssr/IconEquipmentDisabled"
    set "IconSkillBar" asset="weapon/cheyanne_ssr/IconSkillBar"
    set "IconSkillBarDisabled" asset="weapon/cheyanne_ssr/IconSkillBarDisabled"

    set "ArmorPenetration" 100.0
    set "ArmorPenetrationDropoff" 0.0

    set "Damage" 83.0
    set "DamageDropoff" 0.0
    set "DamageToArmorDurability" 45.0
    set "DamageToArmorDurabilityDropoff" 0.0

    set "MaxRange" 20
    set "IdealRange" 12
    set "Suppression" 10.0

    set "DeployCosts" {
        set "m_Supplies" 50
    }

    set "BlackMarketMaxQuantity" 0

    clear "SkillsGranted"
    append "SkillsGranted" "active.cheyanne_ssr_ricochet"
}

// One round that ricochets between enemies. The chain itself is a native AoE
// shape assigned in code (CheyanneSsrShapeSystem): the tile list cannot be
// authored here because CustomAoEShape is an Odin-serialised interface field.
//
// The base is the anti-materiel rifle's OWN fire skill, matching the weapon's
// clone base. That is what makes the shot a single shot: the marksman volley
// this first cloned from carries ExecutingElement=AllButSpecial, so every
// non-special squaddie fired their own ricochet. Repetitions was already 1 on
// both, so the extra shots were squadmates, not repetitions. SpecialOnly is set
// explicitly below rather than left to the base, because it is the whole point.
clone "SkillTemplate" from="active.shoot_anti_materiel_rifle" id="active.cheyanne_ssr_ricochet" {
    set "Title" {
        set "m_DefaultTranslation" "Heavenpierce"
    }
    set "Description" {
        set "m_DefaultTranslation" "Fire a single completely accurate and devastating round that ricochets to nearby enemies."
    }

    clear "SoundsOnAttack"
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot"
    }
    append "SoundsOnAttack" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }
    clear "SoundsOnAttackFar"
    append "SoundsOnAttackFar" {
        set "bankId" "wmgfl_weapons_rf_addition_bank"
        set "itemId" "rf_shot_distant"
    }

    set "ActionPointCost" 70
    set "Uses" 1
    set "ExecutingElement" enum="ExecutingElementType" "SpecialOnly"
    set "IsOverridingRanges" #false
    set "IsDeploymentRequired" #false

    set "Repetitions" 1

    set "IsAlwaysHitting" #true

    set "EventHandlers" index=0 {
        set "ElementsHit" 3
    }
}
