clone "ConversationTemplate" from="JeanSy/morale_recovery" id="Suomi/morale_recovery" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=1 type="HasOneTag" {
            set "Tags" "wmgfl_suomi"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_suomi_va"
                        set "itemId" "Series_Up_002"
                    }
                    set "RoleGuid" "Recovered"
                    set "Text" "Yes, I’ll do my best."
                }
            }
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_suomi_va"
                        set "itemId" "Series_Up_004"
                    }
                    set "RoleGuid" "Recovered"
                    set "Text" "I'm not the same as I used to be."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

