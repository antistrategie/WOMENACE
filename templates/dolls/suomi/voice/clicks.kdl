clone "ConversationTemplate" from="JeanSy/click_bark" id="Suomi/click_bark" {
    set "Active" #true
    set "Roles" index=0 {
        set "m_SerializedRequirements" index=2 type="HasOneTag" {
            set "Tags" "wmgfl_suomi"
        }
    }
    set "Nodes" {
        clear "m_SerializedNodes"
        append "m_SerializedNodes" type="VARIATION" {
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_suomi_va"
                        set "itemId" "Series_Tone_Positive_003"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Understood."
                }
            }
            append "Variations" {
                append "m_SerializedNodes" type="SAY" {
                    set "Sound" {
                        set "bankId" "wmgfl_tactical_barks_suomi_va"
                        set "itemId" "Series_Battle_Start_Series_Hit_Series_Tone_Positive_008"
                    }
                    set "RoleGuid" "Entity"
                    set "Text" "Please give the order."
                }
            }
        }
        append "m_SerializedNodes" type="EMPTY" {}
    }
}

