<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>WOMENACE.Code</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Procurement.Tests" />
    <InternalsVisibleTo Include="Sinbreaker.Tests" />
    <InternalsVisibleTo Include="SpringBones.Tests" />
    <!-- The SDK exposes no finalizer hook for exception-safe damage scopes. -->
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- MelonPreferences, where the player's settings are kept. -->
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AudioClip/AudioSource, for the mod's own UI sounds. -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Raw mouse deltas for the aim trainer's locked-cursor look. Both
         backends referenced because the game ships both; AimInput picks
         whichever answers at runtime. -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameAssembliesDir)/Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Frame capture for the aim trainer's blurred backdrop. -->
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- HDRP camera data and volumes for the strategy diorama's own camera, which the game's
         DisplaySettings.ApplyToAllCameras expects every camera to carry. -->
    <!-- VideoPlayer, for the mission select planet video on the strategy diorama's holotable. -->
    <Reference Include="UnityEngine.VideoModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.VideoModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ParticleSystem, for inspecting the strategy diorama's room effects. -->
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Physics.Raycast, for clicking 3D props in the strategy diorama. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's Jura SDF font asset, applied to mod UI that does not inherit it. -->
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime">
      <HintPath>$(GameAssembliesDir)/Unity.RenderPipelines.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime">
      <HintPath>$(GameAssembliesDir)/Unity.RenderPipelines.HighDefinition.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
